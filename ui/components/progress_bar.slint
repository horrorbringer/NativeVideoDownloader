import { Theme } from "../theme.slint";

export component ProgressBar inherits Rectangle {
    in property <float> progress: 0.0; // 0.0 to 1.0
    in property <string> status: "Downloading";

    height: 8px;
    border-radius: 4px;
    background: Theme.is_dark ? #0f172a : #e2e8f0;
    border-width: 1px;
    border-color: Theme.is_dark ? #1e293b : #cbd5e1;
    clip: true;

    // Inner progress fill bar
    Rectangle {
        x: 0;
        y: 0;
        height: parent.height;
        width: root.progress >= 1.0 ? parent.width :
               root.progress <= 0.0 ? (root.status == "Downloading" ? 8px : 0px) :
               Math.max(8px, Math.min(parent.width, parent.width * root.progress));
        border-radius: 3px;
        background: root.status == "Completed" ? (Theme.is_dark ? @linear-gradient(90deg, #059669 0%, #10b981 100%) : @linear-gradient(90deg, #10b981 0%, #34d399 100%)) :
                    root.status == "Paused" ? #f59e0b :
                    root.status == "Failed" ? #ef4444 :
                    root.status == "Retrying" ? #f97316 :
                    (Theme.is_dark ? @linear-gradient(90deg, #38bdf8 0%, #818cf8 100%) : @linear-gradient(90deg, #0284c7 0%, #6366f1 100%));

        animate width { duration: 180ms; easing: ease-out; }
        animate background { duration: 180ms; }
    }
}
