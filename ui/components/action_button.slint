import { Theme } from "../theme.slint";

export component ActionButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> has_icon: false;
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    callback clicked();

    background: !root.enabled ? Theme.btn_disabled_bg :
                root.primary ? (touch.pressed ? Theme.primary_pressed : touch.has-hover ? Theme.primary_hover : Theme.primary_accent) :
                root.danger ? (touch.pressed ? Theme.btn_danger_pressed : touch.has-hover ? Theme.btn_danger_hover : Theme.btn_danger_bg) :
                (touch.pressed ? Theme.btn_secondary_pressed : touch.has-hover ? Theme.btn_secondary_hover : Theme.btn_secondary_bg);
    animate background { duration: 120ms; }
    border-radius: 7px;
    border-width: 1px;
    border-color: !root.enabled ? Theme.btn_disabled_border :
                  root.primary ? Theme.primary_border :
                  root.danger ? Theme.btn_danger_border :
                  Theme.btn_secondary_border;
    animate border-color { duration: 120ms; }
    height: 34px;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 7px;
        alignment: center;

        if root.has_icon: VerticalLayout {
            alignment: center;
            Image {
                source: root.icon;
                width: 14px;
                height: 14px;
                colorize: !root.enabled ? Theme.btn_disabled_text :
                          (root.primary || root.danger) ? #ffffff :
                          (touch.has-hover ? Theme.text_primary : Theme.text_secondary);
                animate colorize { duration: 120ms; }
            }
        }

        if root.text != "": Text {
            text: root.text;
            color: !root.enabled ? Theme.btn_disabled_text :
                   (root.primary || root.danger) ? #ffffff :
                   (touch.has-hover ? Theme.text_primary : Theme.btn_secondary_text);
            font-size: 12px;
            font-weight: (root.primary || root.danger) ? 600 : 500;
            vertical-alignment: center;
            animate color { duration: 120ms; }
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}
