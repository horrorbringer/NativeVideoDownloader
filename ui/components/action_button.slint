export component ActionButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> has_icon: false;
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    callback clicked();

    background: !root.enabled ? #161822 :
                root.primary ? (touch.pressed ? #434ba8 : touch.has-hover ? #5b65d6 : #4f58c7) :
                root.danger ? (touch.pressed ? #991b1b : touch.has-hover ? #dc2626 : #b91c1c) :
                (touch.pressed ? #181c28 : touch.has-hover ? #272d40 : #1c202e);
    animate background { duration: 120ms; }
    border-radius: 7px;
    border-width: 1px;
    border-color: !root.enabled ? #222634 :
                  root.primary ? (touch.has-hover ? #8292ff : #6b7af5) :
                  root.danger ? (touch.has-hover ? #f87171 : #ef4444) :
                  (touch.has-hover ? #3c4460 : #282d40);
    animate border-color { duration: 120ms; }
    height: 34px;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 7px;
        alignment: center;

        if root.has_icon: VerticalLayout {
            alignment: center;
            Image {
                source: root.icon;
                width: 14px;
                height: 14px;
                colorize: !root.enabled ? #52596e :
                          (root.primary || root.danger) ? #ffffff :
                          (touch.has-hover ? #ffffff : #cbd5e1);
                animate colorize { duration: 120ms; }
            }
        }

        if root.text != "": Text {
            text: root.text;
            color: !root.enabled ? #52596e :
                   (root.primary || root.danger) ? #ffffff :
                   (touch.has-hover ? #ffffff : #cbd5e1);
            font-size: 12px;
            font-weight: (root.primary || root.danger) ? 600 : 500;
            vertical-alignment: center;
            animate color { duration: 120ms; }
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}
