import { Theme } from "../theme.slint";

export component IconChip inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> has_icon: false;
    in property <bool> selected: false;
    callback clicked();

    background: root.selected ? (touch.pressed ? Theme.primary_pressed : touch.has-hover ? Theme.primary_hover : Theme.primary_accent) :
                (touch.pressed ? Theme.btn_secondary_pressed : touch.has-hover ? Theme.btn_secondary_hover : Theme.btn_secondary_bg);
    animate background { duration: 120ms; }
    border-radius: 7px;
    border-width: 1px;
    border-color: root.selected ? Theme.primary_border :
                  (touch.has-hover ? Theme.primary_border : Theme.btn_secondary_border);
    animate border-color { duration: 120ms; }
    height: 32px;

    HorizontalLayout {
        padding-left: 11px;
        padding-right: 11px;
        spacing: 6px;
        alignment: center;

        if root.has_icon: VerticalLayout {
            alignment: center;
            Image {
                source: root.icon;
                width: 13px;
                height: 13px;
                colorize: root.selected ? #ffffff : (touch.has-hover ? Theme.text_primary : Theme.icon_default);
                animate colorize { duration: 120ms; }
            }
        }

        Text {
            text: root.text;
            color: root.selected ? #ffffff : (touch.has-hover ? Theme.text_primary : Theme.text_secondary);
            font-size: 12px;
            font-weight: root.selected ? 600 : 500;
            vertical-alignment: center;
            animate color { duration: 120ms; }
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}
