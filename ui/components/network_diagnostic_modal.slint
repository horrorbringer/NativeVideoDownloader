import { Theme } from "../theme.slint";
import { ActionButton } from "action_button.slint";
import { LineEdit, ScrollView } from "std-widgets.slint";

export component NetworkDiagnosticModal inherits Rectangle {
    in property <bool> is_open: false;
    in property <bool> is_running: false;
    in-out property <string> target_url: "https://cloudflare.com/cdn-cgi/trace";
    in property <string> dns_latency_text: "--";
    in property <string> dns_status: "Pending";
    in property <string> ping_latency_text: "--";
    in property <string> ping_status: "Pending";
    in property <string> range_support_text: "--";
    in property <string> range_status: "Pending";
    in property <string> throughput_text: "--";
    in property <string> throughput_status: "Pending";
    in property <string> summary_headline: "Ready to diagnose network";
    in property <string> summary_details: "Select a CDN endpoint or paste any video stream URL, then click 'Run Diagnostic Probe'.";
    in property <string> overall_status: "Ready"; // "Optimal", "Good", "Degraded", "Unreachable", "Ready"

    callback close();
    callback run_diagnostics(string);

    width: 100%;
    height: 100%;
    visible: root.is_open;
    z: 110;

    // Dark backdrop overlay
    Rectangle {
        background: Theme.is_dark ? #000000a6 : #00000066;
        animate background { duration: 150ms; }

        TouchArea {
            clicked => {
                if !root.is_running {
                    root.close();
                }
            }
        }
    }

    // Modal Card
    Rectangle {
        width: min(680px, parent.width - 48px);
        height: min(540px, parent.height - 48px);
        background: Theme.card_bg;
        border-radius: 14px;
        border-width: 1px;
        border-color: Theme.card_border;
        clip: true;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000077;
        drop-shadow-offset-y: 8px;

        TouchArea {} // Prevent backdrop click

        VerticalLayout {
            padding: 0px;
            spacing: 0px;

            // Modal Header
            Rectangle {
                height: 64px;
                background: Theme.card_alt_bg;

                HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: 12px;
                        alignment: start;

                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 36px;
                                height: 36px;
                                border-radius: 8px;
                                background: Theme.is_dark ? #1e293b : #e0e7ff;
                                border-width: 1px;
                                border-color: Theme.is_dark ? #334155 : #c7d2fe;

                                Image {
                                    source: @image-url("../icons/bolt.svg");
                                    width: 18px;
                                    height: 18px;
                                    colorize: Theme.brand_purple;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;

                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;

                                Text {
                                    text: "Network Diagnostic & CDN Health Probe";
                                    color: Theme.text_primary;
                                    font-size: 15px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }

                                // Status Badge
                                Rectangle {
                                    background: root.overall_status == "Optimal" ? (Theme.is_dark ? #064e3b : #dcfce7) :
                                                root.overall_status == "Good" ? (Theme.is_dark ? #172554 : #dbeafe) :
                                                root.overall_status == "Degraded" ? (Theme.is_dark ? #78350f : #fef3c7) :
                                                root.overall_status == "Unreachable" ? (Theme.is_dark ? #7f1d1d : #fee2e2) :
                                                (Theme.is_dark ? #1e293b : #e2e8f0);
                                    border-radius: 4px;
                                    border-width: 1px;
                                    border-color: root.overall_status == "Optimal" ? (Theme.is_dark ? #059669 : #86efac) :
                                                  root.overall_status == "Good" ? (Theme.is_dark ? #2563eb : #93c5fd) :
                                                  root.overall_status == "Degraded" ? (Theme.is_dark ? #d97706 : #fde68a) :
                                                  root.overall_status == "Unreachable" ? (Theme.is_dark ? #dc2626 : #fca5a5) :
                                                  Theme.inner_border;
                                    height: 20px;

                                    HorizontalLayout {
                                        padding-left: 7px;
                                        padding-right: 7px;
                                        alignment: center;
                                        Text {
                                            text: root.overall_status;
                                            color: root.overall_status == "Optimal" ? (Theme.is_dark ? #34d399 : #166534) :
                                                   root.overall_status == "Good" ? (Theme.is_dark ? #60a5fa : #1d4ed8) :
                                                   root.overall_status == "Degraded" ? (Theme.is_dark ? #fbbf24 : #92400e) :
                                                   root.overall_status == "Unreachable" ? (Theme.is_dark ? #f87171 : #991b1b) :
                                                   Theme.text_secondary;
                                            font-size: 11px;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            Text {
                                text: "Measure DNS resolve speed, HTTP handshake ping, byte-range capability, and edge bandwidth";
                                color: Theme.text_muted;
                                font-size: 12px;
                            }
                        }
                    }

                    // Close Button
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 32px;
                            height: 32px;
                            border-radius: 8px;
                            background: close_touch.has_hover ? (Theme.is_dark ? #334155 : #e2e8f0) : transparent;
                            animate background { duration: 100ms; }

                            Image {
                                source: @image-url("../icons/x.svg");
                                width: 14px;
                                height: 14px;
                                colorize: Theme.text_secondary;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }

                            close_touch := TouchArea {
                                clicked => { root.close(); }
                            }
                        }
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: Theme.card_border;
            }

            // Target Input & Presets Bar
            Rectangle {
                background: Theme.card_bg;
                height: 74px;

                VerticalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    padding-top: 10px;
                    padding-bottom: 10px;
                    spacing: 6px;

                    HorizontalLayout {
                        spacing: 8px;

                        target_edit := LineEdit {
                            text: root.target_url;
                            placeholder_text: "Target CDN or media stream URL (e.g. https://...)";
                            horizontal-stretch: 1;
                            height: 32px;
                            accepted => {
                                root.run_diagnostics(target_edit.text);
                            }
                        }

                        ActionButton {
                            text: root.is_running ? "Testing..." : "Run Diagnostic Probe";
                            icon: @image-url("../icons/bolt.svg");
                            has_icon: true;
                            primary: true;
                            height: 32px;
                            enabled: !root.is_running;
                            clicked => {
                                root.run_diagnostics(target_edit.text);
                            }
                        }
                    }

                    // Endpoint Presets
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;

                        Text {
                            text: "Presets:";
                            color: Theme.text_muted;
                            font-size: 11px;
                            vertical-alignment: center;
                        }

                        Rectangle {
                            background: Theme.is_dark ? #1e293b : #f1f5f9;
                            border-radius: 4px;
                            height: 20px;
                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;
                                alignment: center;
                                Text {
                                    text: "Cloudflare CDN";
                                    color: Theme.brand_purple;
                                    font-size: 10px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }
                            TouchArea {
                                clicked => {
                                    target_edit.text = "https://cloudflare.com/cdn-cgi/trace";
                                    root.target_url = target_edit.text;
                                }
                            }
                        }

                        Rectangle {
                            background: Theme.is_dark ? #1e293b : #f1f5f9;
                            border-radius: 4px;
                            height: 20px;
                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;
                                alignment: center;
                                Text {
                                    text: "Google Edge";
                                    color: Theme.brand_purple;
                                    font-size: 10px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }
                            TouchArea {
                                clicked => {
                                    target_edit.text = "https://www.google.com/generate_204";
                                    root.target_url = target_edit.text;
                                }
                            }
                        }

                        Rectangle {
                            background: Theme.is_dark ? #1e293b : #f1f5f9;
                            border-radius: 4px;
                            height: 20px;
                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;
                                alignment: center;
                                Text {
                                    text: "Fastly CDN";
                                    color: Theme.brand_purple;
                                    font-size: 10px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }
                            TouchArea {
                                clicked => {
                                    target_edit.text = "https://www.fastly.com";
                                    root.target_url = target_edit.text;
                                }
                            }
                        }
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: Theme.card_border;
            }

            // Results Body Area
            ScrollView {
                VerticalLayout {
                    padding: 20px;
                    spacing: 16px;

                    // 4-Metrics Cards Grid
                    HorizontalLayout {
                        spacing: 12px;

                        // Metric 1: DNS Latency
                        Rectangle {
                            background: Theme.card_alt_bg;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: Theme.inner_border;
                            horizontal-stretch: 1;
                            height: 96px;

                            VerticalLayout {
                                padding: 12px;
                                spacing: 4px;

                                Text {
                                    text: "DNS Resolution";
                                    color: Theme.text_secondary;
                                    font-size: 11px;
                                    font-weight: 600;
                                }

                                Text {
                                    text: root.dns_latency_text;
                                    color: Theme.text_primary;
                                    font-size: 20px;
                                    font-weight: 800;
                                }

                                Text {
                                    text: root.dns_status;
                                    color: root.dns_status == "Fast" ? #10b981 : (root.dns_status == "Normal" ? #3b82f6 : Theme.text_muted);
                                    font-size: 11px;
                                    font-weight: 700;
                                }
                            }
                        }

                        // Metric 2: HTTP Ping / Handshake RTT
                        Rectangle {
                            background: Theme.card_alt_bg;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: Theme.inner_border;
                            horizontal-stretch: 1;
                            height: 96px;

                            VerticalLayout {
                                padding: 12px;
                                spacing: 4px;

                                Text {
                                    text: "HTTP Handshake Ping";
                                    color: Theme.text_secondary;
                                    font-size: 11px;
                                    font-weight: 600;
                                }

                                Text {
                                    text: root.ping_latency_text;
                                    color: Theme.text_primary;
                                    font-size: 20px;
                                    font-weight: 800;
                                }

                                Text {
                                    text: root.ping_status;
                                    color: root.ping_status == "Optimal" ? #10b981 : (root.ping_status == "Moderate" ? #f59e0b : Theme.text_muted);
                                    font-size: 11px;
                                    font-weight: 700;
                                }
                            }
                        }

                        // Metric 3: Byte-Range Resume Support
                        Rectangle {
                            background: Theme.card_alt_bg;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: Theme.inner_border;
                            horizontal-stretch: 1;
                            height: 96px;

                            VerticalLayout {
                                padding: 12px;
                                spacing: 4px;

                                Text {
                                    text: "Byte-Range Support";
                                    color: Theme.text_secondary;
                                    font-size: 11px;
                                    font-weight: 600;
                                }

                                Text {
                                    text: root.range_support_text;
                                    color: Theme.text_primary;
                                    font-size: 18px;
                                    font-weight: 800;
                                }

                                Text {
                                    text: root.range_status;
                                    color: root.range_status == "Supported" ? #10b981 : (root.range_status == "No Resume" ? #ef4444 : Theme.text_muted);
                                    font-size: 11px;
                                    font-weight: 700;
                                }
                            }
                        }

                        // Metric 4: Direct Throughput Probe
                        Rectangle {
                            background: Theme.card_alt_bg;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: Theme.inner_border;
                            horizontal-stretch: 1;
                            height: 96px;

                            VerticalLayout {
                                padding: 12px;
                                spacing: 4px;

                                Text {
                                    text: "Burst Throughput";
                                    color: Theme.text_secondary;
                                    font-size: 11px;
                                    font-weight: 600;
                                }

                                Text {
                                    text: root.throughput_text;
                                    color: #38bdf8;
                                    font-size: 20px;
                                    font-weight: 800;
                                }

                                Text {
                                    text: root.throughput_status;
                                    color: Theme.text_muted;
                                    font-size: 11px;
                                    font-weight: 600;
                                }
                            }
                        }
                    }

                    // Diagnostic Summary & Report Card
                    Rectangle {
                        background: Theme.is_dark ? #151c2e : #f8fafc;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: Theme.inner_border;

                        VerticalLayout {
                            padding: 16px;
                            spacing: 8px;

                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;

                                Image {
                                    source: @image-url("../icons/info.svg");
                                    width: 16px;
                                    height: 16px;
                                    colorize: Theme.brand_purple;
                                }

                                Text {
                                    text: root.summary_headline;
                                    color: Theme.text_primary;
                                    font-size: 13px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                            }

                            Text {
                                text: root.summary_details;
                                color: Theme.text_secondary;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: Theme.card_border;
            }

            // Modal Footer
            Rectangle {
                height: 52px;
                background: Theme.card_alt_bg;

                HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    alignment: space-between;

                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: "Target Host: " + root.target_url;
                            color: Theme.text_muted;
                            font-size: 11px;
                            overflow: elide;
                            max-width: 440px;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        ActionButton {
                            text: "Close";
                            height: 32px;
                            clicked => { root.close(); }
                        }
                    }
                }
            }
        }
    }
}
