export component NavButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> active: false;
    in property <int> badge_count: 0;
    callback clicked();

    background: root.active ? #252b45 :
                touch.has-hover ? #1c2132 : transparent;
    animate background { duration: 140ms; }
    border-radius: 8px;
    border-width: 1px;
    border-color: root.active ? #38426a : transparent;
    animate border-color { duration: 140ms; }
    height: 40px;

    // Active accent indicator bar on left edge
    if root.active: Rectangle {
        x: 4px;
        y: (parent.height - self.height) / 2;
        width: 3px;
        height: 18px;
        border-radius: 2px;
        background: #7082ff;
    }

    HorizontalLayout {
        padding-left: root.active ? 16px : 14px;
        padding-right: 12px;
        spacing: 12px;
        alignment: space-between;

        HorizontalLayout {
            spacing: 11px;
            alignment: start;

            VerticalLayout {
                alignment: center;
                Image {
                    source: root.icon;
                    width: 16px;
                    height: 16px;
                    colorize: root.active ? #7082ff : (touch.has-hover ? #ffffff : #8c93a8);
                    animate colorize { duration: 140ms; }
                }
            }

            Text {
                text: root.text;
                color: root.active ? #ffffff : (touch.has-hover ? #f1f5f9 : #949db2);
                font-size: 13px;
                font-weight: root.active ? 600 : 500;
                vertical-alignment: center;
                animate color { duration: 140ms; }
            }
        }

        // Optional numeric badge (e.g. for active downloads)
        if root.badge_count > 0: VerticalLayout {
            alignment: center;
            Rectangle {
                background: root.active ? #4f58c7 : #2a3048;
                border-radius: 9px;
                height: 18px;
                min-width: 18px;

                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    alignment: center;

                    Text {
                        text: root.badge_count;
                        color: #ffffff;
                        font-size: 10px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}
