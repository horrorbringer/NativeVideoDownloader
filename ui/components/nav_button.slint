import { Theme } from "../theme.slint";

export component NavButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> active: false;
    in property <int> badge_count: 0;
    callback clicked();

    background: root.active ? Theme.nav_active_bg :
                touch.has-hover ? Theme.nav_hover_bg : transparent;
    animate background { duration: 120ms; }
    border-radius: 8px;
    border-width: 1px;
    border-color: root.active ? Theme.nav_active_border :
                  touch.has-hover ? Theme.nav_hover_border : transparent;
    animate border-color { duration: 120ms; }
    height: 36px;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        alignment: space-between;

        HorizontalLayout {
            spacing: 10px;
            alignment: start;

            VerticalLayout {
                alignment: center;
                Image {
                    source: root.icon;
                    width: 16px;
                    height: 16px;
                    colorize: root.active ? Theme.brand_purple : (touch.has-hover ? Theme.text_primary : Theme.icon_default);
                    animate colorize { duration: 120ms; }
                }
            }

            Text {
                text: root.text;
                color: root.active ? Theme.nav_active_text : (touch.has-hover ? Theme.text_primary : Theme.nav_inactive_text);
                font-size: 13px;
                font-weight: root.active ? 600 : 500;
                vertical-alignment: center;
                animate color { duration: 120ms; }
            }
        }

        // Optional numeric badge (e.g. for active downloads)
        if root.badge_count > 0: VerticalLayout {
            alignment: center;
            Rectangle {
                background: root.active ? Theme.primary_accent : Theme.chip_bg;
                border-radius: 9px;
                height: 18px;
                min-width: 18px;

                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    alignment: center;

                    Text {
                        text: root.badge_count;
                        color: root.active ? #ffffff : Theme.chip_text;
                        font-size: 10px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}
