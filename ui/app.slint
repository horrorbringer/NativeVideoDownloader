import { Button, LineEdit, ProgressIndicator, ScrollView, TextEdit } from "std-widgets.slint";

component NavButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> active: false;
    callback clicked();

    background: active ? #2b314c : touch.has-hover ? #202436 : transparent;
    animate background { duration: 120ms; }
    border-radius: 8px;
    height: 42px;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 12px;
        alignment: start;

        Image {
            source: root.icon;
            width: 17px;
            height: 17px;
            colorize: root.active ? #7082ff : (touch.has-hover ? #ffffff : #8c93a8);
            vertical-alignment: center;
        }

        Text {
            text: root.text;
            color: root.active ? #ffffff : (touch.has-hover ? #e2e8f0 : #8c93a8);
            font-size: 13px;
            font-weight: root.active ? 600 : 500;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component IconChip inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> has_icon: false;
    in property <bool> selected: false;
    callback clicked();

    background: selected ? #4f58c7 : touch.has-hover ? #2a2f44 : #1c202d;
    animate background { duration: 120ms; }
    border-radius: 6px;
    border-width: 1px;
    border-color: selected ? #7082ff : (touch.has-hover ? #3c4460 : #2b3044);
    height: 32px;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 6px;
        alignment: center;

        if root.has_icon: Image {
            source: root.icon;
            width: 13px;
            height: 13px;
            colorize: root.selected ? #ffffff : (touch.has-hover ? #e2e8f0 : #949db2);
            vertical-alignment: center;
        }

        Text {
            text: root.text;
            color: root.selected ? #ffffff : (touch.has-hover ? #e2e8f0 : #949db2);
            font-size: 12px;
            font-weight: root.selected ? 600 : 500;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component ActionButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> has_icon: false;
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    callback clicked();

    background: !root.enabled ? #161822 :
                root.primary ? (touch.has-hover ? #5e68db : #4f58c7) :
                root.danger ? (touch.has-hover ? #dc2626 : #b91c1c) :
                (touch.has-hover ? #2b3044 : #1e2230);
    animate background { duration: 120ms; }
    border-radius: 6px;
    border-width: 1px;
    border-color: !root.enabled ? #232736 :
                  root.primary ? #7082ff :
                  root.danger ? #ef4444 : #2b3044;
    height: 34px;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 6px;
        alignment: center;

        if root.has_icon: Image {
            source: root.icon;
            width: 14px;
            height: 14px;
            colorize: !root.enabled ? #52596e :
                      (root.primary || root.danger) ? #ffffff :
                      (touch.has-hover ? #ffffff : #cbd5e1);
            vertical-alignment: center;
        }

        if root.text != "": Text {
            text: root.text;
            color: !root.enabled ? #52596e :
                   (root.primary || root.danger) ? #ffffff :
                   (touch.has-hover ? #ffffff : #cbd5e1);
            font-size: 12px;
            font-weight: (root.primary || root.danger) ? 600 : 500;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

export struct DownloadItemData {
    id: string,
    title: string,
    status: string,
    progress: float,
    size_text: string,
    speed_text: string,
    eta_text: string,
    output_path: string,
    is_completed: bool,
    can_pause: bool,
    can_resume: bool,
    can_cancel: bool,
}

export struct HistoryItemData {
    id: string,
    title: string,
    status: string,
    size_text: string,
    date_text: string,
    url: string,
    output_path: string,
}

export struct LogEntryData {
    timestamp: string,
    level: string,
    message: string,
}

export component AppWindow inherits Window {
    title: "Native Video Downloader";
    preferred-width: 940px;
    preferred-height: 640px;
    min-width: 780px;
    min-height: 520px;
    background: #14161f;

    in-out property <int> active_tab: 0;
    in-out property <string> status_message: "Ready to download media";
    in-out property <bool> is_analyzing: false;
    in-out property <string> video_title: "";
    in-out property <string> video_duration: "";
    in-out property <string> video_resolution: "";
    in-out property <bool> has_metadata: false;

    // Error alert banner
    in-out property <bool> has_error: false;
    in-out property <string> error_message: "";

    // Queue & Downloads properties
    in-out property <[DownloadItemData]> download_items: [];
    in-out property <int> active_downloads_count: 0;
    in-out property <int> total_queue_count: 0;
    in-out property <int> queue_filter_index: 0;
    in-out property <string> queue_search_query: "";

    // History properties
    in-out property <[HistoryItemData]> history_items: [];
    in-out property <string> history_search_query: "";

    // Real-time Logs properties
    in-out property <[LogEntryData]> log_entries: [];
    in-out property <int> log_filter_index: 0;
    in-out property <string> log_search_query: "";
    in-out property <int> log_total_count: 0;
    in-out property <int> log_info_count: 0;
    in-out property <int> log_warn_count: 0;
    in-out property <int> log_error_count: 0;

    // Batch mode & Quality selection
    in-out property <bool> batch_mode: false;
    in-out property <int> selected_format_index: 0;
    in-out property <bool> is_playlist: false;
    in-out property <int> playlist_count: 0;

    // Subtitles properties
    in-out property <bool> has_subtitles: false;
    in-out property <string> subtitles_summary: "";
    in-out property <bool> download_subtitles: true;

    // Input properties
    in-out property <string> input_url_text: "";
    in-out property <string> batch_urls_text: "";

    // Settings properties
    in-out property <string> download_dir_path: "~/Downloads";
    in-out property <int> selected_speed_limit_index: 0;
    in-out property <int> selected_concurrency: 3;

    callback analyze_url(string);
    callback paste_from_clipboard();
    callback paste_batch_from_clipboard();
    callback start_download(int, bool);
    callback start_batch_download(string, int);
    callback pause_download(string);
    callback resume_download(string);
    callback cancel_download(string);
    callback pause_all();
    callback resume_all();
    callback clear_completed();
    callback set_queue_filter(int);
    callback search_queue(string);

    callback search_history(string);
    callback open_history_folder(string);
    callback play_history_file(string);
    callback redownload_history(string);
    callback delete_history_item(string);
    callback clear_all_history();

    callback open_download_file(string);
    callback open_download_folder(string);

    callback browse_download_dir();
    callback reset_download_dir();
    callback open_current_download_dir();
    callback set_speed_limit(int);
    callback set_max_concurrency(int);
    callback test_notification();

    callback clear_logs();
    callback copy_logs();
    callback set_log_filter(int);
    callback search_logs(string);
    callback dismiss_error();

    HorizontalLayout {
        // Sidebar Navigation
        Rectangle {
            width: 200px;
            background: #181b26;

            VerticalLayout {
                padding: 16px;
                spacing: 10px;

                // App Title & Brand
                HorizontalLayout {
                    alignment: start;
                    spacing: 10px;
                    padding-bottom: 12px;
                    padding-left: 4px;

                    Rectangle {
                        width: 30px;
                        height: 30px;
                        border-radius: 8px;
                        background: #252b45;

                        Image {
                            source: @image-url("icons/bolt.svg");
                            width: 16px;
                            height: 16px;
                            colorize: #7082ff;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 1px;
                        Text {
                            text: "Media Stream";
                            color: #ffffff;
                            font-size: 14px;
                            font-weight: 700;
                        }
                        Text {
                            text: "Native Downloader";
                            color: #7082ff;
                            font-size: 11px;
                            font-weight: 600;
                        }
                    }
                }

                // Nav Items with crisp vector icons
                NavButton {
                    text: "Home";
                    icon: @image-url("icons/home.svg");
                    active: root.active_tab == 0;
                    clicked => { root.active_tab = 0; }
                }

                NavButton {
                    text: "Downloads";
                    icon: @image-url("icons/download.svg");
                    active: root.active_tab == 1;
                    clicked => { root.active_tab = 1; }
                }

                NavButton {
                    text: "History";
                    icon: @image-url("icons/history.svg");
                    active: root.active_tab == 2;
                    clicked => { root.active_tab = 2; }
                }

                NavButton {
                    text: "Logs";
                    icon: @image-url("icons/logs.svg");
                    active: root.active_tab == 3;
                    clicked => { root.active_tab = 3; }
                }

                NavButton {
                    text: "Settings";
                    icon: @image-url("icons/settings.svg");
                    active: root.active_tab == 4;
                    clicked => { root.active_tab = 4; }
                }

                // Spacer
                Rectangle { }
            }
        }

        // Main Content Area
        VerticalLayout {
            padding: 24px;
            spacing: 20px;

            // Header Bar
            HorizontalLayout {
                alignment: space-between;

                VerticalLayout {
                    Text {
                        text: root.active_tab == 0 ? "Download Media" :
                              root.active_tab == 1 ? "Active Downloads" :
                              root.active_tab == 2 ? "Download History" :
                              root.active_tab == 3 ? "Engine & Activity Logs" : "Application Settings";
                        color: #ffffff;
                        font-size: 22px;
                        font-weight: 700;
                    }
                    Text {
                        text: root.active_tab == 0 ? "Enter an authorized media URL to analyze and download" :
                              root.active_tab == 1 ? "Monitor ongoing queues, speeds and progress" :
                              root.active_tab == 2 ? "Past completed and archived downloads" :
                              root.active_tab == 3 ? "Real-time engine operations, streaming events, and diagnostics" : "Configure directories, concurrency, and defaults";
                        color: #8c93a8;
                        font-size: 13px;
                    }
                }
            }

            // Tab Content
            if root.active_tab == 0: VerticalLayout {
                spacing: 16px;

                // Error / Alert Banner (shown when error occurs)
                if root.has_error: Rectangle {
                    background: #2a151b;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: #ef4444;

                    HorizontalLayout {
                        padding: 12px;
                        spacing: 12px;
                        alignment: space-between;

                        HorizontalLayout {
                            horizontal-stretch: 1;
                            spacing: 12px;

                            Image {
                                source: @image-url("icons/alert.svg");
                                width: 20px;
                                height: 20px;
                                colorize: #ef4444;
                                vertical-alignment: center;
                            }

                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                alignment: center;

                                Text {
                                    text: "Analysis / Download Alert";
                                    color: #ef4444;
                                    font-size: 13px;
                                    font-weight: 700;
                                }
                                Text {
                                    text: root.error_message;
                                    color: #fca5a5;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: end;

                            ActionButton {
                                text: "Logs";
                                icon: @image-url("icons/logs.svg");
                                has_icon: true;
                                height: 28px;
                                clicked => { root.active_tab = 3; }
                            }

                            ActionButton {
                                text: "Dismiss";
                                icon: @image-url("icons/x.svg");
                                has_icon: true;
                                height: 28px;
                                clicked => { root.dismiss_error(); }
                            }
                        }
                    }
                }

                // Mode switcher: Single URL vs Batch URLs
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    IconChip {
                        text: "Single URL";
                        icon: @image-url("icons/link.svg");
                        has_icon: true;
                        selected: !root.batch_mode;
                        clicked => { root.batch_mode = false; }
                    }

                    IconChip {
                        text: "Batch URLs (Bulk)";
                        icon: @image-url("icons/layers.svg");
                        has_icon: true;
                        selected: root.batch_mode;
                        clicked => { root.batch_mode = true; }
                    }
                }

                // --- SINGLE URL MODE ---
                if !root.batch_mode: VerticalLayout {
                    spacing: 16px;

                    // URL Input Card
                    Rectangle {
                        background: #1c202d;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: #2b3044;

                        VerticalLayout {
                            padding: 18px;
                            spacing: 12px;

                            HorizontalLayout {
                                alignment: space-between;

                                Text {
                                    text: "Source Media URL";
                                    color: #c7cbd9;
                                    font-size: 13px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }

                                Text {
                                    text: "YouTube • Bilibili • Dailymotion • Vimeo • Direct HLS";
                                    color: #64748b;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                }
                            }

                            HorizontalLayout {
                                spacing: 10px;

                                url_input := LineEdit {
                                    horizontal-stretch: 1;
                                    text <=> root.input_url_text;
                                    placeholder_text: "Paste video or audio stream URL here...";
                                    font_size: 13px;
                                    height: 38px;
                                    accepted => {
                                        root.analyze_url(self.text);
                                    }
                                }

                                ActionButton {
                                    text: "Paste";
                                    icon: @image-url("icons/clipboard.svg");
                                    has_icon: true;
                                    height: 38px;
                                    clicked => {
                                        root.paste_from_clipboard();
                                    }
                                }

                                ActionButton {
                                    text: root.is_analyzing ? "Analyzing..." : "Analyze";
                                    icon: @image-url("icons/search.svg");
                                    has_icon: true;
                                    primary: true;
                                    enabled: !root.is_analyzing && root.input_url_text != "";
                                    height: 38px;
                                    clicked => {
                                        root.analyze_url(root.input_url_text);
                                    }
                                }
                            }

                            if root.is_analyzing: HorizontalLayout {
                                ProgressIndicator {
                                    indeterminate: true;
                                    height: 6px;
                                }
                            }
                        }
                    }

                    // Video Analysis Result Card (shown when metadata is found)
                    if root.has_metadata: Rectangle {
                        background: #1c202d;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: #2b3044;

                        VerticalLayout {
                            padding: 20px;
                            spacing: 14px;

                            HorizontalLayout {
                                alignment: space-between;

                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;

                                    Image {
                                        source: @image-url("icons/check.svg");
                                        width: 16px;
                                        height: 16px;
                                        colorize: #4ade80;
                                        vertical-alignment: center;
                                    }

                                    Text {
                                        text: "Media Stream Detected";
                                        color: #7082ff;
                                        font-size: 14px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                }

                                Rectangle {
                                    background: #163625;
                                    border-radius: 4px;
                                    height: 22px;

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        alignment: center;
                                        Text {
                                            text: "Ready to Download";
                                            color: #4ade80;
                                            font-size: 11px;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            HorizontalLayout {
                                spacing: 16px;

                                // Video preview icon/box
                                Rectangle {
                                    width: 130px;
                                    height: 85px;
                                    background: #23283b;
                                    border-radius: 8px;
                                    border-width: 1px;
                                    border-color: #2c3349;

                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 6px;

                                        Image {
                                            source: root.is_playlist ? @image-url("icons/tv.svg") :
                                                    root.selected_format_index == 4 ? @image-url("icons/music.svg") : @image-url("icons/video.svg");
                                            width: 26px;
                                            height: 26px;
                                            colorize: #7082ff;
                                            horizontal-alignment: center;
                                        }

                                        Text {
                                            text: root.is_playlist ? "Series" :
                                                  root.selected_format_index == 4 ? "Audio" : "Video";
                                            color: #8c93a8;
                                            font-size: 11px;
                                            font-weight: 600;
                                            horizontal-alignment: center;
                                        }
                                    }
                                }

                                VerticalLayout {
                                    spacing: 8px;
                                    alignment: center;
                                    horizontal-stretch: 1;

                                    Text {
                                        text: root.video_title != "" ? root.video_title : "Title unknown";
                                        color: #ffffff;
                                        font-size: 16px;
                                        font-weight: 600;
                                        overflow: elide;
                                    }

                                    HorizontalLayout {
                                        spacing: 8px;
                                        alignment: start;

                                        if root.is_playlist: Rectangle {
                                            background: #252a3d;
                                            border-radius: 4px;
                                            height: 22px;

                                            HorizontalLayout {
                                                padding-left: 8px;
                                                padding-right: 8px;
                                                alignment: center;
                                                Text {
                                                    text: "Series • " + root.playlist_count + " Episodes Available";
                                                    color: #cbd5e1;
                                                    font-size: 11px;
                                                    font-weight: 600;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }

                                        if !root.is_playlist && root.video_resolution != "": Rectangle {
                                            background: #252a3d;
                                            border-radius: 4px;
                                            height: 22px;

                                            HorizontalLayout {
                                                padding-left: 8px;
                                                padding-right: 8px;
                                                spacing: 4px;
                                                alignment: center;

                                                Image {
                                                    source: @image-url("icons/monitor.svg");
                                                    width: 12px;
                                                    height: 12px;
                                                    colorize: #949db2;
                                                    vertical-alignment: center;
                                                }

                                                Text {
                                                    text: root.video_resolution;
                                                    color: #cbd5e1;
                                                    font-size: 11px;
                                                    font-weight: 600;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }

                                        if !root.is_playlist && root.video_duration != "": Rectangle {
                                            background: #252a3d;
                                            border-radius: 4px;
                                            height: 22px;

                                            HorizontalLayout {
                                                padding-left: 8px;
                                                padding-right: 8px;
                                                spacing: 4px;
                                                alignment: center;

                                                Image {
                                                    source: @image-url("icons/history.svg");
                                                    width: 12px;
                                                    height: 12px;
                                                    colorize: #949db2;
                                                    vertical-alignment: center;
                                                }

                                                Text {
                                                    text: root.video_duration;
                                                    color: #cbd5e1;
                                                    font-size: 11px;
                                                    font-weight: 600;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            // Format & Quality Selection Chips
                            Text {
                                text: root.is_playlist ? "Select Quality for All Episodes:" : "Select Format & Quality:";
                                color: #c7cbd9;
                                font-size: 12px;
                                font-weight: 600;
                            }

                            HorizontalLayout {
                                spacing: 8px;

                                IconChip {
                                    text: "Best Quality";
                                    icon: @image-url("icons/video.svg");
                                    has_icon: true;
                                    selected: root.selected_format_index == 0;
                                    clicked => { root.selected_format_index = 0; }
                                }
                                IconChip {
                                    text: "1080p FHD";
                                    icon: @image-url("icons/video.svg");
                                    has_icon: true;
                                    selected: root.selected_format_index == 1;
                                    clicked => { root.selected_format_index = 1; }
                                }
                                IconChip {
                                    text: "720p HD";
                                    icon: @image-url("icons/video.svg");
                                    has_icon: true;
                                    selected: root.selected_format_index == 2;
                                    clicked => { root.selected_format_index = 2; }
                                }
                                IconChip {
                                    text: "480p SD";
                                    icon: @image-url("icons/video.svg");
                                    has_icon: true;
                                    selected: root.selected_format_index == 3;
                                    clicked => { root.selected_format_index = 3; }
                                }
                                IconChip {
                                    text: "Audio (MP3)";
                                    icon: @image-url("icons/music.svg");
                                    has_icon: true;
                                    selected: root.selected_format_index == 4;
                                    clicked => { root.selected_format_index = 4; }
                                }
                            }

                            // Subtitle extraction & embedding option
                            HorizontalLayout {
                                spacing: 10px;
                                alignment: space-between;

                                Rectangle {
                                    background: root.download_subtitles ? #1e3a5f : #171a26;
                                    border-radius: 8px;
                                    border-width: 1px;
                                    border-color: root.download_subtitles ? #38bdf8 : #2b3044;
                                    height: 32px;

                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        spacing: 6px;
                                        alignment: center;

                                        Image {
                                            source: @image-url("icons/subtitles.svg");
                                            width: 14px;
                                            height: 14px;
                                            colorize: root.download_subtitles ? #38bdf8 : #8c93a8;
                                            vertical-alignment: center;
                                        }

                                        Text {
                                            text: root.download_subtitles ? "Subtitles: Enabled (.srt/embed)" : "Subtitles: Disabled";
                                            color: root.download_subtitles ? #38bdf8 : #8c93a8;
                                            font-size: 12px;
                                            font-weight: 600;
                                            vertical-alignment: center;
                                        }
                                    }

                                    TouchArea {
                                        clicked => { root.download_subtitles = !root.download_subtitles; }
                                    }
                                }

                                if root.has_subtitles: VerticalLayout {
                                    alignment: center;
                                    Text {
                                        text: "Detected: " + root.subtitles_summary;
                                        color: #64748b;
                                        font-size: 11px;
                                        overflow: elide;
                                    }
                                }
                            }

                            HorizontalLayout {
                                alignment: end;
                                spacing: 10px;

                                ActionButton {
                                    text: root.is_playlist ? ("Download All " + root.playlist_count + " Episodes") : "Start Download";
                                    icon: @image-url("icons/download.svg");
                                    has_icon: true;
                                    primary: true;
                                    height: 38px;
                                    clicked => {
                                        root.start_download(root.selected_format_index, root.download_subtitles);
                                    }
                                }
                            }
                        }
                    }

                    // Empty / Placeholder state when no video analyzed
                    if !root.has_metadata && !root.is_analyzing: Rectangle {
                        background: #171a26;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: #24293a;
                        height: 200px;

                        VerticalLayout {
                            alignment: center;
                            spacing: 12px;

                            HorizontalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 48px;
                                    height: 48px;
                                    border-radius: 24px;
                                    background: #22273a;
                                    border-width: 1px;
                                    border-color: #2e354e;

                                    Image {
                                        source: @image-url("icons/sparkles.svg");
                                        width: 24px;
                                        height: 24px;
                                        colorize: #7082ff;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            VerticalLayout {
                                spacing: 4px;
                                Text {
                                    text: "Ready to Download Media";
                                    color: #ffffff;
                                    font-size: 15px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                }
                                Text {
                                    text: "Paste any video, playlist, or streaming audio link above to inspect available qualities";
                                    color: #8c93a8;
                                    font-size: 13px;
                                    horizontal-alignment: center;
                                }
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                alignment: center;

                                Rectangle {
                                    background: #1c2130;
                                    border-radius: 4px;
                                    height: 22px;
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        alignment: center;
                                        Text {
                                            text: "Up to 4K Lossless";
                                            color: #64748b;
                                            font-size: 11px;
                                            font-weight: 500;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                Rectangle {
                                    background: #1c2130;
                                    border-radius: 4px;
                                    height: 22px;
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        alignment: center;
                                        Text {
                                            text: "Fast Resumption";
                                            color: #64748b;
                                            font-size: 11px;
                                            font-weight: 500;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                Rectangle {
                                    background: #1c2130;
                                    border-radius: 4px;
                                    height: 22px;
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        alignment: center;
                                        Text {
                                            text: "Subtitles & Audio MP3";
                                            color: #64748b;
                                            font-size: 11px;
                                            font-weight: 500;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // --- BATCH URLS MODE ---
                if root.batch_mode: VerticalLayout {
                    spacing: 16px;

                    Rectangle {
                        background: #1c202d;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: #2b3044;

                        VerticalLayout {
                            padding: 20px;
                            spacing: 14px;

                            HorizontalLayout {
                                alignment: space-between;
                                Text {
                                    text: "Batch Download Queue (one link per line)";
                                    color: #c7cbd9;
                                    font-size: 14px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                                ActionButton {
                                    text: "Paste Clipboard";
                                    icon: @image-url("icons/clipboard.svg");
                                    has_icon: true;
                                    height: 30px;
                                    clicked => {
                                        root.paste_batch_from_clipboard();
                                    }
                                }
                            }

                            batch_input := TextEdit {
                                text <=> root.batch_urls_text;
                                font-size: 13px;
                                height: 140px;
                            }

                            Text {
                                text: "Select Default Format for Batch:";
                                color: #c7cbd9;
                                font-size: 12px;
                                font-weight: 600;
                            }

                            HorizontalLayout {
                                spacing: 8px;

                                IconChip {
                                    text: "Best Quality";
                                    icon: @image-url("icons/video.svg");
                                    has_icon: true;
                                    selected: root.selected_format_index == 0;
                                    clicked => { root.selected_format_index = 0; }
                                }
                                IconChip {
                                    text: "720p HD";
                                    icon: @image-url("icons/video.svg");
                                    has_icon: true;
                                    selected: root.selected_format_index == 2;
                                    clicked => { root.selected_format_index = 2; }
                                }
                                IconChip {
                                    text: "Audio (MP3)";
                                    icon: @image-url("icons/music.svg");
                                    has_icon: true;
                                    selected: root.selected_format_index == 4;
                                    clicked => { root.selected_format_index = 4; }
                                }
                            }

                            HorizontalLayout {
                                alignment: end;
                                spacing: 10px;

                                ActionButton {
                                    text: "Queue All in Batch";
                                    icon: @image-url("icons/download.svg");
                                    has_icon: true;
                                    primary: true;
                                    height: 38px;
                                    clicked => {
                                        root.start_batch_download(root.batch_urls_text, root.selected_format_index);
                                    }
                                }
                            }
                        }
                    }
                }

                // Spacer
                Rectangle { }
            }

            // Tab 1: Downloads
            if root.active_tab == 1: VerticalLayout {
                spacing: 14px;

                // Queue Toolbar
                HorizontalLayout {
                    alignment: space-between;

                    Text {
                        text: "Queue (" + root.total_queue_count + " jobs)";
                        color: #a0a7ba;
                        font-size: 13px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }

                    HorizontalLayout {
                        spacing: 8px;

                        ActionButton {
                            text: "Pause All";
                            icon: @image-url("icons/pause.svg");
                            has_icon: true;
                            height: 32px;
                            clicked => { root.pause_all(); }
                        }

                        ActionButton {
                            text: "Resume All";
                            icon: @image-url("icons/play.svg");
                            has_icon: true;
                            height: 32px;
                            clicked => { root.resume_all(); }
                        }

                        ActionButton {
                            text: "Clear Finished";
                            icon: @image-url("icons/broom.svg");
                            has_icon: true;
                            height: 32px;
                            clicked => { root.clear_completed(); }
                        }
                    }
                }

                // Search & Filter Toolbar
                HorizontalLayout {
                    spacing: 12px;

                    queue_search := LineEdit {
                        placeholder_text: "Search active or queued downloads by title or URL...";
                        font_size: 13px;
                        height: 36px;
                        horizontal-stretch: 1;
                        edited => {
                            root.queue_search_query = self.text;
                            root.search_queue(self.text);
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    IconChip {
                        text: "All";
                        selected: root.queue_filter_index == 0;
                        clicked => {
                            root.queue_filter_index = 0;
                            root.set_queue_filter(0);
                        }
                    }
                    IconChip {
                        text: "Downloading";
                        icon: @image-url("icons/download.svg");
                        has_icon: true;
                        selected: root.queue_filter_index == 1;
                        clicked => {
                            root.queue_filter_index = 1;
                            root.set_queue_filter(1);
                        }
                    }
                    IconChip {
                        text: "Queued";
                        icon: @image-url("icons/history.svg");
                        has_icon: true;
                        selected: root.queue_filter_index == 2;
                        clicked => {
                            root.queue_filter_index = 2;
                            root.set_queue_filter(2);
                        }
                    }
                    IconChip {
                        text: "Paused";
                        icon: @image-url("icons/pause.svg");
                        has_icon: true;
                        selected: root.queue_filter_index == 3;
                        clicked => {
                            root.queue_filter_index = 3;
                            root.set_queue_filter(3);
                        }
                    }
                    IconChip {
                        text: "Completed";
                        icon: @image-url("icons/check.svg");
                        has_icon: true;
                        selected: root.queue_filter_index == 4;
                        clicked => {
                            root.queue_filter_index = 4;
                            root.set_queue_filter(4);
                        }
                    }
                    IconChip {
                        text: "Failed";
                        icon: @image-url("icons/x.svg");
                        has_icon: true;
                        selected: root.queue_filter_index == 5;
                        clicked => {
                            root.queue_filter_index = 5;
                            root.set_queue_filter(5);
                        }
                    }
                }

                // If no downloads in current view
                if root.download_items.length == 0: Rectangle {
                    background: #1c202d;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: #2b3044;
                    height: 200px;

                    VerticalLayout {
                        alignment: center;
                        spacing: 12px;

                        HorizontalLayout {
                            alignment: center;
                            Rectangle {
                                width: 44px;
                                height: 44px;
                                border-radius: 22px;
                                background: #23283c;

                                Image {
                                    source: (root.queue_filter_index != 0 || root.queue_search_query != "") ? @image-url("icons/search.svg") : @image-url("icons/download.svg");
                                    width: 22px;
                                    height: 22px;
                                    colorize: #7082ff;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        VerticalLayout {
                            spacing: 4px;
                            Text {
                                text: (root.queue_filter_index != 0 || root.queue_search_query != "") ? "No matching downloads found" : "No active downloads";
                                color: #ffffff;
                                font-size: 15px;
                                font-weight: 700;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: (root.queue_filter_index != 0 || root.queue_search_query != "") ? "Try selecting 'All' or clearing your search query above." : "Downloads in progress, paused, or queued will appear here.";
                                color: #8c93a8;
                                font-size: 13px;
                                horizontal-alignment: center;
                            }
                        }
                    }
                }

                // If downloads exist in queue
                if root.download_items.length > 0: ScrollView {
                    VerticalLayout {
                        spacing: 12px;

                        for item in root.download_items: Rectangle {
                            background: #1c202d;
                            border-radius: 12px;
                            border-width: 1px;
                            border-color: #2b3044;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 12px;

                                HorizontalLayout {
                                    alignment: space-between;

                                    VerticalLayout {
                                        spacing: 4px;
                                        Text {
                                            text: item.title;
                                            color: #ffffff;
                                            font-size: 15px;
                                            font-weight: 600;
                                        }
                                        Text {
                                            text: "Status: " + item.status;
                                            color: item.status == "Completed" ? #4ade80 :
                                                   item.status == "Paused" ? #facc15 :
                                                   item.status == "Downloading" ? #60a5fa :
                                                   item.status == "Queued" ? #c084fc : #f87171;
                                            font-size: 12px;
                                            font-weight: 600;
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 6px;
                                        alignment: end;

                                        if item.is_completed: ActionButton {
                                            text: "Play";
                                            icon: @image-url("icons/play.svg");
                                            has_icon: true;
                                            height: 30px;
                                            clicked => { root.open_download_file(item.output_path); }
                                        }

                                        if item.is_completed: ActionButton {
                                            text: "Finder";
                                            icon: @image-url("icons/folder.svg");
                                            has_icon: true;
                                            height: 30px;
                                            clicked => { root.open_download_folder(item.output_path); }
                                        }

                                        if item.can_pause: ActionButton {
                                            text: "Pause";
                                            icon: @image-url("icons/pause.svg");
                                            has_icon: true;
                                            height: 30px;
                                            clicked => { root.pause_download(item.id); }
                                        }

                                        if item.can_resume: ActionButton {
                                            text: "Resume";
                                            icon: @image-url("icons/play.svg");
                                            has_icon: true;
                                            height: 30px;
                                            clicked => { root.resume_download(item.id); }
                                        }

                                        if item.can_cancel: ActionButton {
                                            text: "Cancel";
                                            icon: @image-url("icons/x.svg");
                                            has_icon: true;
                                            danger: true;
                                            height: 30px;
                                            clicked => { root.cancel_download(item.id); }
                                        }
                                    }
                                }

                                ProgressIndicator {
                                    progress: item.progress;
                                    height: 7px;
                                }

                                HorizontalLayout {
                                    alignment: space-between;

                                    Text {
                                        text: item.size_text;
                                        color: #949db2;
                                        font-size: 12px;
                                    }

                                    Text {
                                        text: "Speed: " + item.speed_text + "  •  ETA: " + item.eta_text;
                                        color: #949db2;
                                        font-size: 12px;
                                    }
                                }
                            }
                        }
                    }
                }

                Rectangle { }
            }

            // Tab 2: History
            if root.active_tab == 2: VerticalLayout {
                spacing: 12px;

                // Search and toolbar
                HorizontalLayout {
                    spacing: 12px;
                    alignment: space-between;

                    search_box := LineEdit {
                        horizontal-stretch: 1;
                        placeholder_text: "Search history by title or file path...";
                        font_size: 13px;
                        height: 36px;
                        text <=> root.history_search_query;
                        edited => { root.search_history(self.text); }
                    }

                    Rectangle {
                        background: #181b26;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: #272d42;
                        height: 36px;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            alignment: center;
                            Text {
                                text: root.history_items.length + " Records";
                                color: #8c93a8;
                                font-size: 12px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                    }

                    ActionButton {
                        text: "Clear All";
                        icon: @image-url("icons/trash.svg");
                        has_icon: true;
                        danger: true;
                        height: 36px;
                        enabled: root.history_items.length > 0;
                        clicked => { root.clear_all_history(); }
                    }
                }

                // If no history items
                if root.history_items.length == 0: Rectangle {
                    background: #181b27;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: #272d42;
                    vertical-stretch: 1;

                    VerticalLayout {
                        alignment: center;
                        spacing: 12px;

                        HorizontalLayout {
                            alignment: center;
                            Rectangle {
                                width: 44px;
                                height: 44px;
                                border-radius: 22px;
                                background: #23283c;

                                Image {
                                    source: root.history_search_query != "" ? @image-url("icons/search.svg") : @image-url("icons/history.svg");
                                    width: 22px;
                                    height: 22px;
                                    colorize: #7082ff;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        VerticalLayout {
                            spacing: 4px;
                            Text {
                                text: root.history_search_query != "" ? "No history records match your search" : "No download history yet";
                                color: #ffffff;
                                font-size: 15px;
                                font-weight: 700;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: root.history_search_query != "" ? "Try a different keyword or clear the search box above." : "Finished and saved media downloads will be persisted here.";
                                color: #8c93a8;
                                font-size: 13px;
                                horizontal-alignment: center;
                            }
                        }
                    }
                }

                // If history items exist
                if root.history_items.length > 0: ScrollView {
                    vertical-stretch: 1;

                    VerticalLayout {
                        spacing: 10px;
                        padding-bottom: 8px;

                        for item in root.history_items: Rectangle {
                            background: touch_history.has-hover ? #1f2334 : #171a26;
                            border-radius: 12px;
                            border-width: 1px;
                            border-color: item.status == "Completed" ? #252d40 : (item.status == "Failed" ? #451b1b : #24293a);
                            animate background { duration: 150ms; }

                            touch_history := TouchArea { }

                            VerticalLayout {
                                padding: 14px;
                                spacing: 10px;

                                // Row 1: Title & Action Buttons
                                HorizontalLayout {
                                    alignment: space-between;
                                    spacing: 12px;

                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 6px;

                                        Text {
                                            text: item.title;
                                            color: #ffffff;
                                            font-size: 15px;
                                            font-weight: 700;
                                            overflow: elide;
                                        }

                                        HorizontalLayout {
                                            spacing: 10px;
                                            alignment: start;

                                            // Status pill
                                            Rectangle {
                                                height: 22px;
                                                border-radius: 4px;
                                                background: item.status == "Completed" ? #14532d : (item.status == "Failed" ? #7f1d1d : #334155);

                                                HorizontalLayout {
                                                    padding-left: 8px;
                                                    padding-right: 8px;
                                                    spacing: 4px;
                                                    alignment: center;

                                                    Image {
                                                        source: item.status == "Completed" ? @image-url("icons/check.svg") : @image-url("icons/x.svg");
                                                        width: 12px;
                                                        height: 12px;
                                                        colorize: item.status == "Completed" ? #4ade80 : #fca5a5;
                                                        vertical-alignment: center;
                                                    }

                                                    Text {
                                                        text: item.status == "Completed" ? "Completed" : item.status;
                                                        color: item.status == "Completed" ? #4ade80 : (item.status == "Failed" ? #fca5a5 : #cbd5e1);
                                                        font-size: 11px;
                                                        font-weight: 700;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }

                                            // File size
                                            HorizontalLayout {
                                                spacing: 4px;
                                                alignment: start;

                                                Image {
                                                    source: @image-url("icons/package.svg");
                                                    width: 13px;
                                                    height: 13px;
                                                    colorize: #949db2;
                                                    vertical-alignment: center;
                                                }

                                                Text {
                                                    text: item.size_text;
                                                    color: #949db2;
                                                    font-size: 12px;
                                                    vertical-alignment: center;
                                                }
                                            }

                                            // Date / Timestamp
                                            if item.date_text != "": HorizontalLayout {
                                                spacing: 4px;
                                                alignment: start;

                                                Image {
                                                    source: @image-url("icons/history.svg");
                                                    width: 13px;
                                                    height: 13px;
                                                    colorize: #64748b;
                                                    vertical-alignment: center;
                                                }

                                                Text {
                                                    text: item.date_text;
                                                    color: #64748b;
                                                    font-size: 12px;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }

                                    // Action buttons
                                    HorizontalLayout {
                                        spacing: 8px;
                                        alignment: end;

                                        if item.status == "Completed": ActionButton {
                                            text: "Play";
                                            icon: @image-url("icons/play.svg");
                                            has_icon: true;
                                            height: 32px;
                                            clicked => { root.play_history_file(item.output_path); }
                                        }

                                        ActionButton {
                                            text: "Finder";
                                            icon: @image-url("icons/folder.svg");
                                            has_icon: true;
                                            height: 32px;
                                            clicked => { root.open_history_folder(item.output_path); }
                                        }

                                        ActionButton {
                                            text: "Redownload";
                                            icon: @image-url("icons/refresh.svg");
                                            has_icon: true;
                                            height: 32px;
                                            clicked => { root.redownload_history(item.url); }
                                        }

                                        ActionButton {
                                            icon: @image-url("icons/x.svg");
                                            has_icon: true;
                                            danger: true;
                                            height: 32px;
                                            clicked => { root.delete_history_item(item.id); }
                                        }
                                    }
                                }

                                // Row 2: Recessed File Path Bezel
                                Rectangle {
                                    background: #111420;
                                    border-radius: 6px;
                                    border-width: 1px;
                                    border-color: #202538;
                                    height: 28px;

                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        alignment: start;
                                        spacing: 6px;

                                        Image {
                                            source: @image-url("icons/folder.svg");
                                            width: 12px;
                                            height: 12px;
                                            colorize: #64748b;
                                            vertical-alignment: center;
                                        }

                                        Text {
                                            text: item.output_path;
                                            color: #64748b;
                                            font-size: 11px;
                                            overflow: elide;
                                            horizontal-stretch: 1;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }


            // Tab 3: Logs View
            if root.active_tab == 3: VerticalLayout {
                spacing: 12px;

                // Toolbar
                HorizontalLayout {
                    alignment: space-between;
                    spacing: 12px;

                    // Filter chips: All, Info, Warn, Errors
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;

                        IconChip {
                            text: "All (" + root.log_total_count + ")";
                            selected: root.log_filter_index == 0;
                            clicked => {
                                root.log_filter_index = 0;
                                root.set_log_filter(0);
                            }
                        }
                        IconChip {
                            text: "Info (" + root.log_info_count + ")";
                            icon: @image-url("icons/info.svg");
                            has_icon: true;
                            selected: root.log_filter_index == 1;
                            clicked => {
                                root.log_filter_index = 1;
                                root.set_log_filter(1);
                            }
                        }
                        IconChip {
                            text: "Warnings (" + root.log_warn_count + ")";
                            icon: @image-url("icons/alert.svg");
                            has_icon: true;
                            selected: root.log_filter_index == 2;
                            clicked => {
                                root.log_filter_index = 2;
                                root.set_log_filter(2);
                            }
                        }
                        IconChip {
                            text: "Errors (" + root.log_error_count + ")";
                            icon: @image-url("icons/x.svg");
                            has_icon: true;
                            selected: root.log_filter_index == 3;
                            clicked => {
                                root.log_filter_index = 3;
                                root.set_log_filter(3);
                            }
                        }
                    }

                    // Search & Action Buttons
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;

                        log_search := LineEdit {
                            width: 170px;
                            height: 32px;
                            placeholder_text: "Filter logs...";
                            text <=> root.log_search_query;
                            edited(query) => {
                                root.search_logs(query);
                            }
                        }

                        ActionButton {
                            text: "Copy";
                            icon: @image-url("icons/clipboard.svg");
                            has_icon: true;
                            height: 32px;
                            enabled: root.log_total_count > 0;
                            clicked => { root.copy_logs(); }
                        }

                        ActionButton {
                            text: "Clear";
                            icon: @image-url("icons/trash.svg");
                            has_icon: true;
                            height: 32px;
                            enabled: root.log_total_count > 0;
                            clicked => { root.clear_logs(); }
                        }
                    }
                }

                // If no logs match filter/query
                if root.log_entries.length == 0: Rectangle {
                    background: #10131d;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: #212638;
                    vertical-stretch: 1;

                    VerticalLayout {
                        alignment: center;
                        spacing: 12px;

                        HorizontalLayout {
                            alignment: center;
                            Rectangle {
                                width: 44px;
                                height: 44px;
                                border-radius: 22px;
                                background: #1a1e2d;

                                Image {
                                    source: (root.log_filter_index != 0 || root.log_search_query != "") ? @image-url("icons/search.svg") : @image-url("icons/logs.svg");
                                    width: 22px;
                                    height: 22px;
                                    colorize: #7082ff;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        VerticalLayout {
                            spacing: 4px;
                            Text {
                                text: (root.log_filter_index != 0 || root.log_search_query != "") ? "No matching logs found" : "No logs recorded yet";
                                color: #ffffff;
                                font-size: 15px;
                                font-weight: 700;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: (root.log_filter_index != 0 || root.log_search_query != "") ? "Try selecting 'All' or clearing your search filter above." : "Engine operations, inspections, stream events, and diagnostics will stream here live.";
                                color: #8c93a8;
                                font-size: 13px;
                                horizontal-alignment: center;
                            }
                        }
                    }
                }

                // Unified Terminal Log Console Card
                if root.log_entries.length > 0: Rectangle {
                    background: #10131d;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: #212638;
                    vertical-stretch: 1;
                    clip: true;

                    ScrollView {
                        VerticalLayout {
                            padding: 8px;
                            spacing: 2px;

                            for entry in root.log_entries: Rectangle {
                                background: touch_log.has-hover ? #191e2c : (
                                    entry.level == "ERROR" ? #241419 :
                                    entry.level == "WARN" ? #221c12 :
                                    transparent
                                );
                                border-radius: 4px;

                                touch_log := TouchArea { }

                                HorizontalLayout {
                                    padding-top: 6px;
                                    padding-bottom: 6px;
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 12px;
                                    alignment: start;

                                    // Fixed-width timestamp: never pushes columns!
                                    Text {
                                        text: entry.timestamp;
                                        color: #64748b;
                                        font-size: 11px;
                                        width: 68px;
                                        vertical-alignment: top;
                                    }

                                    // Level badge
                                    Rectangle {
                                        width: 50px;
                                        height: 19px;
                                        border-radius: 4px;
                                        background: entry.level == "ERROR" ? #ef4444 :
                                                    entry.level == "WARN" ? #f59e0b : #3b82f6;

                                        Text {
                                            text: entry.level;
                                            color: #ffffff;
                                            font-size: 10px;
                                            font-weight: 700;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }

                                    // Message: fills remaining space and wraps gracefully
                                    Text {
                                        text: entry.message;
                                        color: entry.level == "ERROR" ? #fca5a5 :
                                               entry.level == "WARN" ? #fde68a : #cbd5e1;
                                        font-size: 12px;
                                        horizontal-stretch: 1;
                                        wrap: word-wrap;
                                        vertical-alignment: top;
                                    }
                                }
                            }
                        }
                    }
                }
            }


            // Tab 4: Settings
            if root.active_tab == 4: ScrollView {
                vertical-stretch: 1;

                VerticalLayout {
                    spacing: 16px;
                    padding-bottom: 16px;

                    // 1. Storage & File Location
                    Rectangle {
                        background: #181b27;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: #272d42;

                        VerticalLayout {
                            padding: 20px;
                            spacing: 14px;

                            VerticalLayout {
                                spacing: 6px;

                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;

                                    Image {
                                        source: @image-url("icons/folder.svg");
                                        width: 16px;
                                        height: 16px;
                                        colorize: #7082ff;
                                        vertical-alignment: center;
                                    }

                                    Text {
                                        text: "Default Download Directory";
                                        color: #ffffff;
                                        font-size: 15px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                }

                                Text {
                                    text: "All media, video series, and extracted audio files are saved into this folder.";
                                    color: #8c93a8;
                                    font-size: 13px;
                                }
                            }

                            HorizontalLayout {
                                spacing: 10px;

                                Rectangle {
                                    background: #111420;
                                    border-radius: 8px;
                                    border-width: 1px;
                                    border-color: #252b3e;
                                    horizontal-stretch: 1;
                                    height: 38px;

                                    HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        alignment: start;

                                        Text {
                                            text: root.download_dir_path;
                                            color: #e2e8f0;
                                            font-size: 13px;
                                            font-weight: 500;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                    }
                                }

                                ActionButton {
                                    text: "Change...";
                                    icon: @image-url("icons/folder.svg");
                                    has_icon: true;
                                    height: 38px;
                                    clicked => { root.browse_download_dir(); }
                                }

                                ActionButton {
                                    text: "Finder";
                                    icon: @image-url("icons/monitor.svg");
                                    has_icon: true;
                                    height: 38px;
                                    clicked => { root.open_current_download_dir(); }
                                }

                                ActionButton {
                                    text: "Reset";
                                    icon: @image-url("icons/refresh.svg");
                                    has_icon: true;
                                    height: 38px;
                                    clicked => { root.reset_download_dir(); }
                                }
                            }
                        }
                    }

                    // 2. Network & Bandwidth Management
                    Rectangle {
                        background: #181b27;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: #272d42;

                        VerticalLayout {
                            padding: 20px;
                            spacing: 18px;

                            // Speed Limiter
                            VerticalLayout {
                                spacing: 10px;

                                VerticalLayout {
                                    spacing: 6px;

                                    HorizontalLayout {
                                        spacing: 8px;
                                        alignment: start;

                                        Image {
                                            source: @image-url("icons/bolt.svg");
                                            width: 16px;
                                            height: 16px;
                                            colorize: #7082ff;
                                            vertical-alignment: center;
                                        }

                                        Text {
                                            text: "Bandwidth Speed Limiter";
                                            color: #ffffff;
                                            font-size: 15px;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }
                                    }

                                    Text {
                                        text: "Throttle maximum download speed to avoid saturating your local network.";
                                        color: #8c93a8;
                                        font-size: 13px;
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;

                                    IconChip {
                                        text: "No Limit";
                                        icon: @image-url("icons/bolt.svg");
                                        has_icon: true;
                                        selected: root.selected_speed_limit_index == 0;
                                        clicked => {
                                            root.selected_speed_limit_index = 0;
                                            root.set_speed_limit(0);
                                        }
                                    }
                                    IconChip {
                                        text: "2 MB/s";
                                        selected: root.selected_speed_limit_index == 1;
                                        clicked => {
                                            root.selected_speed_limit_index = 1;
                                            root.set_speed_limit(1);
                                        }
                                    }
                                    IconChip {
                                        text: "5 MB/s";
                                        selected: root.selected_speed_limit_index == 2;
                                        clicked => {
                                            root.selected_speed_limit_index = 2;
                                            root.set_speed_limit(2);
                                        }
                                    }
                                    IconChip {
                                        text: "10 MB/s";
                                        selected: root.selected_speed_limit_index == 3;
                                        clicked => {
                                            root.selected_speed_limit_index = 3;
                                            root.set_speed_limit(3);
                                        }
                                    }
                                    IconChip {
                                        text: "20 MB/s";
                                        selected: root.selected_speed_limit_index == 4;
                                        clicked => {
                                            root.selected_speed_limit_index = 4;
                                            root.set_speed_limit(4);
                                        }
                                    }
                                }
                            }

                            // Divider
                            Rectangle {
                                height: 1px;
                                background: #23283b;
                            }

                            // Concurrency
                            VerticalLayout {
                                spacing: 10px;

                                VerticalLayout {
                                    spacing: 6px;

                                    HorizontalLayout {
                                        spacing: 8px;
                                        alignment: start;

                                        Image {
                                            source: @image-url("icons/cpu.svg");
                                            width: 16px;
                                            height: 16px;
                                            colorize: #7082ff;
                                            vertical-alignment: center;
                                        }

                                        Text {
                                            text: "Concurrent Queue Workers";
                                            color: #ffffff;
                                            font-size: 15px;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }
                                    }

                                    Text {
                                        text: "Number of download items actively processed at the same time.";
                                        color: #8c93a8;
                                        font-size: 13px;
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;

                                    IconChip {
                                        text: "1 (Sequential)";
                                        selected: root.selected_concurrency == 1;
                                        clicked => {
                                            root.selected_concurrency = 1;
                                            root.set_max_concurrency(1);
                                        }
                                    }
                                    IconChip {
                                        text: "2 Parallel";
                                        selected: root.selected_concurrency == 2;
                                        clicked => {
                                            root.selected_concurrency = 2;
                                            root.set_max_concurrency(2);
                                        }
                                    }
                                    IconChip {
                                        text: "3 Parallel (Recommended)";
                                        selected: root.selected_concurrency == 3;
                                        clicked => {
                                            root.selected_concurrency = 3;
                                            root.set_max_concurrency(3);
                                        }
                                    }
                                    IconChip {
                                        text: "5 Parallel (Fast)";
                                        selected: root.selected_concurrency == 5;
                                        clicked => {
                                            root.selected_concurrency = 5;
                                            root.set_max_concurrency(5);
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // 3. System & Desktop Notifications
                    Rectangle {
                        background: #181b27;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: #272d42;

                        VerticalLayout {
                            padding: 20px;
                            spacing: 12px;

                            HorizontalLayout {
                                alignment: space-between;

                                VerticalLayout {
                                    spacing: 6px;

                                    HorizontalLayout {
                                        spacing: 8px;
                                        alignment: start;

                                        Image {
                                            source: @image-url("icons/bell.svg");
                                            width: 16px;
                                            height: 16px;
                                            colorize: #7082ff;
                                            vertical-alignment: center;
                                        }

                                        Text {
                                            text: "System Notifications";
                                            color: #ffffff;
                                            font-size: 15px;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }
                                    }

                                    Text {
                                        text: "Sends native desktop alerts with audio chime when downloads finish.";
                                        color: #8c93a8;
                                        font-size: 13px;
                                    }
                                }

                                ActionButton {
                                    text: "Test Notification";
                                    icon: @image-url("icons/bell.svg");
                                    has_icon: true;
                                    height: 34px;
                                    clicked => { root.test_notification(); }
                                }
                            }
                        }
                    }

                    // 4. Engine & Architecture Overview (Compact & Clean)
                    Rectangle {
                        background: #131622;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: #222638;

                        VerticalLayout {
                            padding: 16px;
                            spacing: 10px;

                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;

                                Image {
                                    source: @image-url("icons/cpu.svg");
                                    width: 15px;
                                    height: 15px;
                                    colorize: #7082ff;
                                    vertical-alignment: center;
                                }

                                Text {
                                    text: "Engine & System Architecture";
                                    color: #7082ff;
                                    font-size: 13px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                            }

                            HorizontalLayout {
                                alignment: space-between;
                                Text {
                                    text: "Core Media Framework";
                                    color: #949db2;
                                    font-size: 12px;
                                }
                                Text {
                                    text: "FFmpeg v9 + yt-dlp Native";
                                    color: #e2e8f0;
                                    font-size: 12px;
                                    font-weight: 600;
                                }
                            }

                            HorizontalLayout {
                                alignment: space-between;
                                Text {
                                    text: "Chunk Resumption & Partial Safety";
                                    color: #949db2;
                                    font-size: 12px;
                                }
                                Text {
                                    text: "Atomic .part + HTTP Multi-Range";
                                    color: #4ade80;
                                    font-size: 12px;
                                    font-weight: 600;
                                }
                            }

                            HorizontalLayout {
                                alignment: space-between;
                                Text {
                                    text: "Persistent Storage Engine";
                                    color: #949db2;
                                    font-size: 12px;
                                }
                                Text {
                                    text: "SQLite 3 (WAL mode)";
                                    color: #38bdf8;
                                    font-size: 12px;
                                    font-weight: 600;
                                }
                            }
                        }
                    }
                }
            }

            // Status bar at bottom
            Rectangle {
                background: #181a24;
                border-radius: 8px;
                height: 36px;

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    alignment: space-between;

                    Text {
                        text: root.status_message;
                        color: root.has_error ? #f87171 : #79829c;
                        font-size: 12px;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }

                    Text {
                        text: "v0.1.0 • Slint Native";
                        color: #52596e;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
