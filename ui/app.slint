import { DownloadItemData, EpisodeItemData, HistoryItemData, LogEntryData, SpeedSampleData } from "models.slint";
import { NavButton } from "components/nav_button.slint";
import { HomeTab } from "tabs/home_tab.slint";
import { DownloadsTab } from "tabs/downloads_tab.slint";
import { HistoryTab } from "tabs/history_tab.slint";
import { LogsTab } from "tabs/logs_tab.slint";
import { SettingsTab } from "tabs/settings_tab.slint";
import { Theme } from "theme.slint";

export { DownloadItemData, EpisodeItemData, HistoryItemData, LogEntryData, SpeedSampleData, Theme }

export component AppWindow inherits Window {
    title: root.active_downloads_count > 0 ? ("Native Video Downloader (" + root.active_downloads_count + " downloading • " + root.current_total_speed_text + ")") : "Native Video Downloader";
    preferred-width: 1040px;
    preferred-height: 740px;
    min-width: 820px;
    min-height: 560px;
    background: Theme.app_bg;

    in-out property <bool> is_dark_mode <=> Theme.is_dark;
    in-out property <int> theme_mode: 2; // 0 = Light, 1 = Dark, 2 = Auto / System
    callback toggle_theme();
    callback set_theme_mode(int);

    in-out property <int> active_tab: 0;
    in-out property <string> status_message: "Ready to download media";
    in-out property <bool> is_analyzing: false;
    in-out property <string> video_title: "";
    in-out property <string> video_duration: "";
    in-out property <string> video_resolution: "";
    in-out property <bool> has_metadata: false;

    // Error alert banner
    in-out property <bool> has_error: false;
    in-out property <string> error_message: "";

    // Queue & Downloads properties
    in-out property <[DownloadItemData]> download_items: [];
    in-out property <int> active_downloads_count: 0;
    in-out property <int> total_queue_count: 0;
    in-out property <int> queue_filter_index: 0;
    in-out property <string> queue_search_query: "";
    in-out property <[SpeedSampleData]> speed_samples: [];
    in-out property <string> current_total_speed_text: "0 B/s";
    in-out property <string> peak_speed_text: "0 B/s";
    in-out property <string> session_downloaded_text: "0 B";
    in-out property <bool> show_speed_graph: true;
    in-out property <bool> is_downloading_active: false;

    // History properties
    in-out property <[HistoryItemData]> history_items: [];
    in-out property <string> history_search_query: "";

    // Real-time Logs properties
    in-out property <[LogEntryData]> log_entries: [];
    in-out property <int> log_filter_index: 0;
    in-out property <string> log_search_query: "";
    in-out property <int> log_total_count: 0;
    in-out property <int> log_info_count: 0;
    in-out property <int> log_warn_count: 0;
    in-out property <int> log_error_count: 0;

    // Batch mode & Quality selection
    in-out property <bool> batch_mode: false;
    in-out property <int> selected_format_index: 0;
    in-out property <bool> is_playlist: false;
    in-out property <int> playlist_count: 0;
    in-out property <[EpisodeItemData]> playlist_episodes: [];
    in-out property <int> selected_episodes_count: 0;
    in-out property <string> episode_range_input: "";

    // Subtitles properties
    in-out property <bool> has_subtitles: false;
    in-out property <string> subtitles_summary: "";
    in-out property <bool> download_subtitles: true;
    in-out property <bool> download_thumbnail: true;
    in-out property <bool> has_thumbnail: false;
    in-out property <image> thumbnail_image;

    // Detailed metadata properties
    in-out property <string> video_size_text: "";
    in-out property <string> video_fps_text: "";
    in-out property <string> video_codecs_text: "";
    in-out property <string> format_best_label: "Best Quality";
    in-out property <string> format_1080_label: "1080p FHD";
    in-out property <string> format_720_label: "720p HD";
    in-out property <string> format_480_label: "480p SD";
    in-out property <string> format_audio_label: "Extract Audio";

    // Dedicated Audio Extractor properties
    in-out property <int> selected_audio_format_index: 0;
    in-out property <int> selected_audio_bitrate_index: 0;
    in-out property <bool> embed_audio_metadata: true;

    // Input properties
    in-out property <string> input_url_text: "";
    in-out property <string> batch_urls_text: "";

    // Settings properties
    in-out property <string> download_dir_path: "~/Downloads";
    in-out property <int> selected_speed_limit_index: 0;
    in-out property <int> selected_concurrency: 3;
    in-out property <int> selected_cookies_browser_index: 0;
    in-out property <bool> clipboard_monitor_enabled: true;
    in-out property <string> filename_template: "{title}.{ext}";
    in-out property <int> selected_asset_org_mode: 0;
    in-out property <int> selected_sub_lang_index: 0;
    in-out property <bool> sub_lang_all: true;
    in-out property <bool> sub_lang_en: false;
    in-out property <bool> sub_lang_km: false;
    in-out property <bool> sub_lang_th: false;
    in-out property <bool> sub_lang_vi: false;
    in-out property <bool> sub_lang_id: false;
    in-out property <bool> sub_lang_my: false;
    in-out property <bool> sub_lang_zh: false;
    in-out property <bool> sub_lang_ja: false;
    in-out property <bool> sub_lang_ko: false;
    in-out property <bool> sub_lang_es: false;
    in-out property <bool> sub_lang_fr: false;
    in-out property <bool> sub_lang_de: false;
    in-out property <bool> sub_lang_ru: false;
    in-out property <bool> sub_lang_pt: false;
    in-out property <bool> sub_lang_ar: false;
    in-out property <string> selected_sub_langs_summary: "All Languages";
    in-out property <int> selected_concurrent_fragments: 4;

    // Network & Custom Proxy properties
    in-out property <bool> proxy_enabled: false;
    in-out property <string> proxy_url_input: "";
    in-out property <string> proxy_status_message: "";
    in-out property <bool> proxy_is_connected: false;
    in-out property <bool> is_testing_proxy: false;

    // Live Clipboard Link Monitor properties
    in-out property <bool> clipboard_detected_url_visible: false;
    in-out property <string> clipboard_detected_url: "";

    // Callbacks
    callback analyze_url(string);
    callback paste_from_clipboard();
    callback paste_batch_from_clipboard();
    callback import_links_file();
    callback analyze_clipboard_detected();
    callback dismiss_clipboard_detected();
    callback set_clipboard_monitor(bool);
    callback set_default_audio_format(int);
    callback set_default_audio_bitrate(int);
    callback set_embed_audio_metadata(bool);
    callback set_proxy(bool, string);
    callback test_proxy(string);
    callback set_sub_lang(int);
    callback toggle_sub_lang(int);
    callback start_download(int, bool, bool, int, int, bool, int);
    callback start_batch_download(string, int, bool, int, int, bool, int);
    callback pause_download(string);
    callback resume_download(string);
    callback cancel_download(string);
    callback pause_all();
    callback resume_all();
    callback clear_completed();
    callback clear_failed();
    callback clear_cache();
    callback set_queue_filter(int);
    callback search_queue(string);

    callback search_history(string);
    callback open_history_folder(string);
    callback play_history_file(string);
    callback redownload_history(string);
    callback delete_history_item(string);
    callback clear_all_history();
    callback export_history();
    callback refresh_history_tab();

    callback open_download_file(string);
    callback open_download_folder(string);

    callback browse_download_dir();
    callback reset_download_dir();
    callback open_current_download_dir();
    callback set_filename_template(string);
    callback set_asset_organization_mode(int);
    callback set_speed_limit(int);
    callback set_max_concurrency(int);
    callback set_cookies_browser(int);
    callback test_notification();
    callback update_extractor();
    callback set_concurrent_fragments(int);

    callback clear_logs();
    callback copy_logs();
    callback set_log_filter(int);
    callback search_logs(string);
    callback dismiss_error();
    callback clear_analysis();
    callback toggle_episode(int);
    callback select_all_episodes(bool);
    callback apply_episode_range(string);

    HorizontalLayout {
        // Sidebar Navigation
        Rectangle {
            width: 216px;
            background: Theme.sidebar_bg;
            border-width: 1px;
            border-color: Theme.sidebar_border;
            animate background { duration: 150ms; }

            VerticalLayout {
                padding: 10px;
                spacing: 4px;

                // App Title & Brand + Quick Theme Toggle
                HorizontalLayout {
                    alignment: space-between;
                    padding-bottom: 10px;
                    padding-left: 2px;
                    padding-right: 2px;
                    padding-top: 2px;

                    HorizontalLayout {
                        spacing: 8px;
                        Rectangle {
                            width: 32px;
                            height: 32px;
                            border-radius: 8px;
                            background: Theme.sidebar_brand_bg;
                            border-width: 1px;
                            border-color: Theme.sidebar_brand_border;

                            Image {
                                source: @image-url("icons/bolt.svg");
                                width: 17px;
                                height: 17px;
                                colorize: Theme.brand_purple;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            spacing: 1px;
                            Text {
                                text: "Media Stream";
                                color: Theme.text_primary;
                                font-size: 14px;
                                font-weight: 700;
                            }
                            Text {
                                text: "Native Pro Downloader";
                                color: Theme.brand_purple;
                                font-size: 11px;
                                font-weight: 600;
                            }
                        }
                    }

                    // Theme toggle button (vertically centered)
                    VerticalLayout {
                        alignment: center;

                        theme_btn := Rectangle {
                            width: 28px;
                            height: 28px;
                            border-radius: 6px;
                            background: theme_touch.has-hover ? Theme.nav_hover_bg : transparent;
                            border-width: 1px;
                            border-color: theme_touch.has-hover ? Theme.nav_hover_border : transparent;

                            Image {
                                source: root.theme_mode == 2 ? @image-url("icons/monitor.svg") : (Theme.is_dark ? @image-url("icons/moon.svg") : @image-url("icons/sun.svg"));
                                width: 15px;
                                height: 15px;
                                colorize: theme_touch.has-hover ? Theme.brand_purple : Theme.icon_default;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }

                            theme_touch := TouchArea {
                                clicked => {
                                    if root.theme_mode == 2 {
                                        root.set_theme_mode(1);
                                    } else if root.theme_mode == 1 {
                                        root.set_theme_mode(0);
                                    } else {
                                        root.set_theme_mode(2);
                                    }
                                }
                            }
                        }
                    }
                }

                // Nav Items
                NavButton {
                    text: "Home";
                    icon: @image-url("icons/home.svg");
                    active: root.active_tab == 0;
                    clicked => { root.active_tab = 0; }
                }

                NavButton {
                    text: "Downloads";
                    icon: @image-url("icons/download.svg");
                    active: root.active_tab == 1;
                    badge_count: root.active_downloads_count;
                    clicked => { root.active_tab = 1; }
                }

                NavButton {
                    text: "History";
                    icon: @image-url("icons/history.svg");
                    active: root.active_tab == 2;
                    clicked => {
                        root.active_tab = 2;
                        root.refresh_history_tab();
                    }
                }

                NavButton {
                    text: "Logs";
                    icon: @image-url("icons/logs.svg");
                    active: root.active_tab == 3;
                    clicked => { root.active_tab = 3; }
                }

                NavButton {
                    text: "Settings";
                    icon: @image-url("icons/settings.svg");
                    active: root.active_tab == 4;
                    clicked => { root.active_tab = 4; }
                }

                // Spacer
                Rectangle { }

                // Sidebar System Status Widget
                Rectangle {
                    background: Theme.sidebar_status_bg;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: Theme.sidebar_status_border;
                    height: 52px;

                    VerticalLayout {
                        padding: 8px;
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 4px;
                        alignment: center;

                        HorizontalLayout {
                            spacing: 6px;
                            alignment: start;

                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 6px;
                                    height: 6px;
                                    border-radius: 3px;
                                    background: root.active_downloads_count > 0 ? #f59e0b : #4ade80;
                                }
                            }

                            Text {
                                text: root.active_downloads_count > 0 ? "Active Tasks" : "Engine Ready";
                                color: Theme.text_primary;
                                font-size: 11px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }

                        Text {
                            text: root.active_downloads_count > 0 ?
                                  (root.active_downloads_count + " downloading • " + root.selected_concurrency + " workers") :
                                  ("Workers: " + root.selected_concurrency + " • SQLite OK");
                            color: Theme.text_secondary;
                            font-size: 10px;
                        }
                    }
                }
            }
        }

        // Main Content Area
        VerticalLayout {
            padding: 16px;
            spacing: 14px;

            // Header Bar
            HorizontalLayout {
                alignment: space-between;

                VerticalLayout {
                    spacing: 2px;
                    Text {
                        text: root.active_tab == 0 ? "Download Media" :
                              root.active_tab == 1 ? "Active Downloads" :
                              root.active_tab == 2 ? "Download History" :
                              root.active_tab == 3 ? "Engine & Activity Logs" : "Application Settings";
                        color: Theme.text_primary;
                        font-size: 20px;
                        font-weight: 700;
                    }
                    Text {
                        text: root.active_tab == 0 ? "Enter any video or playlist URL to inspect and download" :
                              root.active_tab == 1 ? "Monitor ongoing queues, speeds and progress" :
                              root.active_tab == 2 ? "Past completed and archived downloads" :
                              root.active_tab == 3 ? "Real-time engine operations, streaming events, and diagnostics" : "Configure directories, concurrency, and defaults";
                        color: Theme.text_secondary;
                        font-size: 12px;
                    }
                }

                // Live status badge
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        background: Theme.sidebar_status_bg;
                        border-radius: 14px;
                        border-width: 1px;
                        border-color: Theme.sidebar_status_border;
                        height: 28px;

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 12px;
                            spacing: 6px;
                            alignment: center;

                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 6px;
                                    height: 6px;
                                    border-radius: 3px;
                                    background: root.has_error ? #ef4444 :
                                                root.is_analyzing ? #60a5fa :
                                                root.active_downloads_count > 0 ? #f59e0b : #4ade80;
                                }
                            }

                            Text {
                                text: root.has_error ? "Alert" :
                                      root.is_analyzing ? "Analyzing stream..." :
                                      root.active_downloads_count > 0 ? (root.active_downloads_count + " active tasks") :
                                      "Ready";
                                color: Theme.text_secondary;
                                font-size: 11px;
                                font-weight: 500;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }

            // Tab Content Router
            if root.active_tab == 0: HomeTab {
                has_error <=> root.has_error;
                error_message <=> root.error_message;
                batch_mode <=> root.batch_mode;
                input_url_text <=> root.input_url_text;
                batch_urls_text <=> root.batch_urls_text;
                is_analyzing: root.is_analyzing;
                has_metadata: root.has_metadata;
                video_title: root.video_title;
                video_duration: root.video_duration;
                video_resolution: root.video_resolution;
                is_playlist: root.is_playlist;
                playlist_count: root.playlist_count;
                playlist_episodes: root.playlist_episodes;
                selected_episodes_count: root.selected_episodes_count;
                episode_range_input <=> root.episode_range_input;
                selected_format_index <=> root.selected_format_index;
                has_subtitles: root.has_subtitles;
                subtitles_summary: root.subtitles_summary;
                download_subtitles <=> root.download_subtitles;
                download_thumbnail <=> root.download_thumbnail;
                has_thumbnail: root.has_thumbnail;
                thumbnail_image: root.thumbnail_image;
                video_size_text: root.video_size_text;
                video_fps_text: root.video_fps_text;
                video_codecs_text: root.video_codecs_text;
                format_best_label: root.format_best_label;
                format_1080_label: root.format_1080_label;
                format_720_label: root.format_720_label;
                format_480_label: root.format_480_label;
                format_audio_label: root.format_audio_label;
                selected_audio_format_index <=> root.selected_audio_format_index;
                selected_audio_bitrate_index <=> root.selected_audio_bitrate_index;
                embed_audio_metadata <=> root.embed_audio_metadata;
                clipboard_detected_url_visible <=> root.clipboard_detected_url_visible;
                clipboard_detected_url <=> root.clipboard_detected_url;
                selected_sub_lang_index <=> root.selected_sub_lang_index;
                sub_lang_all <=> root.sub_lang_all;
                sub_lang_en <=> root.sub_lang_en;
                sub_lang_km <=> root.sub_lang_km;
                sub_lang_th <=> root.sub_lang_th;
                sub_lang_vi <=> root.sub_lang_vi;
                sub_lang_id <=> root.sub_lang_id;
                sub_lang_my <=> root.sub_lang_my;
                sub_lang_zh <=> root.sub_lang_zh;
                sub_lang_ja <=> root.sub_lang_ja;
                sub_lang_ko <=> root.sub_lang_ko;
                sub_lang_es <=> root.sub_lang_es;
                sub_lang_fr <=> root.sub_lang_fr;
                sub_lang_de <=> root.sub_lang_de;
                sub_lang_ru <=> root.sub_lang_ru;
                sub_lang_pt <=> root.sub_lang_pt;
                sub_lang_ar <=> root.sub_lang_ar;
                selected_sub_langs_summary <=> root.selected_sub_langs_summary;
                toggle_sub_lang(idx) => { root.toggle_sub_lang(idx); }

                analyze_url(url) => { root.analyze_url(url); }
                clear_analysis() => { root.clear_analysis(); }
                toggle_episode(idx) => { root.toggle_episode(idx); }
                select_all_episodes(all) => { root.select_all_episodes(all); }
                apply_episode_range(range) => { root.apply_episode_range(range); }
                paste_from_clipboard() => { root.paste_from_clipboard(); }
                paste_batch_from_clipboard() => { root.paste_batch_from_clipboard(); }
                import_links_file() => { root.import_links_file(); }
                analyze_clipboard_detected() => { root.analyze_clipboard_detected(); }
                dismiss_clipboard_detected() => { root.dismiss_clipboard_detected(); }
                start_download(fmt, subs, thumb, afmt, abr, meta, sub_lang) => { root.start_download(fmt, subs, thumb, afmt, abr, meta, sub_lang); }
                start_batch_download(text, fmt, thumb, afmt, abr, meta, sub_lang) => { root.start_batch_download(text, fmt, thumb, afmt, abr, meta, sub_lang); }
                dismiss_error() => { root.dismiss_error(); }
                open_logs() => { root.active_tab = 3; }
            }

            if root.active_tab == 1: DownloadsTab {
                download_items: root.download_items;
                total_queue_count: root.total_queue_count;
                queue_filter_index <=> root.queue_filter_index;
                queue_search_query <=> root.queue_search_query;
                speed_samples: root.speed_samples;
                current_total_speed_text: root.current_total_speed_text;
                peak_speed_text: root.peak_speed_text;
                session_downloaded_text: root.session_downloaded_text;
                show_speed_graph <=> root.show_speed_graph;
                is_downloading_active: root.is_downloading_active;

                pause_all() => { root.pause_all(); }
                resume_all() => { root.resume_all(); }
                clear_completed() => { root.clear_completed(); }
                clear_failed() => { root.clear_failed(); }
                set_queue_filter(idx) => { root.set_queue_filter(idx); }
                search_queue(q) => { root.search_queue(q); }
                open_download_file(p) => { root.open_download_file(p); }
                open_download_folder(p) => { root.open_download_folder(p); }
                pause_download(id) => { root.pause_download(id); }
                resume_download(id) => { root.resume_download(id); }
                cancel_download(id) => { root.cancel_download(id); }
            }

            if root.active_tab == 2: HistoryTab {
                history_items: root.history_items;
                history_search_query <=> root.history_search_query;

                search_history(q) => { root.search_history(q); }
                clear_all_history() => { root.clear_all_history(); }
                export_history() => { root.export_history(); }
                play_history_file(p) => { root.play_history_file(p); }
                open_history_folder(p) => { root.open_history_folder(p); }
                redownload_history(u) => { root.redownload_history(u); }
                delete_history_item(id) => { root.delete_history_item(id); }
            }

            if root.active_tab == 3: LogsTab {
                log_entries: root.log_entries;
                log_filter_index <=> root.log_filter_index;
                log_search_query <=> root.log_search_query;
                log_total_count: root.log_total_count;
                log_info_count: root.log_info_count;
                log_warn_count: root.log_warn_count;
                log_error_count: root.log_error_count;

                set_log_filter(idx) => { root.set_log_filter(idx); }
                search_logs(q) => { root.search_logs(q); }
                copy_logs() => { root.copy_logs(); }
                clear_logs() => { root.clear_logs(); }
            }

            if root.active_tab == 4: SettingsTab {
                download_dir_path <=> root.download_dir_path;
                selected_speed_limit_index <=> root.selected_speed_limit_index;
                selected_concurrency <=> root.selected_concurrency;
                selected_cookies_browser_index <=> root.selected_cookies_browser_index;
                clipboard_monitor_enabled <=> root.clipboard_monitor_enabled;
                proxy_enabled <=> root.proxy_enabled;
                proxy_url_input <=> root.proxy_url_input;
                proxy_status_message <=> root.proxy_status_message;
                proxy_is_connected <=> root.proxy_is_connected;
                is_testing_proxy <=> root.is_testing_proxy;
                default_audio_format_index <=> root.selected_audio_format_index;
                default_audio_bitrate_index <=> root.selected_audio_bitrate_index;
                default_embed_audio_metadata <=> root.embed_audio_metadata;
                filename_template <=> root.filename_template;
                selected_asset_org_mode <=> root.selected_asset_org_mode;
                selected_sub_lang_index <=> root.selected_sub_lang_index;
                sub_lang_all <=> root.sub_lang_all;
                sub_lang_en <=> root.sub_lang_en;
                sub_lang_km <=> root.sub_lang_km;
                sub_lang_th <=> root.sub_lang_th;
                sub_lang_vi <=> root.sub_lang_vi;
                sub_lang_id <=> root.sub_lang_id;
                sub_lang_my <=> root.sub_lang_my;
                sub_lang_zh <=> root.sub_lang_zh;
                sub_lang_ja <=> root.sub_lang_ja;
                sub_lang_ko <=> root.sub_lang_ko;
                sub_lang_es <=> root.sub_lang_es;
                sub_lang_fr <=> root.sub_lang_fr;
                sub_lang_de <=> root.sub_lang_de;
                sub_lang_ru <=> root.sub_lang_ru;
                sub_lang_pt <=> root.sub_lang_pt;
                sub_lang_ar <=> root.sub_lang_ar;
                selected_sub_langs_summary <=> root.selected_sub_langs_summary;
                toggle_sub_lang(idx) => { root.toggle_sub_lang(idx); }
                selected_concurrent_fragments <=> root.selected_concurrent_fragments;

                browse_download_dir() => { root.browse_download_dir(); }
                open_current_download_dir() => { root.open_current_download_dir(); }
                reset_download_dir() => { root.reset_download_dir(); }
                set_filename_template(tpl) => { root.set_filename_template(tpl); }
                set_asset_organization_mode(m) => { root.set_asset_organization_mode(m); }
                set_sub_lang(idx) => { root.set_sub_lang(idx); }
                set_speed_limit(idx) => { root.set_speed_limit(idx); }
                set_max_concurrency(c) => { root.set_max_concurrency(c); }
                set_cookies_browser(b) => { root.set_cookies_browser(b); }
                set_clipboard_monitor(e) => { root.set_clipboard_monitor(e); }
                set_default_audio_format(fmt) => { root.set_default_audio_format(fmt); }
                set_default_audio_bitrate(br) => { root.set_default_audio_bitrate(br); }
                set_embed_audio_metadata(em) => { root.set_embed_audio_metadata(em); }
                set_proxy(en, p) => { root.set_proxy(en, p); }
                test_proxy(p) => { root.test_proxy(p); }
                test_notification() => { root.test_notification(); }
                update_extractor() => { root.update_extractor(); }
                clear_cache() => { root.clear_cache(); }
                set_concurrent_fragments(n) => { root.set_concurrent_fragments(n); }
                theme_mode: root.theme_mode;
                set_theme_mode(m) => { root.set_theme_mode(m); }
                set_theme_dark(d) => { root.set_theme_mode(d ? 1 : 0); }
            }

            // Status bar at bottom
            Rectangle {
                background: Theme.sidebar_status_bg;
                border-radius: 8px;
                border-width: 1px;
                border-color: Theme.sidebar_status_border;
                height: 36px;

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    alignment: space-between;

                    Text {
                        text: root.status_message;
                        color: root.has_error ? Theme.error_text : Theme.text_secondary;
                        font-size: 12px;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }

                    Text {
                        text: "v0.1.0 • Slint Native Engine";
                        color: Theme.text_dimmed;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
