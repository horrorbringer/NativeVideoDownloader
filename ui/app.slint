import { Button, LineEdit, ProgressIndicator, ScrollView, TextEdit } from "std-widgets.slint";

component NavButton inherits Rectangle {
    in property <string> text;
    in property <bool> active: false;
    callback clicked();

    background: active ? #2d3250 : touch.has-hover ? #25283b : transparent;
    animate background { duration: 120ms; }
    border-radius: 8px;
    height: 42px;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        alignment: start;

        Text {
            text: root.text;
            color: root.active ? #ffffff : #a0a5b5;
            font-size: 14px;
            font-weight: root.active ? 600 : 400;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component QualityChip inherits Rectangle {
    in property <string> text;
    in property <bool> selected: false;
    callback clicked();

    background: selected ? #4f58c7 : touch.has-hover ? #2d3348 : #232738;
    animate background { duration: 120ms; }
    border-radius: 6px;
    height: 32px;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        alignment: center;
        Text {
            text: root.text;
            color: root.selected ? #ffffff : #a0a7ba;
            font-size: 12px;
            font-weight: root.selected ? 600 : 400;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

export struct DownloadItemData {
    id: string,
    title: string,
    status: string,
    progress: float,
    size_text: string,
    speed_text: string,
    eta_text: string,
    output_path: string,
    is_completed: bool,
    can_pause: bool,
    can_resume: bool,
    can_cancel: bool,
}

export struct HistoryItemData {
    id: string,
    title: string,
    status: string,
    size_text: string,
    date_text: string,
    url: string,
    output_path: string,
}

export struct LogEntryData {
    timestamp: string,
    level: string,
    message: string,
}

export component AppWindow inherits Window {
    title: "Native Video Downloader";
    preferred-width: 940px;
    preferred-height: 640px;
    min-width: 780px;
    min-height: 520px;
    background: #14161f;

    in-out property <int> active_tab: 0;
    in-out property <string> status_message: "Ready to download media";
    in-out property <bool> is_analyzing: false;
    in-out property <string> video_title: "";
    in-out property <string> video_duration: "";
    in-out property <string> video_resolution: "";
    in-out property <bool> has_metadata: false;

    // Error alert banner
    in-out property <bool> has_error: false;
    in-out property <string> error_message: "";

    // Queue & Downloads properties
    in-out property <[DownloadItemData]> download_items: [];
    in-out property <int> active_downloads_count: 0;
    in-out property <int> total_queue_count: 0;
    in-out property <int> queue_filter_index: 0;
    in-out property <string> queue_search_query: "";

    // History properties
    in-out property <[HistoryItemData]> history_items: [];

    // Real-time Logs properties
    in-out property <[LogEntryData]> log_entries: [];

    // Batch mode & Quality selection
    in-out property <bool> batch_mode: false;
    in-out property <int> selected_format_index: 0;
    in-out property <bool> is_playlist: false;
    in-out property <int> playlist_count: 0;

    // Subtitles properties
    in-out property <bool> has_subtitles: false;
    in-out property <string> subtitles_summary: "";
    in-out property <bool> download_subtitles: true;

    // Input properties
    in-out property <string> input_url_text: "";
    in-out property <string> batch_urls_text: "";

    // Settings properties
    in-out property <string> download_dir_path: "~/Downloads";
    in-out property <int> selected_speed_limit_index: 0;
    in-out property <int> selected_concurrency: 3;

    callback analyze_url(string);
    callback paste_from_clipboard();
    callback paste_batch_from_clipboard();
    callback start_download(int, bool);
    callback start_batch_download(string, int);
    callback pause_download(string);
    callback resume_download(string);
    callback cancel_download(string);
    callback pause_all();
    callback resume_all();
    callback clear_completed();
    callback set_queue_filter(int);
    callback search_queue(string);

    callback search_history(string);
    callback open_history_folder(string);
    callback play_history_file(string);
    callback redownload_history(string);
    callback delete_history_item(string);
    callback clear_all_history();

    callback open_download_file(string);
    callback open_download_folder(string);

    callback browse_download_dir();
    callback reset_download_dir();
    callback open_current_download_dir();
    callback set_speed_limit(int);
    callback set_max_concurrency(int);
    callback test_notification();

    callback clear_logs();
    callback dismiss_error();

    HorizontalLayout {
        // Sidebar Navigation
        Rectangle {
            width: 220px;
            background: #1a1d29;

            VerticalLayout {
                padding: 18px;
                spacing: 12px;

                // App Title
                HorizontalLayout {
                    alignment: start;
                    spacing: 8px;
                    padding-bottom: 12px;

                    Text {
                        text: "⚡ Video Downloader";
                        color: #7082ff;
                        font-size: 16px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }

                // Nav Items
                NavButton {
                    text: "🏠  Home";
                    active: root.active_tab == 0;
                    clicked => { root.active_tab = 0; }
                }

                NavButton {
                    text: "📥  Downloads";
                    active: root.active_tab == 1;
                    clicked => { root.active_tab = 1; }
                }

                NavButton {
                    text: "📜  History";
                    active: root.active_tab == 2;
                    clicked => { root.active_tab = 2; }
                }

                NavButton {
                    text: "📋  Logs";
                    active: root.active_tab == 3;
                    clicked => { root.active_tab = 3; }
                }

                NavButton {
                    text: "⚙️  Settings";
                    active: root.active_tab == 4;
                    clicked => { root.active_tab = 4; }
                }

                // Spacer
                Rectangle { }

                // System / Engine status indicator
                Rectangle {
                    background: #232736;
                    border-radius: 8px;
                    height: 50px;

                    VerticalLayout {
                        padding: 8px;
                        alignment: center;
                        spacing: 2px;
                        Text {
                            text: "ENGINE STATUS";
                            color: #6c738a;
                            font-size: 10px;
                            font-weight: 700;
                        }
                        Text {
                            text: "● Online & Idle";
                            color: #4ade80;
                            font-size: 12px;
                            font-weight: 600;
                        }
                    }
                }
            }
        }

        // Main Content Area
        VerticalLayout {
            padding: 24px;
            spacing: 20px;

            // Header Bar
            HorizontalLayout {
                alignment: space-between;

                VerticalLayout {
                    Text {
                        text: root.active_tab == 0 ? "Download Media" :
                              root.active_tab == 1 ? "Active Downloads" :
                              root.active_tab == 2 ? "Download History" :
                              root.active_tab == 3 ? "Engine & Activity Logs" : "Application Settings";
                        color: #ffffff;
                        font-size: 22px;
                        font-weight: 700;
                    }
                    Text {
                        text: root.active_tab == 0 ? "Enter an authorized media URL to analyze and download" :
                              root.active_tab == 1 ? "Monitor ongoing queues, speeds and progress" :
                              root.active_tab == 2 ? "Past completed and archived downloads" :
                              root.active_tab == 3 ? "Real-time engine operations, streaming events, and diagnostics" : "Configure directories, concurrency, and defaults";
                        color: #8c93a8;
                        font-size: 13px;
                    }
                }
            }

            // Tab Content
            if root.active_tab == 0: VerticalLayout {
                spacing: 16px;

                // Error / Alert Banner (shown when error occurs)
                if root.has_error: Rectangle {
                    background: #2a151b;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: #ef4444;

                    HorizontalLayout {
                        padding: 14px;
                        spacing: 12px;
                        alignment: space-between;

                        HorizontalLayout {
                            spacing: 12px;
                            Text {
                                text: "⚠️";
                                font-size: 18px;
                                vertical-alignment: center;
                            }
                            VerticalLayout {
                                spacing: 2px;
                                alignment: center;
                                Text {
                                    text: "Analysis / Download Alert";
                                    color: #ef4444;
                                    font-size: 13px;
                                    font-weight: 700;
                                }
                                Text {
                                    text: root.error_message;
                                    color: #fca5a5;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: end;

                            Button {
                                text: "View Details in Logs";
                                height: 30px;
                                clicked => { root.active_tab = 3; }
                            }

                            Button {
                                text: "✕";
                                height: 30px;
                                clicked => { root.dismiss_error(); }
                            }
                        }
                    }
                }

                // Mode switcher: Single URL vs Batch URLs
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    QualityChip {
                        text: "🔗 Single URL";
                        selected: !root.batch_mode;
                        clicked => { root.batch_mode = false; }
                    }

                    QualityChip {
                        text: "📋 Batch URLs (Bulk)";
                        selected: root.batch_mode;
                        clicked => { root.batch_mode = true; }
                    }
                }

                // --- SINGLE URL MODE ---
                if !root.batch_mode: VerticalLayout {
                    spacing: 16px;

                    // URL Input Card
                    Rectangle {
                        background: #1c202d;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: #2b3044;

                        VerticalLayout {
                            padding: 18px;
                            spacing: 12px;

                            Text {
                                text: "Source Media URL";
                                color: #c7cbd9;
                                font-size: 13px;
                                font-weight: 600;
                            }

                            HorizontalLayout {
                                spacing: 10px;

                                url_input := LineEdit {
                                    text <=> root.input_url_text;
                                    placeholder_text: "https://example.com/video/123";
                                    font_size: 14px;
                                    height: 38px;
                                    accepted => {
                                        root.analyze_url(self.text);
                                    }
                                }

                                Button {
                                    text: "📋 Paste";
                                    height: 38px;
                                    clicked => {
                                        root.paste_from_clipboard();
                                    }
                                }

                                Button {
                                    text: root.is_analyzing ? "Analyzing..." : "Analyze URL";
                                    enabled: !root.is_analyzing && root.input_url_text != "";
                                    height: 38px;
                                    clicked => {
                                        root.analyze_url(root.input_url_text);
                                    }
                                }
                            }

                            if root.is_analyzing: HorizontalLayout {
                                ProgressIndicator {
                                    indeterminate: true;
                                    height: 6px;
                                }
                            }
                        }
                    }

                    // Video Analysis Result Card (shown when metadata is found)
                    if root.has_metadata: Rectangle {
                        background: #1c202d;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: #2b3044;

                        VerticalLayout {
                            padding: 20px;
                            spacing: 14px;

                            Text {
                                text: "Media Information";
                                color: #7082ff;
                                font-size: 14px;
                                font-weight: 700;
                            }

                            HorizontalLayout {
                                spacing: 16px;

                                // Video preview icon/box
                                Rectangle {
                                    width: 140px;
                                    height: 90px;
                                    background: #262c3e;
                                    border-radius: 8px;

                                    Text {
                                        text: root.is_playlist ? "📺 Series" :
                                              root.selected_format_index == 4 ? "🎵 Audio" : "🎬 Video";
                                        color: #a4adc7;
                                        font-size: 14px;
                                        vertical-alignment: center;
                                        horizontal-alignment: center;
                                    }
                                }

                                VerticalLayout {
                                    spacing: 6px;
                                    alignment: center;

                                    Text {
                                        text: root.video_title != "" ? root.video_title : "Title unknown";
                                        color: #ffffff;
                                        font-size: 16px;
                                        font-weight: 600;
                                    }

                                    Text {
                                        text: root.is_playlist ? ("Series • " + root.playlist_count + " Episodes Available") :
                                              ("Resolution: " + root.video_resolution + "  •  Duration: " + root.video_duration);
                                        color: #949db2;
                                        font-size: 13px;
                                    }
                                }
                            }

                            // Format & Quality Selection Chips
                            Text {
                                text: root.is_playlist ? "Select Quality for All Episodes:" : "Select Format & Quality:";
                                color: #c7cbd9;
                                font-size: 12px;
                                font-weight: 600;
                            }

                            HorizontalLayout {
                                spacing: 8px;

                                QualityChip {
                                    text: "📹 Best Quality";
                                    selected: root.selected_format_index == 0;
                                    clicked => { root.selected_format_index = 0; }
                                }
                                QualityChip {
                                    text: "📹 1080p FHD";
                                    selected: root.selected_format_index == 1;
                                    clicked => { root.selected_format_index = 1; }
                                }
                                QualityChip {
                                    text: "📹 720p HD";
                                    selected: root.selected_format_index == 2;
                                    clicked => { root.selected_format_index = 2; }
                                }
                                QualityChip {
                                    text: "📹 480p SD";
                                    selected: root.selected_format_index == 3;
                                    clicked => { root.selected_format_index = 3; }
                                }
                                QualityChip {
                                    text: "🎵 Audio (MP3)";
                                    selected: root.selected_format_index == 4;
                                    clicked => { root.selected_format_index = 4; }
                                }
                            }

                            // Subtitle extraction & embedding option
                            HorizontalLayout {
                                spacing: 10px;
                                alignment: space-between;

                                Rectangle {
                                    background: root.download_subtitles ? #1e3a5f : #171a26;
                                    border-radius: 8px;
                                    border-width: 1px;
                                    border-color: root.download_subtitles ? #38bdf8 : #2b3044;
                                    height: 32px;

                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        spacing: 6px;
                                        alignment: center;

                                        Text {
                                            text: root.download_subtitles ? "💬 Subtitles: Enabled (.srt/embed)" : "💬 Subtitles: Disabled";
                                            color: root.download_subtitles ? #38bdf8 : #8c93a8;
                                            font-size: 12px;
                                            font-weight: 600;
                                            vertical-alignment: center;
                                        }
                                    }

                                    TouchArea {
                                        clicked => { root.download_subtitles = !root.download_subtitles; }
                                    }
                                }

                                if root.has_subtitles: VerticalLayout {
                                    alignment: center;
                                    Text {
                                        text: "Detected: " + root.subtitles_summary;
                                        color: #64748b;
                                        font-size: 11px;
                                        overflow: elide;
                                    }
                                }
                            }

                            HorizontalLayout {
                                alignment: end;
                                spacing: 10px;

                                Button {
                                    text: root.is_playlist ? ("📥 Download All " + root.playlist_count + " Episodes") : "Start Download";
                                    height: 36px;
                                    clicked => {
                                        root.start_download(root.selected_format_index, root.download_subtitles);
                                    }
                                }
                            }
                        }
                    }

                    // Empty / Placeholder state when no video analyzed
                    if !root.has_metadata && !root.is_analyzing: Rectangle {
                        background: #181a24;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: #232736;
                        height: 160px;

                        VerticalLayout {
                            alignment: center;
                            spacing: 8px;

                            Text {
                                text: "🚀 Ready to analyze media";
                                color: #5c647a;
                                font-size: 15px;
                                font-weight: 600;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: "Paste a video link above and click Analyze to choose quality or audio-only extraction";
                                color: #4b5266;
                                font-size: 13px;
                                horizontal-alignment: center;
                            }
                        }
                    }
                }

                // --- BATCH URLS MODE ---
                if root.batch_mode: VerticalLayout {
                    spacing: 16px;

                    Rectangle {
                        background: #1c202d;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: #2b3044;

                        VerticalLayout {
                            padding: 20px;
                            spacing: 14px;

                            HorizontalLayout {
                                alignment: space-between;
                                Text {
                                    text: "Batch Download Queue (one link per line)";
                                    color: #c7cbd9;
                                    font-size: 14px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                                Button {
                                    text: "📋 Paste Clipboard";
                                    height: 30px;
                                    clicked => {
                                        root.paste_batch_from_clipboard();
                                    }
                                }
                            }

                            batch_input := TextEdit {
                                text <=> root.batch_urls_text;
                                font-size: 13px;
                                height: 140px;
                            }

                            Text {
                                text: "Select Default Format for Batch:";
                                color: #c7cbd9;
                                font-size: 12px;
                                font-weight: 600;
                            }

                            HorizontalLayout {
                                spacing: 8px;

                                QualityChip {
                                    text: "📹 Best Quality";
                                    selected: root.selected_format_index == 0;
                                    clicked => { root.selected_format_index = 0; }
                                }
                                QualityChip {
                                    text: "📹 720p HD";
                                    selected: root.selected_format_index == 2;
                                    clicked => { root.selected_format_index = 2; }
                                }
                                QualityChip {
                                    text: "🎵 Audio (MP3)";
                                    selected: root.selected_format_index == 4;
                                    clicked => { root.selected_format_index = 4; }
                                }
                            }

                            HorizontalLayout {
                                alignment: end;
                                spacing: 10px;

                                Button {
                                    text: "📥 Queue All in Batch";
                                    height: 38px;
                                    clicked => {
                                        root.start_batch_download(root.batch_urls_text, root.selected_format_index);
                                    }
                                }
                            }
                        }
                    }
                }

                // Spacer
                Rectangle { }
            }

            // Tab 1: Downloads
            if root.active_tab == 1: VerticalLayout {
                spacing: 14px;

                // Queue Toolbar
                HorizontalLayout {
                    alignment: space-between;

                    Text {
                        text: "Queue (" + root.total_queue_count + " jobs)";
                        color: #a0a7ba;
                        font-size: 13px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }

                    HorizontalLayout {
                        spacing: 8px;

                        Button {
                            text: "⏸ Pause All";
                            height: 32px;
                            clicked => { root.pause_all(); }
                        }

                        Button {
                            text: "▶ Resume All";
                            height: 32px;
                            clicked => { root.resume_all(); }
                        }

                        Button {
                            text: "🧹 Clear Finished";
                            height: 32px;
                            clicked => { root.clear_completed(); }
                        }
                    }
                }

                // Search & Filter Toolbar
                HorizontalLayout {
                    spacing: 12px;

                    queue_search := LineEdit {
                        placeholder_text: "🔍 Search active or queued downloads by title or URL...";
                        font_size: 13px;
                        height: 36px;
                        horizontal-stretch: 1;
                        edited => {
                            root.queue_search_query = self.text;
                            root.search_queue(self.text);
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    QualityChip {
                        text: "All";
                        selected: root.queue_filter_index == 0;
                        clicked => {
                            root.queue_filter_index = 0;
                            root.set_queue_filter(0);
                        }
                    }
                    QualityChip {
                        text: "⬇️ Downloading";
                        selected: root.queue_filter_index == 1;
                        clicked => {
                            root.queue_filter_index = 1;
                            root.set_queue_filter(1);
                        }
                    }
                    QualityChip {
                        text: "⏳ Queued";
                        selected: root.queue_filter_index == 2;
                        clicked => {
                            root.queue_filter_index = 2;
                            root.set_queue_filter(2);
                        }
                    }
                    QualityChip {
                        text: "⏸ Paused";
                        selected: root.queue_filter_index == 3;
                        clicked => {
                            root.queue_filter_index = 3;
                            root.set_queue_filter(3);
                        }
                    }
                    QualityChip {
                        text: "✅ Completed";
                        selected: root.queue_filter_index == 4;
                        clicked => {
                            root.queue_filter_index = 4;
                            root.set_queue_filter(4);
                        }
                    }
                    QualityChip {
                        text: "❌ Failed";
                        selected: root.queue_filter_index == 5;
                        clicked => {
                            root.queue_filter_index = 5;
                            root.set_queue_filter(5);
                        }
                    }
                }

                // If no downloads in current view
                if root.download_items.length == 0: Rectangle {
                    background: #1c202d;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: #2b3044;
                    height: 200px;

                    VerticalLayout {
                        alignment: center;
                        spacing: 8px;

                        Text {
                            text: (root.queue_filter_index != 0 || root.queue_search_query != "") ? "🔍 No matching downloads found" : "📥 No active downloads";
                            color: #5c647a;
                            font-size: 15px;
                            font-weight: 600;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: (root.queue_filter_index != 0 || root.queue_search_query != "") ? "Try selecting 'All' or clearing your search query above." : "Downloads in progress, paused, or queued will appear here.";
                            color: #4b5266;
                            font-size: 13px;
                            horizontal-alignment: center;
                        }
                    }
                }

                // If downloads exist in queue
                if root.download_items.length > 0: ScrollView {
                    VerticalLayout {
                        spacing: 12px;

                        for item in root.download_items: Rectangle {
                            background: #1c202d;
                            border-radius: 12px;
                            border-width: 1px;
                            border-color: #2b3044;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 12px;

                                HorizontalLayout {
                                    alignment: space-between;

                                    VerticalLayout {
                                        spacing: 4px;
                                        Text {
                                            text: item.title;
                                            color: #ffffff;
                                            font-size: 15px;
                                            font-weight: 600;
                                        }
                                        Text {
                                            text: "Status: " + item.status;
                                            color: item.status == "Completed" ? #4ade80 :
                                                   item.status == "Paused" ? #facc15 :
                                                   item.status == "Downloading" ? #60a5fa :
                                                   item.status == "Queued" ? #c084fc : #f87171;
                                            font-size: 12px;
                                            font-weight: 600;
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 6px;
                                        alignment: end;

                                        if item.is_completed: Button {
                                            text: "▶ Play";
                                            height: 30px;
                                            clicked => { root.open_download_file(item.output_path); }
                                        }

                                        if item.is_completed: Button {
                                            text: "📂 Finder";
                                            height: 30px;
                                            clicked => { root.open_download_folder(item.output_path); }
                                        }

                                        if item.can_pause: Button {
                                            text: "Pause";
                                            height: 30px;
                                            clicked => { root.pause_download(item.id); }
                                        }

                                        if item.can_resume: Button {
                                            text: "Resume";
                                            height: 30px;
                                            clicked => { root.resume_download(item.id); }
                                        }

                                        if item.can_cancel: Button {
                                            text: "Cancel";
                                            height: 30px;
                                            clicked => { root.cancel_download(item.id); }
                                        }
                                    }
                                }

                                ProgressIndicator {
                                    progress: item.progress;
                                    height: 7px;
                                }

                                HorizontalLayout {
                                    alignment: space-between;

                                    Text {
                                        text: item.size_text;
                                        color: #949db2;
                                        font-size: 12px;
                                    }

                                    Text {
                                        text: "Speed: " + item.speed_text + "  •  ETA: " + item.eta_text;
                                        color: #949db2;
                                        font-size: 12px;
                                    }
                                }
                            }
                        }
                    }
                }

                Rectangle { }
            }

            // Tab 2: History
            if root.active_tab == 2: VerticalLayout {
                spacing: 14px;

                // Search and toolbar
                HorizontalLayout {
                    alignment: space-between;
                    spacing: 12px;

                    search_box := LineEdit {
                        placeholder_text: "🔍 Search history by title or URL...";
                        font_size: 14px;
                        height: 36px;
                        edited => { root.search_history(self.text); }
                    }

                    Button {
                        text: "🗑️ Clear All";
                        height: 36px;
                        clicked => { root.clear_all_history(); }
                    }
                }

                // If no history items
                if root.history_items.length == 0: Rectangle {
                    background: #1c202d;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: #2b3044;
                    height: 220px;

                    VerticalLayout {
                        alignment: center;
                        spacing: 8px;

                        Text {
                            text: "📜 No history records found";
                            color: #5c647a;
                            font-size: 15px;
                            font-weight: 600;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: "Finished and saved media downloads will be persisted here.";
                            color: #4b5266;
                            font-size: 13px;
                            horizontal-alignment: center;
                        }
                    }
                }

                // If history items exist
                if root.history_items.length > 0: ScrollView {
                    VerticalLayout {
                        spacing: 10px;

                        for item in root.history_items: Rectangle {
                            background: #1c202d;
                            border-radius: 12px;
                            border-width: 1px;
                            border-color: #2b3044;

                            VerticalLayout {
                                padding: 14px;
                                spacing: 8px;

                                HorizontalLayout {
                                    alignment: space-between;

                                    VerticalLayout {
                                        spacing: 4px;

                                        Text {
                                            text: item.title;
                                            color: #ffffff;
                                            font-size: 15px;
                                            font-weight: 600;
                                        }

                                        HorizontalLayout {
                                            spacing: 12px;

                                            Text {
                                                text: "Status: " + item.status;
                                                color: item.status == "Completed" ? #4ade80 :
                                                       item.status == "Cancelled" ? #a0a7ba : #ef4444;
                                                font-size: 12px;
                                                font-weight: 600;
                                            }

                                            Text {
                                                text: "Size: " + item.size_text;
                                                color: #8c93a8;
                                                font-size: 12px;
                                            }

                                            Text {
                                                text: "Path: " + item.output_path;
                                                color: #636b80;
                                                font-size: 11px;
                                            }
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 8px;
                                        alignment: end;

                                        if item.status == "Completed": Button {
                                            text: "▶ Play";
                                            height: 30px;
                                            clicked => { root.play_history_file(item.output_path); }
                                        }

                                        Button {
                                            text: "📂 Finder";
                                            height: 30px;
                                            clicked => { root.open_history_folder(item.output_path); }
                                        }

                                        Button {
                                            text: "🔄 Redownload";
                                            height: 30px;
                                            clicked => { root.redownload_history(item.url); }
                                        }

                                        Button {
                                            text: "✕";
                                            height: 30px;
                                            clicked => { root.delete_history_item(item.id); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                Rectangle { }
            }

            // Tab 3: Logs View
            if root.active_tab == 3: VerticalLayout {
                spacing: 14px;

                // Toolbar
                HorizontalLayout {
                    alignment: space-between;

                    Text {
                        text: "Engine & Diagnostic Logs (" + root.log_entries.length + " entries)";
                        color: #a0a7ba;
                        font-size: 13px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }

                    Button {
                        text: "🧹 Clear Logs";
                        height: 32px;
                        clicked => { root.clear_logs(); }
                    }
                }

                // If no logs recorded
                if root.log_entries.length == 0: Rectangle {
                    background: #1c202d;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: #2b3044;
                    height: 220px;

                    VerticalLayout {
                        alignment: center;
                        spacing: 8px;

                        Text {
                            text: "📋 No logs recorded yet";
                            color: #5c647a;
                            font-size: 15px;
                            font-weight: 600;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: "Engine operations, inspections, stream events, and errors will stream here live.";
                            color: #4b5266;
                            font-size: 13px;
                            horizontal-alignment: center;
                        }
                    }
                }

                // If logs exist
                if root.log_entries.length > 0: ScrollView {
                    VerticalLayout {
                        spacing: 6px;

                        for entry in root.log_entries: Rectangle {
                            background: #181b26;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: entry.level == "ERROR" ? #7f1d1d :
                                           entry.level == "WARN" ? #78350f : #232736;

                            HorizontalLayout {
                                padding: 8px;
                                spacing: 10px;

                                Text {
                                    text: entry.timestamp;
                                    color: #6c738a;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                }

                                Rectangle {
                                    width: 52px;
                                    height: 20px;
                                    border-radius: 4px;
                                    background: entry.level == "ERROR" ? #ef4444 :
                                                entry.level == "WARN" ? #f59e0b : #3b82f6;

                                    Text {
                                        text: entry.level;
                                        color: #ffffff;
                                        font-size: 10px;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                Text {
                                    text: entry.message;
                                    color: entry.level == "ERROR" ? #fca5a5 :
                                           entry.level == "WARN" ? #fde68a : #cbd5e1;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                }

                Rectangle { }
            }

            // Tab 4: Settings
            if root.active_tab == 4: VerticalLayout {
                spacing: 16px;

                // Download Directory Card
                Rectangle {
                    background: #1c202d;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: #2b3044;

                    VerticalLayout {
                        padding: 20px;
                        spacing: 14px;

                        VerticalLayout {
                            spacing: 4px;
                            Text {
                                text: "📁 Default Download Directory";
                                color: #ffffff;
                                font-size: 16px;
                                font-weight: 700;
                            }
                            Text {
                                text: "All media, video series, and audio extractions will be saved into this folder";
                                color: #8c93a8;
                                font-size: 13px;
                            }
                        }

                        HorizontalLayout {
                            spacing: 10px;

                            Rectangle {
                                background: #131622;
                                border-radius: 8px;
                                border-width: 1px;
                                border-color: #2b3044;
                                horizontal-stretch: 1;
                                height: 38px;

                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    alignment: start;

                                    Text {
                                        text: root.download_dir_path;
                                        color: #e2e8f0;
                                        font-size: 13px;
                                        font-weight: 500;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                            }

                            Button {
                                text: "📂 Browse...";
                                height: 38px;
                                clicked => { root.browse_download_dir(); }
                            }

                            Button {
                                text: "Finder";
                                height: 38px;
                                clicked => { root.open_current_download_dir(); }
                            }

                            Button {
                                text: "Reset";
                                height: 38px;
                                clicked => { root.reset_download_dir(); }
                            }
                        }
                    }
                }

                // Bandwidth Speed Limiter Card
                Rectangle {
                    background: #1c202d;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: #2b3044;

                    VerticalLayout {
                        padding: 20px;
                        spacing: 14px;

                        VerticalLayout {
                            spacing: 4px;
                            Text {
                                text: "🚀 Bandwidth Speed Limiter";
                                color: #ffffff;
                                font-size: 16px;
                                font-weight: 700;
                            }
                            Text {
                                text: "Throttle max download rate to prevent saturating your internet connection";
                                color: #8c93a8;
                                font-size: 13px;
                            }
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;

                            QualityChip {
                                text: "🚀 No Limit";
                                selected: root.selected_speed_limit_index == 0;
                                clicked => {
                                    root.selected_speed_limit_index = 0;
                                    root.set_speed_limit(0);
                                }
                            }
                            QualityChip {
                                text: "⚡ 2 MB/s";
                                selected: root.selected_speed_limit_index == 1;
                                clicked => {
                                    root.selected_speed_limit_index = 1;
                                    root.set_speed_limit(1);
                                }
                            }
                            QualityChip {
                                text: "⚡ 5 MB/s";
                                selected: root.selected_speed_limit_index == 2;
                                clicked => {
                                    root.selected_speed_limit_index = 2;
                                    root.set_speed_limit(2);
                                }
                            }
                            QualityChip {
                                text: "⚡ 10 MB/s";
                                selected: root.selected_speed_limit_index == 3;
                                clicked => {
                                    root.selected_speed_limit_index = 3;
                                    root.set_speed_limit(3);
                                }
                            }
                            QualityChip {
                                text: "⚡ 20 MB/s";
                                selected: root.selected_speed_limit_index == 4;
                                clicked => {
                                    root.selected_speed_limit_index = 4;
                                    root.set_speed_limit(4);
                                }
                            }
                        }
                    }
                }

                // Concurrent Download Workers Card
                Rectangle {
                    background: #1c202d;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: #2b3044;

                    VerticalLayout {
                        padding: 20px;
                        spacing: 14px;

                        VerticalLayout {
                            spacing: 4px;
                            Text {
                                text: "⚡ Concurrent Download Workers";
                                color: #ffffff;
                                font-size: 16px;
                                font-weight: 700;
                            }
                            Text {
                                text: "Maximum number of simultaneous downloads processed in parallel";
                                color: #8c93a8;
                                font-size: 13px;
                            }
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;

                            QualityChip {
                                text: "1 (Sequential)";
                                selected: root.selected_concurrency == 1;
                                clicked => {
                                    root.selected_concurrency = 1;
                                    root.set_max_concurrency(1);
                                }
                            }
                            QualityChip {
                                text: "2 Parallel";
                                selected: root.selected_concurrency == 2;
                                clicked => {
                                    root.selected_concurrency = 2;
                                    root.set_max_concurrency(2);
                                }
                            }
                            QualityChip {
                                text: "3 Parallel (Default)";
                                selected: root.selected_concurrency == 3;
                                clicked => {
                                    root.selected_concurrency = 3;
                                    root.set_max_concurrency(3);
                                }
                            }
                            QualityChip {
                                text: "5 Parallel (Fast)";
                                selected: root.selected_concurrency == 5;
                                clicked => {
                                    root.selected_concurrency = 5;
                                    root.set_max_concurrency(5);
                                }
                            }
                        }
                    }
                }

                // Engine & Queue Defaults Card
                Rectangle {
                    background: #1c202d;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: #2b3044;

                    VerticalLayout {
                        padding: 20px;
                        spacing: 14px;

                        Text {
                            text: "⚡ Engine & Network Architecture";
                            color: #ffffff;
                            font-size: 16px;
                            font-weight: 700;
                        }

                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: "Concurrent Download Workers";
                                color: #cbd5e1;
                                font-size: 13px;
                            }
                            Text {
                                text: root.selected_concurrency + " Parallel Jobs (Auto-Queued)";
                                color: #38bdf8;
                                font-size: 13px;
                                font-weight: 600;
                            }
                        }

                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: "Auto-Retry Maximum Attempts";
                                color: #cbd5e1;
                                font-size: 13px;
                            }
                            Text {
                                text: "3 Retries with Exponential Backoff";
                                color: #38bdf8;
                                font-size: 13px;
                                font-weight: 600;
                            }
                        }

                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: "Crash Recovery & Chunk Resumption";
                                color: #cbd5e1;
                                font-size: 13px;
                            }
                            Text {
                                text: "HTTP Range + .part Atomic Resume";
                                color: #4ade80;
                                font-size: 13px;
                                font-weight: 600;
                            }
                        }

                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: "Media Multiplexer Backend";
                                color: #cbd5e1;
                                font-size: 13px;
                            }
                            Text {
                                text: "FFmpeg v9 + yt-dlp Native";
                                color: #a78bfa;
                                font-size: 13px;
                                font-weight: 600;
                            }
                        }

                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: "Desktop System Notifications";
                                color: #cbd5e1;
                                font-size: 13px;
                                vertical-alignment: center;
                            }
                            Button {
                                text: "🔔 Test Notification";
                                height: 30px;
                                clicked => { root.test_notification(); }
                            }
                        }
                    }
                }

                Rectangle { }
            }

            // Status bar at bottom
            Rectangle {
                background: #181a24;
                border-radius: 8px;
                height: 36px;

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    alignment: space-between;

                    Text {
                        text: root.status_message;
                        color: root.has_error ? #f87171 : #79829c;
                        font-size: 12px;
                        vertical-alignment: center;
                    }

                    Text {
                        text: "v0.1.0 • Slint Native";
                        color: #52596e;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
