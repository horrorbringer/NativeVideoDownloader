import { LineEdit, ScrollView } from "std-widgets.slint";
import { ActionButton } from "../components/action_button.slint";
import { IconChip } from "../components/icon_chip.slint";
import { LogEntryData } from "../models.slint";

export component LogsTab inherits VerticalLayout {
    in-out property <[LogEntryData]> log_entries: [];
    in-out property <int> log_filter_index: 0;
    in-out property <string> log_search_query: "";
    in-out property <int> log_total_count: 0;
    in-out property <int> log_info_count: 0;
    in-out property <int> log_warn_count: 0;
    in-out property <int> log_error_count: 0;

    callback set_log_filter(int);
    callback search_logs(string);
    callback copy_logs();
    callback clear_logs();

    spacing: 12px;

    // Toolbar
    HorizontalLayout {
        alignment: space-between;
        spacing: 12px;

        // Filter chips: All, Info, Warn, Errors
        HorizontalLayout {
            spacing: 8px;
            alignment: start;

            IconChip {
                text: "All (" + root.log_total_count + ")";
                selected: root.log_filter_index == 0;
                clicked => {
                    root.log_filter_index = 0;
                    root.set_log_filter(0);
                }
            }
            IconChip {
                text: "Info (" + root.log_info_count + ")";
                icon: @image-url("../icons/info.svg");
                has_icon: true;
                selected: root.log_filter_index == 1;
                clicked => {
                    root.log_filter_index = 1;
                    root.set_log_filter(1);
                }
            }
            IconChip {
                text: "Warnings (" + root.log_warn_count + ")";
                icon: @image-url("../icons/alert.svg");
                has_icon: true;
                selected: root.log_filter_index == 2;
                clicked => {
                    root.log_filter_index = 2;
                    root.set_log_filter(2);
                }
            }
            IconChip {
                text: "Errors (" + root.log_error_count + ")";
                icon: @image-url("../icons/x.svg");
                has_icon: true;
                selected: root.log_filter_index == 3;
                clicked => {
                    root.log_filter_index = 3;
                    root.set_log_filter(3);
                }
            }
        }

        // Search & Action Buttons
        HorizontalLayout {
            spacing: 8px;
            alignment: end;

            log_search := LineEdit {
                width: 170px;
                height: 32px;
                placeholder_text: "Filter logs...";
                text <=> root.log_search_query;
                edited(query) => {
                    root.search_logs(query);
                }
            }

            ActionButton {
                text: "Copy";
                icon: @image-url("../icons/clipboard.svg");
                has_icon: true;
                height: 32px;
                enabled: root.log_total_count > 0;
                clicked => { root.copy_logs(); }
            }

            ActionButton {
                text: "Clear";
                icon: @image-url("../icons/trash.svg");
                has_icon: true;
                height: 32px;
                enabled: root.log_total_count > 0;
                clicked => { root.clear_logs(); }
            }
        }
    }

    // If no logs match filter/query
    if root.log_entries.length == 0: Rectangle {
        background: #141724;
        border-radius: 12px;
        border-width: 1px;
        border-color: #22283a;
        vertical-stretch: 1;

        VerticalLayout {
            alignment: center;
            spacing: 14px;

            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 48px;
                    height: 48px;
                    border-radius: 24px;
                    background: #1d2234;
                    border-width: 1px;
                    border-color: #2b334d;

                    Image {
                        source: (root.log_filter_index != 0 || root.log_search_query != "") ? @image-url("../icons/search.svg") : @image-url("../icons/logs.svg");
                        width: 22px;
                        height: 22px;
                        colorize: #7082ff;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }
            }

            VerticalLayout {
                spacing: 5px;
                Text {
                    text: (root.log_filter_index != 0 || root.log_search_query != "") ? "No matching logs found" : "No logs recorded yet";
                    color: #ffffff;
                    font-size: 15px;
                    font-weight: 700;
                    horizontal-alignment: center;
                }
                Text {
                    text: (root.log_filter_index != 0 || root.log_search_query != "") ? "Try selecting 'All' or clearing your search filter above." : "Engine operations, inspections, stream events, and diagnostics will stream here live.";
                    color: #8c93a8;
                    font-size: 13px;
                    horizontal-alignment: center;
                }
            }
        }
    }

    // Unified Developer Terminal Log Console Card
    if root.log_entries.length > 0: Rectangle {
        background: #0b0e17;
        border-radius: 10px;
        border-width: 1px;
        border-color: #1e2436;
        vertical-stretch: 1;
        clip: true;

        VerticalLayout {
            // Console Title Bar
            Rectangle {
                background: #111522;
                height: 32px;

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    alignment: space-between;

                    // macOS Terminal Dots
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: center;

                        Rectangle {
                            width: 9px;
                            height: 9px;
                            border-radius: 5px;
                            background: #ef4444;
                        }
                        Rectangle {
                            width: 9px;
                            height: 9px;
                            border-radius: 5px;
                            background: #f59e0b;
                        }
                        Rectangle {
                            width: 9px;
                            height: 9px;
                            border-radius: 5px;
                            background: #10b981;
                        }

                        Rectangle { width: 4px; }

                        Text {
                            text: "Console Stream • Real-time Engine Diagnostics";
                            color: #64748b;
                            font-size: 11px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }

                    Text {
                        text: root.log_entries.length + " events";
                        color: #64748b;
                        font-size: 11px;
                        font-weight: 500;
                        vertical-alignment: center;
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: #1a2030;
            }

            // Console Stream Area
            ScrollView {
                vertical-stretch: 1;

                VerticalLayout {
                    padding: 8px;
                    spacing: 2px;

                    for entry in root.log_entries: Rectangle {
                        background: touch.has-hover ? #171c2b : (
                            entry.level == "ERROR" ? #221217 :
                            entry.level == "WARN" ? #211a10 :
                            transparent
                        );
                        border-radius: 4px;
                        animate background { duration: 100ms; }

                        touch := TouchArea { }

                        HorizontalLayout {
                            padding-top: 5px;
                            padding-bottom: 5px;
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 10px;
                            alignment: start;

                            // Fixed-width timestamp
                            Text {
                                text: entry.timestamp;
                                color: #5a6480;
                                font-size: 11px;
                                width: 72px;
                                vertical-alignment: top;
                            }

                            // Level badge (pill style)
                            Rectangle {
                                width: 48px;
                                height: 18px;
                                border-radius: 3px;
                                border-width: 1px;
                                background: entry.level == "ERROR" ? #371216 :
                                            entry.level == "WARN" ? #351e08 : #172554;
                                border-color: entry.level == "ERROR" ? #b91c1c :
                                              entry.level == "WARN" ? #b45309 : #1d4ed8;

                                Text {
                                    text: entry.level;
                                    color: entry.level == "ERROR" ? #fca5a5 :
                                           entry.level == "WARN" ? #fcd34d : #93c5fd;
                                    font-size: 10px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            // Message
                            Text {
                                text: entry.message;
                                color: entry.level == "ERROR" ? #fca5a5 :
                                       entry.level == "WARN" ? #fde68a : #cbd5e1;
                                font-size: 12px;
                                horizontal-stretch: 1;
                                wrap: word-wrap;
                                vertical-alignment: top;
                            }
                        }
                    }
                }
            }
        }
    }
}
