import { LineEdit, ScrollView } from "std-widgets.slint";
import { ActionButton } from "../components/action_button.slint";
import { HistoryItemData } from "../models.slint";
import { Theme } from "../theme.slint";

export component HistoryTab inherits VerticalLayout {
    in-out property <[HistoryItemData]> history_items: [];
    in-out property <string> history_search_query: "";

    callback search_history(string);
    callback clear_all_history();
    callback export_history();
    callback play_history_file(string);
    callback open_history_folder(string);
    callback redownload_history(string);
    callback delete_history_item(string);

    spacing: 12px;

    // Search and toolbar
    HorizontalLayout {
        spacing: 12px;
        alignment: space-between;

        search_box := LineEdit {
            horizontal-stretch: 1;
            placeholder_text: "Search history by title or file path...";
            font_size: 13px;
            height: 36px;
            text <=> root.history_search_query;
            edited => { root.search_history(self.text); }
        }

        Rectangle {
            background: Theme.sidebar_status_bg;
            border-radius: 7px;
            border-width: 1px;
            border-color: Theme.sidebar_status_border;
            height: 36px;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                alignment: center;
                Text {
                    text: root.history_items.length + " Records";
                    color: Theme.text_secondary;
                    font-size: 12px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }
        }

        ActionButton {
            text: "Export CSV";
            icon: @image-url("../icons/download.svg");
            has_icon: true;
            height: 36px;
            enabled: root.history_items.length > 0;
            clicked => { root.export_history(); }
        }

        ActionButton {
            text: "Clear All";
            icon: @image-url("../icons/trash.svg");
            has_icon: true;
            danger: true;
            height: 36px;
            enabled: root.history_items.length > 0;
            clicked => { root.clear_all_history(); }
        }
    }

    // If no history items
    if root.history_items.length == 0: Rectangle {
        background: Theme.card_bg;
        border-radius: 12px;
        border-width: 1px;
        border-color: Theme.card_border;
        vertical-stretch: 1;

        VerticalLayout {
            alignment: center;
            spacing: 14px;

            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 48px;
                    height: 48px;
                    border-radius: 24px;
                    background: Theme.sidebar_brand_bg;
                    border-width: 1px;
                    border-color: Theme.sidebar_brand_border;

                    Image {
                        source: root.history_search_query != "" ? @image-url("../icons/search.svg") : @image-url("../icons/history.svg");
                        width: 22px;
                        height: 22px;
                        colorize: Theme.brand_purple;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }
            }

            VerticalLayout {
                spacing: 5px;
                Text {
                    text: root.history_search_query != "" ? "No history records match your search" : "No download history yet";
                    color: Theme.text_primary;
                    font-size: 15px;
                    font-weight: 700;
                    horizontal-alignment: center;
                }
                Text {
                    text: root.history_search_query != "" ? "Try a different keyword or clear the search box above." : "Finished and saved media downloads will be persisted here.";
                    color: Theme.text_secondary;
                    font-size: 13px;
                    horizontal-alignment: center;
                }
            }
        }
    }

    // If history items exist
    if root.history_items.length > 0: ScrollView {
        vertical-stretch: 1;

        VerticalLayout {
            spacing: 10px;
            padding-bottom: 8px;

            for item in root.history_items: Rectangle {
                background: touch.has-hover ? Theme.card_hover : Theme.card_bg;
                border-radius: 12px;
                border-width: 1px;
                border-color: touch.has-hover ? Theme.primary_border : Theme.card_border;
                animate background { duration: 150ms; }
                animate border-color { duration: 150ms; }

                touch := TouchArea { }

                VerticalLayout {
                    padding: 14px;
                    spacing: 10px;

                    // Row 1: Title & Action Buttons
                    HorizontalLayout {
                        alignment: space-between;
                        spacing: 12px;

                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 6px;

                            Text {
                                text: item.title;
                                color: Theme.text_primary;
                                font-size: 15px;
                                font-weight: 700;
                                overflow: elide;
                            }

                            HorizontalLayout {
                                spacing: 10px;
                                alignment: start;

                                // Status pill
                                Rectangle {
                                    height: 22px;
                                    border-radius: 4px;
                                    border-width: 1px;
                                    background: item.status == "Completed" ? (Theme.is_dark ? #0e291b : #dcfce7) :
                                                (item.status == "Failed" ? (Theme.is_dark ? #331317 : #fee2e2) : Theme.inner_bg);
                                    border-color: item.status == "Completed" ? (Theme.is_dark ? #166534 : #86efac) :
                                                  (item.status == "Failed" ? (Theme.is_dark ? #991b1b : #fca5a5) : Theme.inner_border);

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 5px;
                                        alignment: center;

                                        VerticalLayout {
                                            alignment: center;
                                            Image {
                                                source: item.status == "Completed" ? @image-url("../icons/check.svg") : @image-url("../icons/x.svg");
                                                width: 11px;
                                                height: 11px;
                                                colorize: item.status == "Completed" ? (Theme.is_dark ? #4ade80 : #15803d) : (Theme.is_dark ? #f87171 : #b91c1c);
                                            }
                                        }

                                        Text {
                                            text: item.status == "Completed" ? "Completed" : item.status;
                                            color: item.status == "Completed" ? (Theme.is_dark ? #4ade80 : #15803d) :
                                                   (item.status == "Failed" ? (Theme.is_dark ? #f87171 : #b91c1c) : Theme.text_secondary);
                                            font-size: 11px;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                // File size
                                HorizontalLayout {
                                    spacing: 4px;
                                    alignment: start;

                                    VerticalLayout {
                                        alignment: center;
                                        Image {
                                            source: @image-url("../icons/package.svg");
                                            width: 13px;
                                            height: 13px;
                                            colorize: Theme.text_secondary;
                                        }
                                    }

                                    Text {
                                        text: item.size_text;
                                        color: Theme.text_secondary;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                    }
                                }

                                // Date / Timestamp
                                if item.date_text != "": HorizontalLayout {
                                    spacing: 4px;
                                    alignment: start;

                                    VerticalLayout {
                                        alignment: center;
                                        Image {
                                            source: @image-url("../icons/history.svg");
                                            width: 13px;
                                            height: 13px;
                                            colorize: Theme.text_muted;
                                        }
                                    }

                                    Text {
                                        text: item.date_text;
                                        color: Theme.text_muted;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        // Action buttons
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: end;

                            if item.status == "Completed": ActionButton {
                                text: "Play";
                                icon: @image-url("../icons/play.svg");
                                has_icon: true;
                                height: 32px;
                                clicked => { root.play_history_file(item.output_path); }
                            }

                            ActionButton {
                                text: "Finder";
                                icon: @image-url("../icons/folder.svg");
                                has_icon: true;
                                height: 32px;
                                clicked => { root.open_history_folder(item.output_path); }
                            }

                            ActionButton {
                                text: "Redownload";
                                icon: @image-url("../icons/refresh.svg");
                                has_icon: true;
                                height: 32px;
                                clicked => { root.redownload_history(item.url); }
                            }

                            ActionButton {
                                icon: @image-url("../icons/x.svg");
                                has_icon: true;
                                danger: true;
                                height: 32px;
                                clicked => { root.delete_history_item(item.id); }
                            }
                        }
                    }

                    // Row 2: Recessed File Path Bezel
                    Rectangle {
                        background: Theme.inner_bg;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: Theme.inner_border;
                        height: 28px;

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            alignment: start;
                            spacing: 6px;

                            VerticalLayout {
                                alignment: center;
                                Image {
                                    source: @image-url("../icons/folder.svg");
                                    width: 12px;
                                    height: 12px;
                                    colorize: Theme.text_muted;
                                }
                            }

                            Text {
                                text: item.output_path;
                                color: Theme.text_muted;
                                font-size: 11px;
                                overflow: elide;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }
    }
}
