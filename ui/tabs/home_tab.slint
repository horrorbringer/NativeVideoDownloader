import { LineEdit, ProgressIndicator, ScrollView, TextEdit } from "std-widgets.slint";
import { ActionButton } from "../components/action_button.slint";
import { IconChip } from "../components/icon_chip.slint";
import { EpisodeItemData } from "../models.slint";
import { Theme } from "../theme.slint";

export component HomeTab inherits ScrollView {
    in-out property <bool> has_error: false;
    in-out property <string> error_message: "";
    in-out property <bool> batch_mode: false;
    in-out property <string> input_url_text: "";
    in-out property <string> batch_urls_text: "";
    in-out property <bool> is_analyzing: false;
    in-out property <bool> has_metadata: false;
    in-out property <string> video_title: "";
    in-out property <string> video_duration: "";
    in-out property <string> video_resolution: "";
    in-out property <bool> is_playlist: false;
    in-out property <int> playlist_count: 0;
    in-out property <[EpisodeItemData]> playlist_episodes: [];
    in-out property <int> selected_episodes_count: 0;
    in-out property <string> episode_range_input: "";
    in-out property <bool> episodes_expanded: false;
    in-out property <int> selected_format_index: 0;
    in-out property <bool> has_subtitles: false;
    in-out property <string> subtitles_summary: "";
    in-out property <bool> download_subtitles: true;
    in-out property <bool> download_thumbnail: true;
    in-out property <bool> has_thumbnail: false;
    in-out property <image> thumbnail_image;

    // Detailed metadata properties
    in-out property <string> video_size_text: "";
    in-out property <string> video_fps_text: "";
    in-out property <string> video_codecs_text: "";
    in-out property <string> format_best_label: "Best Quality";
    in-out property <string> format_1080_label: "1080p FHD";
    in-out property <string> format_720_label: "720p HD";
    in-out property <string> format_480_label: "480p SD";
    in-out property <string> format_audio_label: "Extract Audio";

    // Dedicated Audio Extractor options
    in-out property <int> selected_audio_format_index: 0;
    in-out property <int> selected_audio_bitrate_index: 0;
    in-out property <bool> embed_audio_metadata: true;

    // Live Clipboard Link Monitor properties
    in-out property <bool> clipboard_detected_url_visible: false;
    in-out property <string> clipboard_detected_url: "";

    callback analyze_url(string);
    callback clear_analysis();
    callback toggle_episode(int);
    callback select_all_episodes(bool);
    callback apply_episode_range(string);
    callback paste_from_clipboard();
    callback paste_batch_from_clipboard();
    callback import_links_file();
    callback analyze_clipboard_detected();
    callback dismiss_clipboard_detected();
    callback start_download(int, bool, bool, int, int, bool);
    callback start_batch_download(string, int, bool, int, int, bool);
    callback dismiss_error();
    callback open_logs();

    vertical-stretch: 1;

    VerticalLayout {
        alignment: start;
        spacing: 12px;
        padding-bottom: 12px;

        // Error / Alert Banner
        if root.has_error: Rectangle {
            background: Theme.error_bg;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.error_border;

            HorizontalLayout {
                padding: 12px;
                spacing: 12px;
                alignment: space-between;

                HorizontalLayout {
                    horizontal-stretch: 1;
                    spacing: 12px;

                    VerticalLayout {
                        alignment: center;
                        Image {
                            source: @image-url("../icons/alert.svg");
                            width: 20px;
                            height: 20px;
                            colorize: #ef4444;
                        }
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 2px;
                        alignment: center;

                        Text {
                            text: "Analysis / Download Alert";
                            color: Theme.error_text;
                            font-size: 13px;
                            font-weight: 700;
                        }
                        Text {
                            text: root.error_message;
                            color: Theme.error_text;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;

                    ActionButton {
                        text: "Logs";
                        icon: @image-url("../icons/logs.svg");
                        has_icon: true;
                        height: 28px;
                        clicked => { root.open_logs(); }
                    }

                    ActionButton {
                        text: "Dismiss";
                        icon: @image-url("../icons/x.svg");
                        has_icon: true;
                        height: 28px;
                        clicked => { root.dismiss_error(); }
                    }
                }
            }
        }

        // Live Clipboard Detected Link Banner
        if root.clipboard_detected_url_visible: Rectangle {
            background: Theme.chip_bg;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.chip_border;

            HorizontalLayout {
                padding: 12px;
                spacing: 12px;
                alignment: space-between;

                HorizontalLayout {
                    horizontal-stretch: 1;
                    spacing: 10px;

                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 28px;
                            height: 28px;
                            border-radius: 14px;
                            background: #1e2942;
                            border-width: 1px;
                            border-color: #3b82f6;

                            Image {
                                source: @image-url("../icons/clipboard.svg");
                                width: 14px;
                                height: 14px;
                                colorize: #60a5fa;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 2px;
                        alignment: center;

                        Text {
                            text: "Copied Media Link Detected";
                            color: #60a5fa;
                            font-size: 13px;
                            font-weight: 700;
                        }

                        Text {
                            text: root.clipboard_detected_url;
                            color: #bfdbfe;
                            font-size: 12px;
                            overflow: elide;
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;

                    ActionButton {
                        text: "Analyze Stream";
                        icon: @image-url("../icons/search.svg");
                        has_icon: true;
                        primary: true;
                        height: 30px;
                        clicked => {
                            root.analyze_clipboard_detected();
                        }
                    }

                    ActionButton {
                        text: "Dismiss";
                        icon: @image-url("../icons/x.svg");
                        has_icon: true;
                        height: 30px;
                        clicked => {
                            root.dismiss_clipboard_detected();
                        }
                    }
                }
            }
        }

        // Mode switcher: Single URL vs Batch URLs & Quick Import
        HorizontalLayout {
            alignment: space-between;

            HorizontalLayout {
                spacing: 8px;
                alignment: start;

                IconChip {
                    text: "Single URL";
                    icon: @image-url("../icons/link.svg");
                    has_icon: true;
                    selected: !root.batch_mode;
                    clicked => { root.batch_mode = false; }
                }

                IconChip {
                    text: "Batch URLs (Bulk)";
                    icon: @image-url("../icons/layers.svg");
                    has_icon: true;
                    selected: root.batch_mode;
                    clicked => { root.batch_mode = true; }
                }
            }

            ActionButton {
                text: "Import File (.txt / .m3u)";
                icon: @image-url("../icons/folder.svg");
                has_icon: true;
                height: 32px;
                clicked => { root.import_links_file(); }
            }
        }

        // --- SINGLE URL MODE ---
        if !root.batch_mode: VerticalLayout {
        alignment: start;
        spacing: 12px;

        // URL Input Card
        Rectangle {
            background: Theme.card_bg;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.card_border;
            height: root.is_analyzing ? 112px : 92px;

            VerticalLayout {
                padding: 12px;
                spacing: 8px;
                alignment: start;

                HorizontalLayout {
                    alignment: space-between;

                    Text {
                        text: "Source Media URL";
                        color: Theme.text_primary;
                        font-size: 13px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }

                    Text {
                        text: "YouTube • Bilibili • Dailymotion • Vimeo • Direct HLS";
                        color: #64748b;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                }

                HorizontalLayout {
                    spacing: 8px;

                    url_input := LineEdit {
                        horizontal-stretch: 1;
                        text <=> root.input_url_text;
                        placeholder_text: "Paste video or audio stream URL here...";
                        font_size: 13px;
                        height: 38px;
                        accepted => {
                            root.analyze_url(self.text);
                        }
                    }

                    if root.input_url_text != "": ActionButton {
                        text: "Clear";
                        icon: @image-url("../icons/x.svg");
                        has_icon: true;
                        height: 38px;
                        clicked => {
                            root.input_url_text = "";
                            root.clear_analysis();
                        }
                    }

                    ActionButton {
                        text: "Paste";
                        icon: @image-url("../icons/clipboard.svg");
                        has_icon: true;
                        height: 38px;
                        clicked => {
                            root.paste_from_clipboard();
                        }
                    }

                    ActionButton {
                        text: root.is_analyzing ? "Analyzing..." : "Analyze";
                        icon: @image-url("../icons/search.svg");
                        has_icon: true;
                        primary: true;
                        enabled: !root.is_analyzing && root.input_url_text != "";
                        height: 38px;
                        clicked => {
                            root.analyze_url(root.input_url_text);
                        }
                    }
                }

                if root.is_analyzing: HorizontalLayout {
                    ProgressIndicator {
                        indeterminate: true;
                        height: 6px;
                    }
                }
            }
        }

        // Video Analysis Result Card (shown when metadata is found)
        if root.has_metadata: Rectangle {
            background: Theme.card_bg;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.card_border;

            VerticalLayout {
                padding: 14px;
                spacing: 12px;

                HorizontalLayout {
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;

                        VerticalLayout {
                            alignment: center;
                            Image {
                                source: @image-url("../icons/check.svg");
                                width: 16px;
                                height: 16px;
                                colorize: #4ade80;
                            }
                        }

                        Text {
                            text: "Media Stream Detected";
                            color: Theme.brand_purple;
                            font-size: 14px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;

                        Rectangle {
                            background: Theme.success_bg;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: Theme.success_border;
                            height: 24px;

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                alignment: center;
                                Text {
                                    text: "Ready to Download";
                                    color: Theme.success_text;
                                    font-size: 11px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        ActionButton {
                            text: "Dismiss";
                            icon: @image-url("../icons/x.svg");
                            has_icon: true;
                            height: 24px;
                            clicked => {
                                root.clear_analysis();
                            }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 16px;

                    // Video preview icon/box
                    Rectangle {
                        width: 154px;
                        height: 96px;
                        background: Theme.inner_bg;
                        border-radius: 9px;
                        border-width: 1px;
                        border-color: Theme.inner_border;
                        clip: true;

                        if root.has_thumbnail: Image {
                            source: root.thumbnail_image;
                            width: 100%;
                            height: 100%;
                            image-fit: cover;
                        }

                        if !root.has_thumbnail: VerticalLayout {
                            alignment: center;
                            spacing: 6px;

                            HorizontalLayout {
                                alignment: center;
                                Image {
                                    source: root.is_playlist ? @image-url("../icons/tv.svg") :
                                            root.selected_format_index == 4 ? @image-url("../icons/music.svg") : @image-url("../icons/video.svg");
                                    width: 26px;
                                    height: 26px;
                                    colorize: Theme.brand_purple;
                                }
                            }

                            Text {
                                text: root.is_playlist ? "Series" :
                                      root.selected_format_index == 4 ? "Audio" : "Video";
                                color: Theme.text_secondary;
                                font-size: 11px;
                                font-weight: 600;
                                horizontal-alignment: center;
                            }
                        }
                    }

                    VerticalLayout {
                        spacing: 8px;
                        alignment: center;
                        horizontal-stretch: 1;

                        Text {
                            text: root.video_title != "" ? root.video_title : "Title unknown";
                            color: Theme.text_primary;
                            font-size: 16px;
                            font-weight: 600;
                            overflow: elide;
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;

                            if root.is_playlist: Rectangle {
                                background: Theme.chip_bg;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: Theme.chip_border;
                                height: 22px;

                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    alignment: center;
                                    Text {
                                        text: "Series • " + root.playlist_count + " Episodes Available";
                                        color: Theme.chip_text;
                                        font-size: 11px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            if !root.is_playlist && root.video_size_text != "": Rectangle {
                                background: Theme.chip_bg;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: Theme.chip_border;
                                height: 22px;

                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    spacing: 4px;
                                    alignment: center;

                                    VerticalLayout {
                                        alignment: center;
                                        width: 12px;
                                        Image {
                                            source: @image-url("../icons/download.svg");
                                            width: 12px;
                                            height: 12px;
                                            colorize: Theme.text_muted;
                                        }
                                    }

                                    Text {
                                        text: root.video_size_text;
                                        color: Theme.chip_text;
                                        font-size: 11px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            if !root.is_playlist && root.video_resolution != "": Rectangle {
                                background: Theme.chip_bg;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: Theme.chip_border;
                                height: 22px;

                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    spacing: 4px;
                                    alignment: center;

                                    VerticalLayout {
                                        alignment: center;
                                        width: 12px;
                                        Image {
                                            source: @image-url("../icons/monitor.svg");
                                            width: 12px;
                                            height: 12px;
                                            colorize: Theme.text_muted;
                                        }
                                    }

                                    Text {
                                        text: root.video_resolution;
                                        color: Theme.chip_text;
                                        font-size: 11px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            if !root.is_playlist && root.video_fps_text != "": Rectangle {
                                background: Theme.chip_bg;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: Theme.chip_border;
                                height: 22px;

                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    spacing: 4px;
                                    alignment: center;

                                    VerticalLayout {
                                        alignment: center;
                                        width: 12px;
                                        Image {
                                            source: @image-url("../icons/bolt.svg");
                                            width: 12px;
                                            height: 12px;
                                            colorize: Theme.text_muted;
                                        }
                                    }

                                    Text {
                                        text: root.video_fps_text;
                                        color: Theme.chip_text;
                                        font-size: 11px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            if !root.is_playlist && root.video_codecs_text != "": Rectangle {
                                background: Theme.chip_bg;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: Theme.chip_border;
                                height: 22px;

                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    spacing: 4px;
                                    alignment: center;

                                    VerticalLayout {
                                        alignment: center;
                                        width: 12px;
                                        Image {
                                            source: @image-url("../icons/video.svg");
                                            width: 12px;
                                            height: 12px;
                                            colorize: Theme.text_muted;
                                        }
                                    }

                                    Text {
                                        text: root.video_codecs_text;
                                        color: Theme.chip_text;
                                        font-size: 11px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            if !root.is_playlist && root.video_duration != "": Rectangle {
                                background: Theme.chip_bg;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: Theme.chip_border;
                                height: 22px;

                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    spacing: 4px;
                                    alignment: center;

                                    VerticalLayout {
                                        alignment: center;
                                        width: 12px;
                                        Image {
                                            source: @image-url("../icons/history.svg");
                                            width: 12px;
                                            height: 12px;
                                            colorize: Theme.text_muted;
                                        }
                                    }

                                    Text {
                                        text: root.video_duration;
                                        color: Theme.chip_text;
                                        font-size: 11px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }

                // Episode Selection Toolbar & List for Playlists/Series
                if root.is_playlist && root.playlist_episodes.length > 0: VerticalLayout {
                    spacing: 8px;

                    HorizontalLayout {
                        alignment: space-between;

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;

                            Text {
                                text: "Select Episodes to Download:";
                                color: Theme.text_primary;
                                font-size: 13px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }

                            Rectangle {
                                background: root.selected_episodes_count > 0 ? (Theme.is_dark ? #172554 : #dbeafe) : Theme.error_bg;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: root.selected_episodes_count > 0 ? (Theme.is_dark ? #2563eb : #93c5fd) : Theme.error_border;
                                height: 22px;

                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    alignment: center;
                                    Text {
                                        text: root.selected_episodes_count + " of " + root.playlist_episodes.length + " selected";
                                        color: root.selected_episodes_count > 0 ? (Theme.is_dark ? #60a5fa : #1d4ed8) : Theme.error_text;
                                        font-size: 11px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        // Min/Max controls & Range selection toolbar
                        HorizontalLayout {
                            spacing: 6px;
                            alignment: end;

                            ActionButton {
                                text: "All";
                                height: 26px;
                                clicked => { root.select_all_episodes(true); }
                            }

                            ActionButton {
                                text: "None";
                                height: 26px;
                                clicked => { root.select_all_episodes(false); }
                            }

                            range_box := LineEdit {
                                width: 85px;
                                height: 26px;
                                font_size: 11px;
                                placeholder_text: "1-10, 15";
                                text <=> root.episode_range_input;
                                accepted => { root.apply_episode_range(self.text); }
                            }

                            ActionButton {
                                text: "Apply";
                                height: 26px;
                                clicked => { root.apply_episode_range(range_box.text); }
                            }

                            // Min / Max View Button for episode list
                            ActionButton {
                                text: root.episodes_expanded ? "Min View" : "Max View";
                                icon: root.episodes_expanded ? @image-url("../icons/minimize.svg") : @image-url("../icons/maximize.svg");
                                has_icon: true;
                                height: 26px;
                                clicked => { root.episodes_expanded = !root.episodes_expanded; }
                            }
                        }
                    }

                    Rectangle {
                        background: Theme.inner_bg;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: Theme.inner_border;
                        height: root.episodes_expanded ? 280px : 140px;
                        animate height { duration: 150ms; }
                        clip: true;

                        ScrollView {
                            VerticalLayout {
                                padding: 6px;
                                spacing: 4px;

                                for ep in root.playlist_episodes: Rectangle {
                                    background: ep.selected ? (touch.has-hover ? Theme.nav_active_bg : Theme.chip_bg) :
                                                (touch.has-hover ? Theme.inner_alt : transparent);
                                    border-radius: 6px;
                                    border-width: 1px;
                                    border-color: ep.selected ? Theme.nav_active_border : transparent;
                                    height: 32px;
                                    animate background { duration: 100ms; }

                                    touch := TouchArea {
                                        clicked => { root.toggle_episode(ep.index); }
                                    }

                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        spacing: 10px;
                                        alignment: space-between;

                                        HorizontalLayout {
                                            spacing: 8px;
                                            alignment: start;

                                            // Checkbox box
                                            Rectangle {
                                                width: 16px;
                                                height: 16px;
                                                border-radius: 4px;
                                                border-width: 1px;
                                                background: ep.selected ? Theme.primary_accent : Theme.card_bg;
                                                border-color: ep.selected ? Theme.primary_border : Theme.card_border;
                                                y: (parent.height - self.height) / 2;

                                                if ep.selected: Image {
                                                    source: @image-url("../icons/check.svg");
                                                    width: 10px;
                                                    height: 10px;
                                                    colorize: #ffffff;
                                                    x: (parent.width - self.width) / 2;
                                                    y: (parent.height - self.height) / 2;
                                                }
                                            }

                                            // Episode Index Pill
                                            Rectangle {
                                                height: 20px;
                                                border-radius: 3px;
                                                background: Theme.sidebar_status_bg;
                                                border-width: 1px;
                                                border-color: Theme.sidebar_status_border;
                                                y: (parent.height - self.height) / 2;

                                                HorizontalLayout {
                                                    padding-left: 6px;
                                                    padding-right: 6px;
                                                    alignment: center;
                                                    Text {
                                                        text: "#" + (ep.index + 1);
                                                        color: Theme.text_secondary;
                                                        font-size: 10px;
                                                        font-weight: 700;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }

                                            // Episode Title
                                            Text {
                                                text: ep.title;
                                                color: ep.selected ? Theme.text_primary : Theme.text_secondary;
                                                font-size: 12px;
                                                font-weight: ep.selected ? 600 : 500;
                                                vertical-alignment: center;
                                            }
                                        }

                                        Text {
                                            text: ep.selected ? "Included" : "Skipped";
                                            color: ep.selected ? Theme.success_text : Theme.text_dimmed;
                                            font-size: 11px;
                                            font-weight: 500;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // Format & Quality Selection Chips
                Text {
                    text: root.is_playlist ? "Select Quality for All Episodes:" : "Select Format & Quality:";
                    color: Theme.text_primary;
                    font-size: 12px;
                    font-weight: 600;
                }

                HorizontalLayout {
                    spacing: 8px;

                    IconChip {
                        text: root.format_best_label;
                        icon: @image-url("../icons/video.svg");
                        has_icon: true;
                        selected: root.selected_format_index == 0;
                        clicked => { root.selected_format_index = 0; }
                    }
                    IconChip {
                        text: root.format_1080_label;
                        icon: @image-url("../icons/video.svg");
                        has_icon: true;
                        selected: root.selected_format_index == 1;
                        clicked => { root.selected_format_index = 1; }
                    }
                    IconChip {
                        text: root.format_720_label;
                        icon: @image-url("../icons/video.svg");
                        has_icon: true;
                        selected: root.selected_format_index == 2;
                        clicked => { root.selected_format_index = 2; }
                    }
                    IconChip {
                        text: root.format_480_label;
                        icon: @image-url("../icons/video.svg");
                        has_icon: true;
                        selected: root.selected_format_index == 3;
                        clicked => { root.selected_format_index = 3; }
                    }
                    IconChip {
                        text: root.format_audio_label;
                        icon: @image-url("../icons/music.svg");
                        has_icon: true;
                        selected: root.selected_format_index == 4;
                        clicked => { root.selected_format_index = 4; }
                    }
                }

                // Dedicated Audio Extraction Panel (active when Extract Audio is selected)
                if root.selected_format_index == 4: Rectangle {
                    background: Theme.inner_bg;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: Theme.inner_border;

                    VerticalLayout {
                        padding: 12px;
                        spacing: 10px;

                        // Audio Format Choice
                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: "Audio Container:";
                                color: Theme.text_secondary;
                                font-size: 12px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                IconChip {
                                    text: "MP3";
                                    selected: root.selected_audio_format_index == 0;
                                    clicked => { root.selected_audio_format_index = 0; }
                                }
                                IconChip {
                                    text: "M4A (AAC)";
                                    selected: root.selected_audio_format_index == 1;
                                    clicked => { root.selected_audio_format_index = 1; }
                                }
                                IconChip {
                                    text: "FLAC (Lossless)";
                                    selected: root.selected_audio_format_index == 2;
                                    clicked => { root.selected_audio_format_index = 2; }
                                }
                                IconChip {
                                    text: "WAV";
                                    selected: root.selected_audio_format_index == 3;
                                    clicked => { root.selected_audio_format_index = 3; }
                                }
                                IconChip {
                                    text: "OPUS";
                                    selected: root.selected_audio_format_index == 4;
                                    clicked => { root.selected_audio_format_index = 4; }
                                }
                            }
                        }

                        // Bitrate Selection (for MP3, M4A, OPUS)
                        if root.selected_audio_format_index != 2 && root.selected_audio_format_index != 3: HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: "Audio Bitrate:";
                                color: Theme.text_secondary;
                                font-size: 12px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                IconChip {
                                    text: "320 kbps (Extreme)";
                                    selected: root.selected_audio_bitrate_index == 0;
                                    clicked => { root.selected_audio_bitrate_index = 0; }
                                }
                                IconChip {
                                    text: "256 kbps (High)";
                                    selected: root.selected_audio_bitrate_index == 1;
                                    clicked => { root.selected_audio_bitrate_index = 1; }
                                }
                                IconChip {
                                    text: "192 kbps (Standard)";
                                    selected: root.selected_audio_bitrate_index == 2;
                                    clicked => { root.selected_audio_bitrate_index = 2; }
                                }
                                IconChip {
                                    text: "128 kbps (Compact)";
                                    selected: root.selected_audio_bitrate_index == 3;
                                    clicked => { root.selected_audio_bitrate_index = 3; }
                                }
                            }
                        }

                        // Embed Artwork & Tags
                        Rectangle {
                            background: root.embed_audio_metadata ? (Theme.is_dark ? #121c32 : #eff6ff) : Theme.inner_bg;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: root.embed_audio_metadata ? (Theme.is_dark ? #2563eb : #93c5fd) : Theme.inner_border;
                            height: 32px;

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 8px;
                                alignment: start;

                                VerticalLayout {
                                    alignment: center;
                                    Image {
                                        source: @image-url("../icons/sparkles.svg");
                                        width: 14px;
                                        height: 14px;
                                        colorize: root.embed_audio_metadata ? (Theme.is_dark ? #60a5fa : #2563eb) : Theme.icon_default;
                                    }
                                }

                                Text {
                                    text: root.embed_audio_metadata
                                        ? "Embed Album Cover Art & ID3 Metadata: Enabled"
                                        : "Embed Album Cover Art & ID3 Metadata: Disabled";
                                    color: root.embed_audio_metadata ? (Theme.is_dark ? #60a5fa : #2563eb) : Theme.text_secondary;
                                    font-size: 11px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }

                            TouchArea {
                                clicked => { root.embed_audio_metadata = !root.embed_audio_metadata; }
                            }
                        }
                    }
                }

                // Subtitle extraction & embedding option
                // Subtitle & Thumbnail extraction options
                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;

                    Rectangle {
                        background: root.download_subtitles ? (Theme.is_dark ? #121c32 : #eff6ff) : Theme.inner_bg;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: root.download_subtitles ? (Theme.is_dark ? #2563eb : #93c5fd) : Theme.inner_border;
                        height: 32px;

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 6px;
                            alignment: center;

                            VerticalLayout {
                                alignment: center;
                                width: 14px;
                                Image {
                                    source: @image-url("../icons/subtitles.svg");
                                    width: 14px;
                                    height: 14px;
                                    colorize: root.download_subtitles ? (Theme.is_dark ? #60a5fa : #2563eb) : Theme.icon_default;
                                }
                            }

                            Text {
                                text: root.download_subtitles ? "Subtitles: Enabled (.srt/embed)" : "Subtitles: Disabled";
                                color: root.download_subtitles ? (Theme.is_dark ? #60a5fa : #2563eb) : Theme.text_secondary;
                                font-size: 12px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }

                        TouchArea {
                            clicked => { root.download_subtitles = !root.download_subtitles; }
                        }
                    }

                    Rectangle {
                        background: root.download_thumbnail ? (Theme.is_dark ? #121c32 : #eff6ff) : Theme.inner_bg;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: root.download_thumbnail ? (Theme.is_dark ? #2563eb : #93c5fd) : Theme.inner_border;
                        height: 32px;

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 6px;
                            alignment: center;

                            VerticalLayout {
                                alignment: center;
                                width: 14px;
                                Image {
                                    source: @image-url("../icons/sparkles.svg");
                                    width: 14px;
                                    height: 14px;
                                    colorize: root.download_thumbnail ? (Theme.is_dark ? #60a5fa : #2563eb) : Theme.icon_default;
                                }
                            }

                            Text {
                                text: root.download_thumbnail ? "Cover Art / Thumbnail: Enabled" : "Cover Art / Thumbnail: Disabled";
                                color: root.download_thumbnail ? (Theme.is_dark ? #60a5fa : #2563eb) : Theme.text_secondary;
                                font-size: 12px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }

                        TouchArea {
                            clicked => { root.download_thumbnail = !root.download_thumbnail; }
                        }
                    }

                    if root.has_subtitles: VerticalLayout {
                        alignment: center;
                        Text {
                            text: "Detected: " + root.subtitles_summary;
                            color: #64748b;
                            font-size: 11px;
                            overflow: elide;
                        }
                    }
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: 10px;

                    ActionButton {
                        text: "Cancel";
                        icon: @image-url("../icons/x.svg");
                        has_icon: true;
                        height: 38px;
                        clicked => {
                            root.clear_analysis();
                        }
                    }

                    ActionButton {
                        text: !root.is_playlist ? "Start Download" :
                              root.selected_episodes_count == 0 ? "Select At Least 1 Episode" :
                              root.selected_episodes_count == root.playlist_episodes.length ? ("Download All " + root.playlist_count + " Episodes") :
                              ("Download " + root.selected_episodes_count + " Selected Episodes");
                        icon: @image-url("../icons/download.svg");
                        has_icon: true;
                        primary: true;
                        enabled: !root.is_playlist || root.selected_episodes_count > 0;
                        height: 38px;
                        clicked => {
                            root.start_download(
                                root.selected_format_index,
                                root.download_subtitles,
                                root.download_thumbnail,
                                root.selected_audio_format_index,
                                root.selected_audio_bitrate_index,
                                root.embed_audio_metadata,
                            );
                        }
                    }
                }
            }
        }

        // Empty / Placeholder state when no video analyzed
        if !root.has_metadata && !root.is_analyzing: Rectangle {
            background: Theme.card_bg;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.card_border;
            height: 175px;

            VerticalLayout {
                alignment: center;
                spacing: 10px;

                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: 44px;
                        height: 44px;
                        border-radius: 22px;
                        background: Theme.sidebar_brand_bg;
                        border-width: 1px;
                        border-color: Theme.sidebar_brand_border;

                        Image {
                            source: @image-url("../icons/sparkles.svg");
                            width: 22px;
                            height: 22px;
                            colorize: Theme.brand_purple;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }
                }

                VerticalLayout {
                    spacing: 4px;
                    Text {
                        text: "Ready to Analyze & Download Media";
                        color: Theme.text_primary;
                        font-size: 15px;
                        font-weight: 700;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "Paste any video/audio stream link above or import a .txt / .m3u links file";
                        color: Theme.text_secondary;
                        font-size: 13px;
                        horizontal-alignment: center;
                    }
                }

                HorizontalLayout {
                    alignment: center;
                    ActionButton {
                        text: "Import Links File (.txt / .m3u)...";
                        icon: @image-url("../icons/folder.svg");
                        has_icon: true;
                        primary: true;
                        height: 32px;
                        clicked => {
                            root.import_links_file();
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: center;

                    Rectangle {
                        background: Theme.chip_bg;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: Theme.chip_border;
                        height: 22px;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            alignment: center;
                            Text {
                                text: "Up to 4K Lossless";
                                color: Theme.chip_text;
                                font-size: 11px;
                                font-weight: 500;
                                vertical-alignment: center;
                            }
                        }
                    }

                    Rectangle {
                        background: Theme.chip_bg;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: Theme.chip_border;
                        height: 22px;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            alignment: center;
                            Text {
                                text: "Fast Resumption";
                                color: Theme.chip_text;
                                font-size: 11px;
                                font-weight: 500;
                                vertical-alignment: center;
                            }
                        }
                    }

                    Rectangle {
                        background: Theme.chip_bg;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: Theme.chip_border;
                        height: 22px;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            alignment: center;
                            Text {
                                text: "Subtitles & Audio MP3";
                                color: Theme.chip_text;
                                font-size: 11px;
                                font-weight: 500;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }
    }

    // --- BATCH URLS MODE ---
    if root.batch_mode: VerticalLayout {
        spacing: 16px;

        Rectangle {
            background: Theme.card_bg;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.card_border;

            VerticalLayout {
                padding: 20px;
                spacing: 14px;

                HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: "Batch Download Queue (one link per line)";
                        color: Theme.text_primary;
                        font-size: 14px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;

                        ActionButton {
                            text: "Import File (.txt)";
                            icon: @image-url("../icons/folder.svg");
                            has_icon: true;
                            height: 30px;
                            clicked => {
                                root.import_links_file();
                            }
                        }

                        ActionButton {
                            text: "Paste Clipboard";
                            icon: @image-url("../icons/clipboard.svg");
                            has_icon: true;
                            height: 30px;
                            clicked => {
                                root.paste_batch_from_clipboard();
                            }
                        }
                    }
                }

                batch_input := TextEdit {
                    text <=> root.batch_urls_text;
                    font_size: 13px;
                    height: 140px;
                }

                Text {
                    text: "Select Default Format for Batch:";
                    color: Theme.text_primary;
                    font-size: 12px;
                    font-weight: 600;
                }

                HorizontalLayout {
                    spacing: 8px;

                    IconChip {
                        text: root.format_best_label;
                        icon: @image-url("../icons/video.svg");
                        has_icon: true;
                        selected: root.selected_format_index == 0;
                        clicked => { root.selected_format_index = 0; }
                    }
                    IconChip {
                        text: root.format_720_label;
                        icon: @image-url("../icons/video.svg");
                        has_icon: true;
                        selected: root.selected_format_index == 2;
                        clicked => { root.selected_format_index = 2; }
                    }
                    IconChip {
                        text: root.format_audio_label;
                        icon: @image-url("../icons/music.svg");
                        has_icon: true;
                        selected: root.selected_format_index == 4;
                        clicked => { root.selected_format_index = 4; }
                    }
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: 10px;

                    ActionButton {
                        text: "Queue All in Batch";
                        icon: @image-url("../icons/download.svg");
                        has_icon: true;
                        primary: true;
                        height: 38px;
                        clicked => {
                            root.start_batch_download(
                                root.batch_urls_text,
                                root.selected_format_index,
                                root.download_thumbnail,
                                root.selected_audio_format_index,
                                root.selected_audio_bitrate_index,
                                root.embed_audio_metadata,
                            );
                        }
                    }
                }
            }
        }
    }
}
}
