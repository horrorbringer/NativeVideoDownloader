import { LineEdit, ScrollView } from "std-widgets.slint";
import { ActionButton } from "../components/action_button.slint";
import { IconChip } from "../components/icon_chip.slint";
import { ProgressBar } from "../components/progress_bar.slint";
import { DownloadItemData, SpeedSampleData } from "../models.slint";
import { Theme } from "../theme.slint";

export component DownloadsTab inherits VerticalLayout {
    in-out property <[DownloadItemData]> download_items: [];
    in-out property <int> total_queue_count: 0;
    in-out property <int> queue_filter_index: 0;
    in-out property <string> queue_search_query: "";
    in-out property <[SpeedSampleData]> speed_samples: [];
    in-out property <string> current_total_speed_text: "0 B/s";
    in-out property <string> peak_speed_text: "0 B/s";
    in-out property <string> session_downloaded_text: "0 B";
    in-out property <bool> show_speed_graph: true;
    in-out property <bool> is_downloading_active: false;

    callback pause_all();
    callback resume_all();
    callback clear_completed();
    callback set_queue_filter(int);
    callback search_queue(string);
    callback open_download_file(string);
    callback open_download_folder(string);
    callback pause_download(string);
    callback resume_download(string);
    callback cancel_download(string);

    spacing: 12px;

    // Live Bandwidth & Speed Graph Monitor Card
    Rectangle {
        background: Theme.graph_card_bg;
        border-radius: 10px;
        border-width: 1px;
        border-color: Theme.graph_card_border;
        height: root.show_speed_graph ? 114px : 42px;
        animate height { duration: 150ms; }

        VerticalLayout {
            padding: 10px;
            spacing: 8px;

            // Header: Live Speed, Metrics, and Toggle
            HorizontalLayout {
                alignment: space-between;

                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;

                    // Live Indicator & Speed text
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;

                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 8px;
                                height: 8px;
                                border-radius: 4px;
                                background: root.is_downloading_active ? #38bdf8 : #475569;
                                animate background { duration: 200ms; }
                            }
                        }

                        Text {
                            text: root.current_total_speed_text;
                            color: root.is_downloading_active ? #38bdf8 : #94a3b8;
                            font-size: 15px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }

                    // Peak speed pill
                    Rectangle {
                        background: Theme.sidebar_status_bg;
                        border-radius: 4px;
                        height: 22px;
                        HorizontalLayout {
                            padding-left: 7px;
                            padding-right: 7px;
                            alignment: center;
                            Text {
                                text: "Peak: " + root.peak_speed_text;
                                color: Theme.text_secondary;
                                font-size: 10px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Session total transferred pill
                    Rectangle {
                        background: Theme.sidebar_status_bg;
                        border-radius: 4px;
                        height: 22px;
                        HorizontalLayout {
                            padding-left: 7px;
                            padding-right: 7px;
                            alignment: center;
                            Text {
                                text: "Session: " + root.session_downloaded_text;
                                color: Theme.text_secondary;
                                font-size: 10px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // Show/Hide Graph Button
                ActionButton {
                    text: root.show_speed_graph ? "Hide Graph" : "Show Graph";
                    icon: root.show_speed_graph ? @image-url("../icons/x.svg") : @image-url("../icons/bolt.svg");
                    has_icon: true;
                    height: 24px;
                    clicked => {
                        root.show_speed_graph = !root.show_speed_graph;
                    }
                }
            }

            // Real-time Bar Visualizer Area
            if root.show_speed_graph: VerticalLayout {
                spacing: 4px;

                Rectangle {
                    background: Theme.graph_bg;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: Theme.graph_border;
                    height: 48px;
                    clip: true;

                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        padding-top: 4px;
                        padding-bottom: 4px;
                        spacing: 2px;

                        for sample in root.speed_samples: VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: end;
                            Rectangle {
                                horizontal-stretch: 1;
                                height: Math.max(3px, sample.ratio * 38px);
                                border-radius: 2px;
                                background: sample.ratio > 0.6 ? #60a5fa :
                                            sample.ratio > 0.2 ? #3b82f6 :
                                            sample.ratio > 0.01 ? #1d4ed8 : #1a2234;
                                animate height { duration: 150ms; }
                                animate background { duration: 150ms; }
                            }
                        }
                    }
                }

                // Timeline markers
                HorizontalLayout {
                    alignment: space-between;
                    padding-left: 8px;
                    padding-right: 8px;

                    Text {
                        text: "-30s";
                        color: Theme.text_muted;
                        font-size: 9px;
                        font-weight: 600;
                    }
                    Text {
                        text: "-20s";
                        color: Theme.text_muted;
                        font-size: 9px;
                        font-weight: 600;
                    }
                    Text {
                        text: "-10s";
                        color: Theme.text_muted;
                        font-size: 9px;
                        font-weight: 600;
                    }
                    Text {
                        text: "Now";
                        color: root.is_downloading_active ? (Theme.is_dark ? #38bdf8 : #0284c7) : Theme.text_muted;
                        font-size: 9px;
                        font-weight: 700;
                    }
                }
            }
        }
    }

    // Queue Toolbar
    HorizontalLayout {
        alignment: space-between;

        Text {
            text: "Queue (" + root.total_queue_count + " jobs)";
            color: Theme.text_secondary;
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
        }

        HorizontalLayout {
            spacing: 8px;

            ActionButton {
                text: "Pause All";
                icon: @image-url("../icons/pause.svg");
                has_icon: true;
                height: 32px;
                clicked => { root.pause_all(); }
            }

            ActionButton {
                text: "Resume All";
                icon: @image-url("../icons/play.svg");
                has_icon: true;
                height: 32px;
                clicked => { root.resume_all(); }
            }

            ActionButton {
                text: "Clear Finished";
                icon: @image-url("../icons/broom.svg");
                has_icon: true;
                height: 32px;
                clicked => { root.clear_completed(); }
            }
        }
    }

    // Search & Filter Toolbar
    HorizontalLayout {
        spacing: 12px;

        queue_search := LineEdit {
            placeholder_text: "Search active or queued downloads by title or URL...";
            font_size: 13px;
            height: 36px;
            horizontal-stretch: 1;
            edited => {
                root.queue_search_query = self.text;
                root.search_queue(self.text);
            }
        }
    }

    HorizontalLayout {
        spacing: 8px;
        alignment: start;

        IconChip {
            text: "All";
            selected: root.queue_filter_index == 0;
            clicked => {
                root.queue_filter_index = 0;
                root.set_queue_filter(0);
            }
        }
        IconChip {
            text: "Downloading";
            icon: @image-url("../icons/download.svg");
            has_icon: true;
            selected: root.queue_filter_index == 1;
            clicked => {
                root.queue_filter_index = 1;
                root.set_queue_filter(1);
            }
        }
        IconChip {
            text: "Queued";
            icon: @image-url("../icons/history.svg");
            has_icon: true;
            selected: root.queue_filter_index == 2;
            clicked => {
                root.queue_filter_index = 2;
                root.set_queue_filter(2);
            }
        }
        IconChip {
            text: "Paused";
            icon: @image-url("../icons/pause.svg");
            has_icon: true;
            selected: root.queue_filter_index == 3;
            clicked => {
                root.queue_filter_index = 3;
                root.set_queue_filter(3);
            }
        }
        IconChip {
            text: "Completed";
            icon: @image-url("../icons/check.svg");
            has_icon: true;
            selected: root.queue_filter_index == 4;
            clicked => {
                root.queue_filter_index = 4;
                root.set_queue_filter(4);
            }
        }
        IconChip {
            text: "Failed";
            icon: @image-url("../icons/x.svg");
            has_icon: true;
            selected: root.queue_filter_index == 5;
            clicked => {
                root.queue_filter_index = 5;
                root.set_queue_filter(5);
            }
        }
    }

    // If no downloads in current view
    if root.download_items.length == 0: Rectangle {
        background: Theme.card_bg;
        border-radius: 12px;
        border-width: 1px;
        border-color: Theme.card_border;
        vertical-stretch: 1;

        VerticalLayout {
            alignment: center;
            spacing: 14px;

            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 48px;
                    height: 48px;
                    border-radius: 24px;
                    background: Theme.sidebar_brand_bg;
                    border-width: 1px;
                    border-color: Theme.sidebar_brand_border;

                    Image {
                        source: (root.queue_filter_index != 0 || root.queue_search_query != "") ? @image-url("../icons/search.svg") : @image-url("../icons/download.svg");
                        width: 22px;
                        height: 22px;
                        colorize: Theme.brand_purple;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }
            }

            VerticalLayout {
                spacing: 5px;
                Text {
                    text: (root.queue_filter_index != 0 || root.queue_search_query != "") ? "No matching downloads found" : "No active downloads";
                    color: Theme.text_primary;
                    font-size: 15px;
                    font-weight: 700;
                    horizontal-alignment: center;
                }
                Text {
                    text: (root.queue_filter_index != 0 || root.queue_search_query != "") ? "Try selecting 'All' or clearing your search query above." : "Downloads in progress, paused, or queued will appear here.";
                    color: Theme.text_secondary;
                    font-size: 13px;
                    horizontal-alignment: center;
                }
            }
        }
    }

    // If downloads exist in queue
    if root.download_items.length > 0: ScrollView {
        vertical-stretch: 1;

        VerticalLayout {
            spacing: 10px;
            padding-bottom: 8px;

            for item in root.download_items: Rectangle {
                background: touch.has-hover ? Theme.card_hover : Theme.card_bg;
                border-radius: 12px;
                border-width: 1px;
                border-color: touch.has-hover ? Theme.primary_border : Theme.card_border;
                animate background { duration: 150ms; }
                animate border-color { duration: 150ms; }

                touch := TouchArea { }

                VerticalLayout {
                    padding: 16px;
                    spacing: 12px;

                    HorizontalLayout {
                        alignment: space-between;

                        VerticalLayout {
                            spacing: 6px;
                            Text {
                                text: item.title;
                                color: Theme.text_primary;
                                font-size: 15px;
                                font-weight: 600;
                            }

                            HorizontalLayout {
                                alignment: start;
                                Rectangle {
                                    background: item.status == "Completed" ? #0e291b :
                                                item.status == "Paused" ? #331e08 :
                                                item.status == "Downloading" ? #0f2142 :
                                                item.status == "Queued" ? #25103a : #331317;
                                    border-radius: 4px;
                                    border-width: 1px;
                                    border-color: item.status == "Completed" ? #166534 :
                                                  item.status == "Paused" ? #b45309 :
                                                  item.status == "Downloading" ? #2563eb :
                                                  item.status == "Queued" ? #7e22ce : #991b1b;
                                    height: 22px;

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        alignment: center;

                                        Text {
                                            text: item.status;
                                            color: item.status == "Completed" ? #4ade80 :
                                                   item.status == "Paused" ? #fcd34d :
                                                   item.status == "Downloading" ? #60a5fa :
                                                   item.status == "Queued" ? #c084fc : #f87171;
                                            font-size: 11px;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 6px;
                            alignment: end;

                            if item.is_completed: ActionButton {
                                text: "Play";
                                icon: @image-url("../icons/play.svg");
                                has_icon: true;
                                height: 30px;
                                clicked => { root.open_download_file(item.output_path); }
                            }

                            if item.is_completed: ActionButton {
                                text: "Finder";
                                icon: @image-url("../icons/folder.svg");
                                has_icon: true;
                                height: 30px;
                                clicked => { root.open_download_folder(item.output_path); }
                            }

                            if item.can_pause: ActionButton {
                                text: "Pause";
                                icon: @image-url("../icons/pause.svg");
                                has_icon: true;
                                height: 30px;
                                clicked => { root.pause_download(item.id); }
                            }

                            if item.can_resume: ActionButton {
                                text: "Resume";
                                icon: @image-url("../icons/play.svg");
                                has_icon: true;
                                height: 30px;
                                clicked => { root.resume_download(item.id); }
                            }

                            if item.can_cancel: ActionButton {
                                text: "Cancel";
                                icon: @image-url("../icons/x.svg");
                                has_icon: true;
                                danger: true;
                                height: 30px;
                                clicked => { root.cancel_download(item.id); }
                            }
                        }
                    }

                    ProgressBar {
                        progress: item.progress;
                        status: item.status;
                        height: 8px;
                    }

                    HorizontalLayout {
                        alignment: space-between;

                        Text {
                            text: item.size_text;
                            color: Theme.text_secondary;
                            font-size: 12px;
                        }

                        Text {
                            text: "Speed: " + item.speed_text + "  •  ETA: " + item.eta_text;
                            color: Theme.text_secondary;
                            font-size: 12px;
                        }
                    }
                }
            }
        }
    }
}
