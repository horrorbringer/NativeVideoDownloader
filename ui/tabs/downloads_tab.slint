import { LineEdit, ScrollView } from "std-widgets.slint";
import { ActionButton } from "../components/action_button.slint";
import { IconChip } from "../components/icon_chip.slint";
import { ProgressBar } from "../components/progress_bar.slint";
import { DownloadItemData, SpeedSampleData } from "../models.slint";
import { Theme } from "../theme.slint";

export component DownloadsTab inherits VerticalLayout {
    in-out property <[DownloadItemData]> download_items: [];
    in-out property <int> total_queue_count: 0;
    in-out property <int> queue_filter_index: 0;
    in-out property <string> queue_search_query: "";
    in-out property <[SpeedSampleData]> speed_samples: [];
    in-out property <string> current_total_speed_text: "0 B/s";
    in-out property <string> peak_speed_text: "0 B/s";
    in-out property <string> session_downloaded_text: "0 B";
    in-out property <bool> show_speed_graph: true;
    in-out property <bool> is_downloading_active: false;

    callback pause_all();
    callback resume_all();
    callback clear_completed();
    callback set_queue_filter(int);
    callback search_queue(string);
    callback open_download_file(string);
    callback open_download_folder(string);
    callback pause_download(string);
    callback resume_download(string);
    callback cancel_download(string);

    spacing: 12px;

    // Live Bandwidth & Speed Graph Monitor Card
    Rectangle {
        background: Theme.graph_card_bg;
        border-radius: 12px;
        border-width: 1px;
        border-color: Theme.graph_card_border;
        height: root.show_speed_graph ? 124px : 44px;
        animate height { duration: 150ms; }

        VerticalLayout {
            padding-left: 14px;
            padding-right: 14px;
            padding-top: 10px;
            padding-bottom: 10px;
            spacing: 8px;

            // Header: Live Speed, Metrics, and Toggle
            HorizontalLayout {
                alignment: space-between;

                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;

                    // Live Indicator & Speed text
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;

                        VerticalLayout {
                            alignment: center;

                            // Radar pulse live badge
                            Rectangle {
                                width: 14px;
                                height: 14px;
                                border-radius: 7px;
                                background: root.is_downloading_active ? #38bdf82a : transparent;
                                animate background { duration: 200ms; }

                                Rectangle {
                                    width: 8px;
                                    height: 8px;
                                    border-radius: 4px;
                                    background: root.is_downloading_active ? #38bdf8 : #475569;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    animate background { duration: 200ms; }
                                }
                            }
                        }

                        Text {
                            text: root.current_total_speed_text;
                            color: root.is_downloading_active ? #38bdf8 : #94a3b8;
                            font-size: 16px;
                            font-weight: 800;
                            vertical-alignment: center;
                        }
                    }

                    // Peak speed pill
                    Rectangle {
                        background: Theme.sidebar_status_bg;
                        border-radius: 5px;
                        border-width: 1px;
                        border-color: Theme.sidebar_status_border;
                        height: 24px;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 5px;
                            alignment: center;

                            Image {
                                source: @image-url("../icons/bolt.svg");
                                width: 11px;
                                height: 11px;
                                colorize: #f59e0b;
                                vertical-alignment: center;
                            }

                            Text {
                                text: "Peak: " + root.peak_speed_text;
                                color: Theme.text_secondary;
                                font-size: 11px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Session total transferred pill
                    Rectangle {
                        background: Theme.sidebar_status_bg;
                        border-radius: 5px;
                        border-width: 1px;
                        border-color: Theme.sidebar_status_border;
                        height: 24px;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 5px;
                            alignment: center;

                            Image {
                                source: @image-url("../icons/download.svg");
                                width: 11px;
                                height: 11px;
                                colorize: #a855f7;
                                vertical-alignment: center;
                            }

                            Text {
                                text: "Session: " + root.session_downloaded_text;
                                color: Theme.text_secondary;
                                font-size: 11px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // Show/Hide Graph Button
                ActionButton {
                    text: root.show_speed_graph ? "Hide Graph" : "Show Graph";
                    icon: root.show_speed_graph ? @image-url("../icons/x.svg") : @image-url("../icons/bolt.svg");
                    has_icon: true;
                    height: 26px;
                    clicked => {
                        root.show_speed_graph = !root.show_speed_graph;
                    }
                }
            }

            // Real-time Bar Visualizer Area
            if root.show_speed_graph: VerticalLayout {
                spacing: 4px;

                Rectangle {
                    background: Theme.graph_bg;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: Theme.graph_border;
                    height: 54px;
                    clip: true;

                    // Subtle background level guide lines
                    Rectangle {
                        y: parent.height * 0.28;
                        x: 0;
                        width: parent.width;
                        height: 1px;
                        background: Theme.is_dark ? #ffffff08 : #0000000a;
                    }
                    Rectangle {
                        y: parent.height * 0.62;
                        x: 0;
                        width: parent.width;
                        height: 1px;
                        background: Theme.is_dark ? #ffffff08 : #0000000a;
                    }

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        padding-top: 4px;
                        padding-bottom: 4px;
                        spacing: 3px;

                        for sample in root.speed_samples: sample_col := HorizontalLayout {
                            horizontal-stretch: 1;
                            alignment: center;

                            VerticalLayout {
                                alignment: end;

                                Rectangle {
                                    width: 4px;
                                    height: Math.max(3px, sample.ratio * 44px);
                                    border-top-left-radius: 1.5px;
                                    border-top-right-radius: 1.5px;
                                    border-bottom-left-radius: 1px;
                                    border-bottom-right-radius: 1px;
                                    background: sample.ratio > 0.7 ? (Theme.is_dark ? #38bdf8 : #0284c7) :
                                                sample.ratio > 0.4 ? (Theme.is_dark ? #60a5fa : #2563eb) :
                                                sample.ratio > 0.15 ? (Theme.is_dark ? #3b82f6 : #3b82f6) :
                                                sample.ratio > 0.01 ? (Theme.is_dark ? #2563eb : #60a5fa) :
                                                (Theme.is_dark ? #1a2032 : #e2e8f0);
                                    animate height { duration: 150ms; }
                                    animate background { duration: 150ms; }

                                    // Glowing active cap
                                    if sample.ratio > 0.05: Rectangle {
                                        y: 0;
                                        width: parent.width;
                                        height: 2px;
                                        border-top-left-radius: 1.5px;
                                        border-top-right-radius: 1.5px;
                                        background: #ffffff99;
                                    }
                                }
                            }
                        }
                    }
                }

                // Timeline markers (30-second rolling window)
                HorizontalLayout {
                    alignment: space-between;
                    padding-left: 10px;
                    padding-right: 10px;

                    Text {
                        text: "-30s";
                        color: Theme.text_muted;
                        font-size: 10px;
                        font-weight: 600;
                    }
                    Text {
                        text: "-20s";
                        color: Theme.text_muted;
                        font-size: 10px;
                        font-weight: 600;
                    }
                    Text {
                        text: "-10s";
                        color: Theme.text_muted;
                        font-size: 10px;
                        font-weight: 600;
                    }
                    Text {
                        text: "Now";
                        color: root.is_downloading_active ? #38bdf8 : Theme.text_muted;
                        font-size: 10px;
                        font-weight: 700;
                    }
                }
            }
        }
    }

    // Queue Toolbar
    HorizontalLayout {
        alignment: space-between;

        Text {
            text: "Queue (" + root.total_queue_count + " jobs)";
            color: Theme.text_secondary;
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
        }

        HorizontalLayout {
            spacing: 8px;

            ActionButton {
                text: "Pause All";
                icon: @image-url("../icons/pause.svg");
                has_icon: true;
                height: 32px;
                clicked => { root.pause_all(); }
            }

            ActionButton {
                text: "Resume All";
                icon: @image-url("../icons/play.svg");
                has_icon: true;
                height: 32px;
                clicked => { root.resume_all(); }
            }

            ActionButton {
                text: "Clear Finished";
                icon: @image-url("../icons/broom.svg");
                has_icon: true;
                height: 32px;
                clicked => { root.clear_completed(); }
            }
        }
    }

    // Search & Filter Toolbar
    HorizontalLayout {
        spacing: 12px;

        queue_search := LineEdit {
            placeholder_text: "Search active or queued downloads by title or URL...";
            font_size: 13px;
            height: 36px;
            horizontal-stretch: 1;
            edited => {
                root.queue_search_query = self.text;
                root.search_queue(self.text);
            }
        }
    }

    HorizontalLayout {
        spacing: 8px;
        alignment: start;

        IconChip {
            text: "All";
            selected: root.queue_filter_index == 0;
            clicked => {
                root.queue_filter_index = 0;
                root.set_queue_filter(0);
            }
        }
        IconChip {
            text: "Downloading";
            icon: @image-url("../icons/download.svg");
            has_icon: true;
            selected: root.queue_filter_index == 1;
            clicked => {
                root.queue_filter_index = 1;
                root.set_queue_filter(1);
            }
        }
        IconChip {
            text: "Queued";
            icon: @image-url("../icons/history.svg");
            has_icon: true;
            selected: root.queue_filter_index == 2;
            clicked => {
                root.queue_filter_index = 2;
                root.set_queue_filter(2);
            }
        }
        IconChip {
            text: "Paused";
            icon: @image-url("../icons/pause.svg");
            has_icon: true;
            selected: root.queue_filter_index == 3;
            clicked => {
                root.queue_filter_index = 3;
                root.set_queue_filter(3);
            }
        }
        IconChip {
            text: "Completed";
            icon: @image-url("../icons/check.svg");
            has_icon: true;
            selected: root.queue_filter_index == 4;
            clicked => {
                root.queue_filter_index = 4;
                root.set_queue_filter(4);
            }
        }
        IconChip {
            text: "Failed";
            icon: @image-url("../icons/x.svg");
            has_icon: true;
            selected: root.queue_filter_index == 5;
            clicked => {
                root.queue_filter_index = 5;
                root.set_queue_filter(5);
            }
        }
    }

    // If no downloads in current view
    if root.download_items.length == 0: Rectangle {
        background: Theme.card_bg;
        border-radius: 12px;
        border-width: 1px;
        border-color: Theme.card_border;
        vertical-stretch: 1;

        VerticalLayout {
            alignment: center;
            spacing: 14px;

            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 48px;
                    height: 48px;
                    border-radius: 24px;
                    background: Theme.sidebar_brand_bg;
                    border-width: 1px;
                    border-color: Theme.sidebar_brand_border;

                    Image {
                        source: (root.queue_filter_index != 0 || root.queue_search_query != "") ? @image-url("../icons/search.svg") : @image-url("../icons/download.svg");
                        width: 22px;
                        height: 22px;
                        colorize: Theme.brand_purple;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }
            }

            VerticalLayout {
                spacing: 5px;
                Text {
                    text: (root.queue_filter_index != 0 || root.queue_search_query != "") ? "No matching downloads found" : "No active downloads";
                    color: Theme.text_primary;
                    font-size: 15px;
                    font-weight: 700;
                    horizontal-alignment: center;
                }
                Text {
                    text: (root.queue_filter_index != 0 || root.queue_search_query != "") ? "Try selecting 'All' or clearing your search query above." : "Downloads in progress, paused, or queued will appear here.";
                    color: Theme.text_secondary;
                    font-size: 13px;
                    horizontal-alignment: center;
                }
            }
        }
    }

    // If downloads exist in queue
    if root.download_items.length > 0: ScrollView {
        vertical-stretch: 1;

        VerticalLayout {
            alignment: start;
            spacing: 10px;
            padding-bottom: 12px;

            for item in root.download_items: Rectangle {
                min-height: 104px;
                max-height: 126px;
                background: touch.has-hover ? Theme.card_hover : Theme.card_bg;
                border-radius: 12px;
                border-width: 1px;
                border-color: touch.has-hover ? Theme.primary_border : Theme.card_border;
                animate background { duration: 150ms; }
                animate border-color { duration: 150ms; }

                touch := TouchArea { }

                VerticalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-top: 12px;
                    padding-bottom: 12px;
                    spacing: 8px;
                    alignment: space-between;

                    // Row 1: Header (Status Icon + Title + Status Pill | Action Buttons)
                    HorizontalLayout {
                        alignment: space-between;
                        spacing: 12px;

                        HorizontalLayout {
                            spacing: 10px;
                            horizontal-stretch: 1;
                            alignment: start;

                            // Media & Status Icon Badge
                            Rectangle {
                                width: 32px;
                                height: 32px;
                                border-radius: 8px;
                                background: item.status == "Completed" ? (Theme.is_dark ? #064e3b : #dcfce7) :
                                            item.status == "Downloading" ? (Theme.is_dark ? #1e293b : #e0f2fe) :
                                            item.status == "Paused" ? (Theme.is_dark ? #451a03 : #fef3c7) :
                                            item.status == "Failed" ? (Theme.is_dark ? #450a0a : #fee2e2) :
                                            (Theme.is_dark ? #1e1b4b : #f3e8ff);
                                border-width: 1px;
                                border-color: item.status == "Completed" ? #10b981 :
                                              item.status == "Downloading" ? #3b82f6 :
                                              item.status == "Paused" ? #f59e0b :
                                              item.status == "Failed" ? #ef4444 : #8b5cf6;

                                Image {
                                    source: item.status == "Completed" ? @image-url("../icons/check.svg") :
                                            item.status == "Downloading" ? @image-url("../icons/download.svg") :
                                            item.status == "Paused" ? @image-url("../icons/pause.svg") :
                                            item.status == "Failed" ? @image-url("../icons/x.svg") :
                                            @image-url("../icons/history.svg");
                                    width: 15px;
                                    height: 15px;
                                    colorize: item.status == "Completed" ? #10b981 :
                                              item.status == "Downloading" ? #38bdf8 :
                                              item.status == "Paused" ? #f59e0b :
                                              item.status == "Failed" ? #ef4444 : #a855f7;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }
                            }

                            VerticalLayout {
                                spacing: 3px;
                                horizontal-stretch: 1;
                                alignment: center;

                                Text {
                                    text: item.title;
                                    color: Theme.text_primary;
                                    font-size: 14px;
                                    font-weight: 700;
                                    overflow: elide;
                                }

                                HorizontalLayout {
                                    spacing: 6px;
                                    alignment: start;

                                    Rectangle {
                                        background: item.status == "Completed" ? #0e291b :
                                                    item.status == "Paused" ? #331e08 :
                                                    item.status == "Downloading" ? #0f2142 :
                                                    item.status == "Queued" ? #25103a : #331317;
                                        border-radius: 4px;
                                        border-width: 1px;
                                        border-color: item.status == "Completed" ? #166534 :
                                                      item.status == "Paused" ? #b45309 :
                                                      item.status == "Downloading" ? #2563eb :
                                                      item.status == "Queued" ? #7e22ce : #991b1b;
                                        height: 18px;

                                        HorizontalLayout {
                                            padding-left: 6px;
                                            padding-right: 6px;
                                            alignment: center;

                                            Text {
                                                text: item.status;
                                                color: item.status == "Completed" ? #4ade80 :
                                                       item.status == "Paused" ? #fcd34d :
                                                       item.status == "Downloading" ? #60a5fa :
                                                       item.status == "Queued" ? #c084fc : #f87171;
                                                font-size: 10px;
                                                font-weight: 700;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Right: Action Buttons
                        HorizontalLayout {
                            spacing: 6px;
                            alignment: end;

                            if item.is_completed: ActionButton {
                                text: "Play";
                                icon: @image-url("../icons/play.svg");
                                has_icon: true;
                                height: 28px;
                                clicked => { root.open_download_file(item.output_path); }
                            }

                            if item.is_completed: ActionButton {
                                text: "Finder";
                                icon: @image-url("../icons/folder.svg");
                                has_icon: true;
                                height: 28px;
                                clicked => { root.open_download_folder(item.output_path); }
                            }

                            if item.can_pause: ActionButton {
                                text: "Pause";
                                icon: @image-url("../icons/pause.svg");
                                has_icon: true;
                                height: 28px;
                                clicked => { root.pause_download(item.id); }
                            }

                            if item.can_resume: ActionButton {
                                text: "Resume";
                                icon: @image-url("../icons/play.svg");
                                has_icon: true;
                                height: 28px;
                                clicked => { root.resume_download(item.id); }
                            }

                            if item.can_cancel: ActionButton {
                                text: "Cancel";
                                icon: @image-url("../icons/x.svg");
                                has_icon: true;
                                danger: true;
                                height: 28px;
                                clicked => { root.cancel_download(item.id); }
                            }
                        }
                    }

                    // Row 2: Smooth High-Contrast Progress Bar
                    ProgressBar {
                        progress: item.progress;
                        status: item.status;
                        height: 7px;
                    }

                    // Row 3: Progress text & Speed / ETA Telemetry
                    HorizontalLayout {
                        alignment: space-between;

                        Text {
                            text: item.size_text;
                            color: Theme.text_secondary;
                            font-size: 12px;
                            font-weight: 500;
                            vertical-alignment: center;
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: end;

                            if item.status == "Downloading": Rectangle {
                                background: Theme.is_dark ? #0c2038 : #e0f2fe;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: Theme.is_dark ? #1e3a5f : #bae6fd;
                                height: 20px;

                                HorizontalLayout {
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    spacing: 4px;
                                    alignment: center;

                                    Image {
                                        source: @image-url("../icons/download.svg");
                                        width: 10px;
                                        height: 10px;
                                        colorize: #38bdf8;
                                        vertical-alignment: center;
                                    }

                                    Text {
                                        text: item.speed_text;
                                        color: #38bdf8;
                                        font-size: 11px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            if item.status == "Downloading": Text {
                                text: "ETA: " + item.eta_text;
                                color: Theme.text_secondary;
                                font-size: 12px;
                                font-weight: 500;
                                vertical-alignment: center;
                            }

                            if item.status != "Downloading": Text {
                                text: item.status == "Completed" ? "Completed" : (item.status == "Paused" ? "Paused" : item.status);
                                color: Theme.text_muted;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }
    }
}
