import { LineEdit, ScrollView } from "std-widgets.slint";
import { ActionButton } from "../components/action_button.slint";
import { IconChip } from "../components/icon_chip.slint";
import { ProgressBar } from "../components/progress_bar.slint";
import { SearchField } from "../components/search_field.slint";
import { StyledInput } from "../components/styled_input.slint";
import { DownloadItemData, SpeedSampleData } from "../models.slint";
import { Theme } from "../theme.slint";

export component DownloadsTab inherits VerticalLayout {
    in-out property <[DownloadItemData]> download_items: [];
    in-out property <int> total_queue_count: 0;
    in-out property <int> queue_filter_index: 0;
    in-out property <string> queue_search_query: "";
    in-out property <[SpeedSampleData]> speed_samples: [];
    in-out property <string> current_total_speed_text: "0 B/s";
    in-out property <string> peak_speed_text: "0 B/s";
    in-out property <string> session_downloaded_text: "0 B";
    in-out property <bool> show_speed_graph: true;
    in-out property <bool> is_downloading_active: false;
    in-out property <int> selected_speed_limit_index: 0;

    callback pause_all();
    callback resume_all();
    callback cancel_all();
    callback clear_completed();
    callback clear_failed();
    callback set_queue_filter(int);
    callback search_queue(string);
    callback open_download_file(string);
    callback open_download_folder(string);
    callback pause_download(string);
    callback resume_download(string);
    callback cancel_download(string);
    callback move_job_up(string);
    callback move_job_down(string);
    callback prioritize_job(string);
    callback set_speed_limit(int);
    callback open_converter(string, string);
    in-out property <int> selected_downloads_count: 0;
    callback toggle_download_selected(string);
    callback select_all_downloads(bool);
    callback pause_selected();
    callback resume_selected();
    callback cancel_selected();
    callback prioritize_selected();

    in-out property <int> speed_graph_mode: 0; // 0 = Bars, 1 = Area, 2 = Stats
    in-out property <string> avg_speed_text: "0 B/s";
    in-out property <string> network_stability_text: "Idle";
    in-out property <float> speed_limit_ratio: 0.0;
    in-out property <string> speed_limit_label: "";
    in-out property <bool> show_custom_speed_dialog: false;
    in-out property <string> custom_speed_input: "";

    callback set_custom_speed_limit(string);
    callback open_network_diagnostics();
    in-out property <bool> scheduler_active: false;
    in-out property <string> scheduler_status_banner_text: "";
    callback bypass_scheduler_now();

    spacing: 12px;

    // Live Bandwidth & Speed Graph Monitor Card
    Rectangle {
        background: Theme.graph_card_bg;
        border-radius: 12px;
        border-width: 1px;
        border-color: Theme.graph_card_border;
        height: root.show_speed_graph ? (root.show_custom_speed_dialog ? 158px : 126px) : 44px;
        animate height { duration: 150ms; }

        VerticalLayout {
            padding-left: 14px;
            padding-right: 14px;
            padding-top: 10px;
            padding-bottom: 10px;
            spacing: 6px;

            // Header: Live Speed, Metrics, Modes, and Controls
            HorizontalLayout {
                alignment: space-between;

                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;

                    // Live Indicator & Speed text
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;

                        VerticalLayout {
                            alignment: center;

                            // Radar pulse live badge
                            Rectangle {
                                width: 14px;
                                height: 14px;
                                border-radius: 7px;
                                background: root.is_downloading_active ? #38bdf82a : transparent;
                                animate background { duration: 200ms; }

                                Rectangle {
                                    width: 8px;
                                    height: 8px;
                                    border-radius: 4px;
                                    background: root.is_downloading_active ? #38bdf8 : #475569;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    animate background { duration: 200ms; }
                                }
                            }
                        }

                        Text {
                            text: root.current_total_speed_text;
                            color: root.is_downloading_active ? #38bdf8 : #94a3b8;
                            font-size: 16px;
                            font-weight: 800;
                            vertical-alignment: center;
                        }
                    }

                    // Peak speed pill
                    Rectangle {
                        background: Theme.sidebar_status_bg;
                        border-radius: 5px;
                        border-width: 1px;
                        border-color: Theme.sidebar_status_border;
                        height: 24px;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 5px;
                            alignment: center;

                            VerticalLayout {
                                alignment: center;
                                Image {
                                    source: @image-url("../icons/bolt.svg");
                                    width: 11px;
                                    height: 11px;
                                    colorize: #f59e0b;
                                }
                            }

                            Text {
                                text: "Peak: " + root.peak_speed_text;
                                color: Theme.text_secondary;
                                font-size: 11px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Session total transferred pill
                    Rectangle {
                        background: Theme.sidebar_status_bg;
                        border-radius: 5px;
                        border-width: 1px;
                        border-color: Theme.sidebar_status_border;
                        height: 24px;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 5px;
                            alignment: center;

                            VerticalLayout {
                                alignment: center;
                                Image {
                                    source: @image-url("../icons/download.svg");
                                    width: 11px;
                                    height: 11px;
                                    colorize: #a855f7;
                                }
                            }

                            Text {
                                text: "Session: " + root.session_downloaded_text;
                                color: Theme.text_secondary;
                                font-size: 11px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Diagnostics Tool Pill Button
                    Rectangle {
                        background: diag_touch.has_hover ? (Theme.is_dark ? #2e1065 : #f3e8ff) : Theme.sidebar_status_bg;
                        border-radius: 5px;
                        border-width: 1px;
                        border-color: Theme.is_dark ? #7c3aed : #c084fc;
                        height: 24px;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 5px;
                            alignment: center;

                            VerticalLayout {
                                alignment: center;
                                Image {
                                    source: @image-url("../icons/bolt.svg");
                                    width: 11px;
                                    height: 11px;
                                    colorize: Theme.brand_purple;
                                }
                            }

                            Text {
                                text: "Diagnostics";
                                color: Theme.brand_purple;
                                font-size: 11px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }

                        diag_touch := TouchArea {
                            clicked => { root.open_network_diagnostics(); }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;

                    // Graph View Modes: Bars | Area | Stats
                    HorizontalLayout {
                        spacing: 2px;
                        alignment: center;

                        Rectangle {
                            background: root.speed_graph_mode == 0 ? Theme.brand_purple : (Theme.is_dark ? #1e293b : #e2e8f0);
                            border-radius: 4px;
                            height: 22px;
                            width: 36px;
                            Text {
                                text: "Bars";
                                color: root.speed_graph_mode == 0 ? #ffffff : Theme.text_secondary;
                                font-size: 10px;
                                font-weight: 700;
                                x: (parent.width - self.width) / 2;
                                vertical-alignment: center;
                            }
                            TouchArea {
                                clicked => { root.speed_graph_mode = 0; }
                            }
                        }

                        Rectangle {
                            background: root.speed_graph_mode == 1 ? Theme.brand_purple : (Theme.is_dark ? #1e293b : #e2e8f0);
                            border-radius: 4px;
                            height: 22px;
                            width: 36px;
                            Text {
                                text: "Area";
                                color: root.speed_graph_mode == 1 ? #ffffff : Theme.text_secondary;
                                font-size: 10px;
                                font-weight: 700;
                                x: (parent.width - self.width) / 2;
                                vertical-alignment: center;
                            }
                            TouchArea {
                                clicked => { root.speed_graph_mode = 1; }
                            }
                        }

                        Rectangle {
                            background: root.speed_graph_mode == 2 ? Theme.brand_purple : (Theme.is_dark ? #1e293b : #e2e8f0);
                            border-radius: 4px;
                            height: 22px;
                            width: 36px;
                            Text {
                                text: "Stats";
                                color: root.speed_graph_mode == 2 ? #ffffff : Theme.text_secondary;
                                font-size: 10px;
                                font-weight: 700;
                                x: (parent.width - self.width) / 2;
                                vertical-alignment: center;
                            }
                            TouchArea {
                                clicked => { root.speed_graph_mode = 2; }
                            }
                        }
                    }

                    // Bandwidth Limiter Presets
                    HorizontalLayout {
                        spacing: 2px;
                        alignment: center;

                        Text {
                            text: "Cap:";
                            color: Theme.text_muted;
                            font-size: 11px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }

                        Rectangle {
                            background: root.selected_speed_limit_index == 0 ? Theme.brand_purple : (Theme.is_dark ? #1e293b : #e2e8f0);
                            border-radius: 4px;
                            height: 22px;
                            width: 34px;
                            Text {
                                text: "Max";
                                color: root.selected_speed_limit_index == 0 ? #ffffff : Theme.text_secondary;
                                font-size: 10px;
                                font-weight: 700;
                                x: (parent.width - self.width) / 2;
                                vertical-alignment: center;
                            }
                            TouchArea {
                                clicked => {
                                    root.show_custom_speed_dialog = false;
                                    root.set_speed_limit(0);
                                }
                            }
                        }

                        Rectangle {
                            background: root.selected_speed_limit_index == 1 ? Theme.brand_purple : (Theme.is_dark ? #1e293b : #e2e8f0);
                            border-radius: 4px;
                            height: 22px;
                            width: 28px;
                            Text {
                                text: "2M";
                                color: root.selected_speed_limit_index == 1 ? #ffffff : Theme.text_secondary;
                                font-size: 10px;
                                font-weight: 700;
                                x: (parent.width - self.width) / 2;
                                vertical-alignment: center;
                            }
                            TouchArea {
                                clicked => {
                                    root.show_custom_speed_dialog = false;
                                    root.set_speed_limit(1);
                                }
                            }
                        }

                        Rectangle {
                            background: root.selected_speed_limit_index == 2 ? Theme.brand_purple : (Theme.is_dark ? #1e293b : #e2e8f0);
                            border-radius: 4px;
                            height: 22px;
                            width: 28px;
                            Text {
                                text: "5M";
                                color: root.selected_speed_limit_index == 2 ? #ffffff : Theme.text_secondary;
                                font-size: 10px;
                                font-weight: 700;
                                x: (parent.width - self.width) / 2;
                                vertical-alignment: center;
                            }
                            TouchArea {
                                clicked => {
                                    root.show_custom_speed_dialog = false;
                                    root.set_speed_limit(2);
                                }
                            }
                        }

                        Rectangle {
                            background: root.selected_speed_limit_index == 3 ? Theme.brand_purple : (Theme.is_dark ? #1e293b : #e2e8f0);
                            border-radius: 4px;
                            height: 22px;
                            width: 32px;
                            Text {
                                text: "10M";
                                color: root.selected_speed_limit_index == 3 ? #ffffff : Theme.text_secondary;
                                font-size: 10px;
                                font-weight: 700;
                                x: (parent.width - self.width) / 2;
                                vertical-alignment: center;
                            }
                            TouchArea {
                                clicked => {
                                    root.show_custom_speed_dialog = false;
                                    root.set_speed_limit(3);
                                }
                            }
                        }

                        Rectangle {
                            background: root.selected_speed_limit_index == 4 ? Theme.brand_purple : (Theme.is_dark ? #1e293b : #e2e8f0);
                            border-radius: 4px;
                            height: 22px;
                            width: 32px;
                            Text {
                                text: "20M";
                                color: root.selected_speed_limit_index == 4 ? #ffffff : Theme.text_secondary;
                                font-size: 10px;
                                font-weight: 700;
                                x: (parent.width - self.width) / 2;
                                vertical-alignment: center;
                            }
                            TouchArea {
                                clicked => {
                                    root.show_custom_speed_dialog = false;
                                    root.set_speed_limit(4);
                                }
                            }
                        }

                        // Custom Cap Button
                        Rectangle {
                            background: (root.selected_speed_limit_index == 5 || root.show_custom_speed_dialog) ? Theme.brand_purple : (Theme.is_dark ? #1e293b : #e2e8f0);
                            border-radius: 4px;
                            height: 22px;
                            width: 44px;
                            Text {
                                text: "Custom";
                                color: (root.selected_speed_limit_index == 5 || root.show_custom_speed_dialog) ? #ffffff : Theme.text_secondary;
                                font-size: 10px;
                                font-weight: 700;
                                x: (parent.width - self.width) / 2;
                                vertical-alignment: center;
                            }
                            TouchArea {
                                clicked => {
                                    root.show_custom_speed_dialog = !root.show_custom_speed_dialog;
                                }
                            }
                        }
                    }

                    // Show/Hide Graph Button
                    ActionButton {
                        text: root.show_speed_graph ? "Hide" : "Show";
                        icon: root.show_speed_graph ? @image-url("../icons/x.svg") : @image-url("../icons/bolt.svg");
                        has_icon: true;
                        height: 22px;
                        clicked => {
                            root.show_speed_graph = !root.show_speed_graph;
                        }
                    }
                }
            }

            // Custom Speed Cap Input Row
            if root.show_custom_speed_dialog: HorizontalLayout {
                spacing: 8px;
                alignment: end;
                padding-right: 4px;

                Text {
                    text: "Enter Custom Throttling Cap:";
                    color: Theme.text_secondary;
                    font-size: 11px;
                    font-weight: 600;
                    vertical-alignment: center;
                }

                custom_edit := StyledInput {
                    text <=> root.custom_speed_input;
                    placeholder_text: "e.g. 1.5M, 500K, 30M";
                    width: 140px;
                    height: 26px;
                    custom_radius: 6px;
                    font_size: 11px;
                    accepted => {
                        root.set_custom_speed_limit(self.text);
                    }
                }

                ActionButton {
                    text: "Apply Cap";
                    height: 24px;
                    clicked => {
                        root.set_custom_speed_limit(custom_edit.text);
                    }
                }
            }

            // Real-time Visualizer Area
            if root.show_speed_graph: VerticalLayout {
                spacing: 3px;

                Rectangle {
                    background: Theme.graph_bg;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: Theme.graph_border;
                    height: 54px;
                    clip: true;

                    // Subtle background level guide lines
                    Rectangle {
                        y: parent.height * 0.28;
                        x: 0;
                        width: parent.width;
                        height: 1px;
                        background: Theme.is_dark ? #ffffff08 : #0000000a;
                    }
                    Rectangle {
                        y: parent.height * 0.62;
                        x: 0;
                        width: parent.width;
                        height: 1px;
                        background: Theme.is_dark ? #ffffff08 : #0000000a;
                    }

                    // Mode 0: Dynamic Bars View
                    if root.speed_graph_mode == 0: HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        padding-top: 4px;
                        padding-bottom: 4px;
                        spacing: 2px;

                        for sample in root.speed_samples: VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: end;

                            Rectangle {
                                height: Math.max(3px, sample.ratio * 44px);
                                border-top-left-radius: 1.5px;
                                border-top-right-radius: 1.5px;
                                border-bottom-left-radius: 1px;
                                border-bottom-right-radius: 1px;
                                background: sample.ratio > 0.7 ? (Theme.is_dark ? #38bdf8 : #0284c7) :
                                            sample.ratio > 0.4 ? (Theme.is_dark ? #60a5fa : #2563eb) :
                                            sample.ratio > 0.15 ? (Theme.is_dark ? #3b82f6 : #3b82f6) :
                                            sample.ratio > 0.01 ? (Theme.is_dark ? #2563eb : #60a5fa) :
                                            (Theme.is_dark ? #1a2032 : #e2e8f0);
                                animate height { duration: 120ms; }
                                animate background { duration: 120ms; }

                                // Glowing active cap
                                if sample.ratio > 0.05: Rectangle {
                                    y: 0;
                                    width: parent.width;
                                    height: 2px;
                                    border-top-left-radius: 1.5px;
                                    border-top-right-radius: 1.5px;
                                    background: #ffffff99;
                                }
                            }
                        }
                    }

                    // Mode 1: Stepped Wave Area View
                    if root.speed_graph_mode == 1: HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        padding-top: 4px;
                        padding-bottom: 4px;
                        spacing: 0px; // Seamless wave flow

                        for sample in root.speed_samples: VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: end;

                            Rectangle {
                                height: Math.max(2px, sample.ratio * 45px);
                                background: sample.ratio > 0.6 ? (Theme.is_dark ? #38bdf888 : #0284c788) :
                                            sample.ratio > 0.3 ? (Theme.is_dark ? #60a5fa77 : #2563eb77) :
                                            sample.ratio > 0.05 ? (Theme.is_dark ? #3b82f666 : #3b82f666) :
                                            (Theme.is_dark ? #1a203244 : #e2e8f066);
                                animate height { duration: 100ms; }

                                // Illuminated Top Crest
                                Rectangle {
                                    y: 0;
                                    width: parent.width;
                                    height: 2px;
                                    background: sample.ratio > 0.05 ? #38bdf8 : transparent;
                                }
                            }
                        }
                    }

                    // Mode 2: Compact Telemetry & Stability View
                    if root.speed_graph_mode == 2: HorizontalLayout {
                        padding: 6px;
                        spacing: 12px;

                        // Stat 1: Rolling 5s Average
                        Rectangle {
                            background: Theme.is_dark ? #172033 : #ffffff;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: Theme.inner_border;
                            horizontal-stretch: 1;

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                alignment: space-between;

                                VerticalLayout {
                                    alignment: center;
                                    Text {
                                        text: "5s Rolling Average";
                                        color: Theme.text_muted;
                                        font-size: 10px;
                                        font-weight: 600;
                                    }
                                    Text {
                                        text: root.avg_speed_text;
                                        color: #38bdf8;
                                        font-size: 15px;
                                        font-weight: 800;
                                    }
                                }
                            }
                        }

                        // Stat 2: Connection Stability
                        Rectangle {
                            background: Theme.is_dark ? #172033 : #ffffff;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: Theme.inner_border;
                            horizontal-stretch: 1;

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                alignment: space-between;

                                VerticalLayout {
                                    alignment: center;
                                    Text {
                                        text: "Connection Stability";
                                        color: Theme.text_muted;
                                        font-size: 10px;
                                        font-weight: 600;
                                    }
                                    Text {
                                        text: root.network_stability_text;
                                        color: root.network_stability_text == "Idle" ? Theme.text_muted : #10b981;
                                        font-size: 15px;
                                        font-weight: 800;
                                    }
                                }
                            }
                        }

                        // Stat 3: Bandwidth Limit Saturation (Clickable to Cycle Presets)
                        Rectangle {
                            background: cap_touch.has-hover ? (Theme.is_dark ? #1e293b : #f1f5f9) : (Theme.is_dark ? #172033 : #ffffff);
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: root.speed_limit_label != "" ? #f59e0b : (cap_touch.has-hover ? Theme.primary_border : Theme.inner_border);
                            horizontal-stretch: 1;
                            animate background { duration: 120ms; }
                            animate border-color { duration: 120ms; }

                            cap_touch := TouchArea {
                                clicked => {
                                    let next_idx = root.selected_speed_limit_index >= 4 ? 0 : (root.selected_speed_limit_index + 1);
                                    root.set_speed_limit(next_idx);
                                }
                            }

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                alignment: space-between;

                                VerticalLayout {
                                    alignment: center;
                                    HorizontalLayout {
                                        spacing: 4px;
                                        alignment: start;
                                        Text {
                                            text: "Active Bandwidth Cap";
                                            color: Theme.text_muted;
                                            font-size: 10px;
                                            font-weight: 600;
                                        }
                                        Text {
                                            text: "• Click";
                                            color: cap_touch.has-hover ? Theme.brand_purple : Theme.text_muted;
                                            font-size: 9px;
                                            font-weight: 700;
                                        }
                                    }
                                    Text {
                                        text: root.speed_limit_label != "" ? root.speed_limit_label : "Uncapped Max";
                                        color: root.speed_limit_label != "" ? #f59e0b : Theme.text_secondary;
                                        font-size: 15px;
                                        font-weight: 800;
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 24px;
                                        height: 24px;
                                        border-radius: 6px;
                                        background: root.speed_limit_label != "" ? (Theme.is_dark ? #78350f55 : #fef3c7) : (Theme.is_dark ? #1e293b : #f1f5f9);
                                        border-width: 1px;
                                        border-color: root.speed_limit_label != "" ? #f59e0b : Theme.inner_border;

                                        Image {
                                            source: @image-url("../icons/download.svg");
                                            width: 12px;
                                            height: 12px;
                                            colorize: root.speed_limit_label != "" ? #f59e0b : Theme.text_muted;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Horizontal Speed Limit Cap Guideline across Modes 0 & 1
                    if (root.speed_graph_mode == 0 || root.speed_graph_mode == 1) && root.speed_limit_ratio > 0.05 && root.speed_limit_ratio <= 1.0: Rectangle {
                        y: parent.height * (1.0 - root.speed_limit_ratio);
                        x: 0;
                        width: parent.width;
                        height: 1.5px;
                        background: #f43f5e;

                        Rectangle {
                            x: parent.width - 85px;
                            y: -14px;
                            height: 14px;
                            background: #f43f5ecc;
                            border-radius: 3px;
                            Text {
                                text: "Cap: " + root.speed_limit_label;
                                color: #ffffff;
                                font-size: 9px;
                                font-weight: 700;
                                x: 4px;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // Timeline markers (30-second rolling window)
                HorizontalLayout {
                    alignment: space-between;
                    padding-left: 10px;
                    padding-right: 10px;

                    Text {
                        text: "-30s";
                        color: Theme.text_muted;
                        font-size: 10px;
                        font-weight: 600;
                    }
                    Text {
                        text: "-20s";
                        color: Theme.text_muted;
                        font-size: 10px;
                        font-weight: 600;
                    }
                    Text {
                        text: "-10s";
                        color: Theme.text_muted;
                        font-size: 10px;
                        font-weight: 600;
                    }
                    Text {
                        text: "Now";
                        color: root.is_downloading_active ? #38bdf8 : Theme.text_muted;
                        font-size: 10px;
                        font-weight: 700;
                    }
                }
            }
        }
    }

    // Live Off-Peak Scheduler Banner
    if root.scheduler_active: Rectangle {
        background: Theme.is_dark ? #1e1b4b : #f5f3ff;
        border-radius: 10px;
        border-width: 1px;
        border-color: Theme.is_dark ? #4338ca : #c7d2fe;
        height: 42px;

        HorizontalLayout {
            padding-left: 14px;
            padding-right: 14px;
            alignment: space-between;

            HorizontalLayout {
                spacing: 10px;
                alignment: start;

                VerticalLayout {
                    alignment: center;
                    Image {
                        source: @image-url("../icons/moon.svg");
                        width: 16px;
                        height: 16px;
                        colorize: Theme.brand_purple;
                    }
                }

                Text {
                    text: root.scheduler_status_banner_text;
                    color: Theme.text_primary;
                    font-size: 12px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }

            VerticalLayout {
                alignment: center;
                ActionButton {
                    text: "Download All Now";
                    icon: @image-url("../icons/play.svg");
                    has_icon: true;
                    primary: true;
                    height: 28px;
                    clicked => { root.bypass_scheduler_now(); }
                }
            }
        }
    }

    // Queue Toolbar
    HorizontalLayout {
        alignment: space-between;

        Text {
            text: "Queue (" + root.total_queue_count + " jobs)";
            color: Theme.text_secondary;
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
        }

        HorizontalLayout {
            spacing: 8px;

            ActionButton {
                text: "Pause All";
                icon: @image-url("../icons/pause.svg");
                has_icon: true;
                height: 32px;
                clicked => { root.pause_all(); }
            }

            ActionButton {
                text: "Resume All";
                icon: @image-url("../icons/play.svg");
                has_icon: true;
                height: 32px;
                clicked => { root.resume_all(); }
            }

            ActionButton {
                text: "Cancel All";
                icon: @image-url("../icons/x.svg");
                has_icon: true;
                danger: true;
                height: 32px;
                clicked => { root.cancel_all(); }
            }

            ActionButton {
                text: "Clear Finished";
                icon: @image-url("../icons/broom.svg");
                has_icon: true;
                height: 32px;
                clicked => { root.clear_completed(); }
            }

            ActionButton {
                text: "Clear Failed";
                icon: @image-url("../icons/trash.svg");
                has_icon: true;
                height: 32px;
                clicked => { root.clear_failed(); }
            }
        }
    }

    // Search & Filter Toolbar
    HorizontalLayout {
        spacing: 12px;

        queue_search := SearchField {
            placeholder_text: "Search active or queued downloads by title or URL...";
            horizontal-stretch: 1;
            text <=> root.queue_search_query;
            edited(q) => {
                root.queue_search_query = q;
                root.search_queue(q);
            }
            cleared => {
                root.queue_search_query = "";
                root.search_queue("");
            }
        }

        ActionButton {
            text: root.selected_downloads_count > 0 && root.selected_downloads_count == root.download_items.length ? "Deselect All" : "Select All";
            icon: @image-url("../icons/check.svg");
            has_icon: true;
            height: 36px;
            enabled: root.download_items.length > 0;
            clicked => {
                if (root.selected_downloads_count > 0 && root.selected_downloads_count == root.download_items.length) {
                    root.select_all_downloads(false);
                } else {
                    root.select_all_downloads(true);
                }
            }
        }
    }

    HorizontalLayout {
        spacing: 8px;
        alignment: start;

        IconChip {
            text: "All";
            selected: root.queue_filter_index == 0;
            clicked => {
                root.queue_filter_index = 0;
                root.set_queue_filter(0);
            }
        }
        IconChip {
            text: "Downloading";
            icon: @image-url("../icons/download.svg");
            has_icon: true;
            selected: root.queue_filter_index == 1;
            clicked => {
                root.queue_filter_index = 1;
                root.set_queue_filter(1);
            }
        }
        IconChip {
            text: "Queued";
            icon: @image-url("../icons/history.svg");
            has_icon: true;
            selected: root.queue_filter_index == 2;
            clicked => {
                root.queue_filter_index = 2;
                root.set_queue_filter(2);
            }
        }
        IconChip {
            text: "Paused";
            icon: @image-url("../icons/pause.svg");
            has_icon: true;
            selected: root.queue_filter_index == 3;
            clicked => {
                root.queue_filter_index = 3;
                root.set_queue_filter(3);
            }
        }
        IconChip {
            text: "Completed";
            icon: @image-url("../icons/check.svg");
            has_icon: true;
            selected: root.queue_filter_index == 4;
            clicked => {
                root.queue_filter_index = 4;
                root.set_queue_filter(4);
            }
        }
        IconChip {
            text: "Failed";
            icon: @image-url("../icons/x.svg");
            has_icon: true;
            selected: root.queue_filter_index == 5;
            clicked => {
                root.queue_filter_index = 5;
                root.set_queue_filter(5);
            }
        }
    }

    // Multi-Select Batch Actions Toolbar
    if root.selected_downloads_count > 0: Rectangle {
        background: Theme.is_dark ? #181d32 : #f5f3ff;
        border-radius: 10px;
        border-width: 1.5px;
        border-color: Theme.brand_purple;
        height: 48px;

        HorizontalLayout {
            padding-left: 14px;
            padding-right: 14px;
            alignment: space-between;

            HorizontalLayout {
                spacing: 10px;
                alignment: start;

                VerticalLayout {
                    alignment: center;
                    Image {
                        source: @image-url("../icons/check.svg");
                        width: 14px;
                        height: 14px;
                        colorize: Theme.brand_purple;
                    }
                }

                Text {
                    text: root.selected_downloads_count + (root.selected_downloads_count == 1 ? " download selected" : " downloads selected");
                    color: Theme.brand_purple;
                    font-size: 13px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: end;

                ActionButton {
                    text: "Pause";
                    icon: @image-url("../icons/pause.svg");
                    has_icon: true;
                    height: 30px;
                    clicked => { root.pause_selected(); }
                }

                ActionButton {
                    text: "Resume";
                    icon: @image-url("../icons/play.svg");
                    has_icon: true;
                    primary: true;
                    height: 30px;
                    clicked => { root.resume_selected(); }
                }

                ActionButton {
                    text: "Top Priority";
                    icon: @image-url("../icons/bolt.svg");
                    has_icon: true;
                    height: 30px;
                    clicked => { root.prioritize_selected(); }
                }

                ActionButton {
                    text: "Cancel";
                    icon: @image-url("../icons/x.svg");
                    has_icon: true;
                    danger: true;
                    height: 30px;
                    clicked => { root.cancel_selected(); }
                }

                ActionButton {
                    text: "Deselect All";
                    height: 30px;
                    clicked => { root.select_all_downloads(false); }
                }
            }
        }
    }

    // If no downloads in current view
    if root.download_items.length == 0: Rectangle {
        background: Theme.card_bg;
        border-radius: 12px;
        border-width: 1px;
        border-color: Theme.card_border;
        vertical-stretch: 1;

        VerticalLayout {
            alignment: center;
            spacing: 14px;

            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 48px;
                    height: 48px;
                    border-radius: 24px;
                    background: Theme.sidebar_brand_bg;
                    border-width: 1px;
                    border-color: Theme.sidebar_brand_border;

                    Image {
                        source: (root.queue_filter_index != 0 || root.queue_search_query != "") ? @image-url("../icons/search.svg") : @image-url("../icons/download.svg");
                        width: 22px;
                        height: 22px;
                        colorize: Theme.brand_purple;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }
            }

            VerticalLayout {
                spacing: 5px;
                Text {
                    text: (root.queue_filter_index != 0 || root.queue_search_query != "") ? "No matching downloads found" : "No active downloads";
                    color: Theme.text_primary;
                    font-size: 15px;
                    font-weight: 700;
                    horizontal-alignment: center;
                }
                Text {
                    text: (root.queue_filter_index != 0 || root.queue_search_query != "") ? "Try selecting 'All' or clearing your search query above." : "Downloads in progress, paused, or queued will appear here.";
                    color: Theme.text_secondary;
                    font-size: 13px;
                    horizontal-alignment: center;
                }
            }
        }
    }

    // If downloads exist in queue
    if root.download_items.length > 0: ScrollView {
        vertical-stretch: 1;

        VerticalLayout {
            alignment: start;
            spacing: 10px;
            padding-bottom: 12px;

            for item in root.download_items: Rectangle {
                min-height: 108px;
                background: item.selected ? (Theme.is_dark ? #1e1b4b : #f5f3ff) : (touch.has-hover ? Theme.card_hover : Theme.card_bg);
                border-radius: 12px;
                border-width: item.selected ? 1.5px : 1px;
                border-color: item.selected ? Theme.brand_purple : (touch.has-hover ? Theme.primary_border : Theme.card_border);
                animate background { duration: 150ms; }
                animate border-color { duration: 150ms; }

                touch := TouchArea { }

                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 16px;
                    padding-top: 13px;
                    padding-bottom: 13px;
                    spacing: 14px;

                    // Left Column: Checkbox + Thumbnail Preview (or Icon Badge fallback)
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;

                        // Checkbox (top-aligned)
                        VerticalLayout {
                            alignment: start;
                            padding-top: 8px;

                            Rectangle {
                                width: 20px;
                                height: 20px;
                                border-radius: 6px;
                                border-width: 1.5px;
                                border-color: item.selected ? Theme.brand_purple : (cb_touch.has-hover ? Theme.brand_purple : (Theme.is_dark ? #475569 : #cbd5e1));
                                background: item.selected ? Theme.brand_purple : (cb_touch.has-hover ? Theme.card_hover : Theme.inner_bg);
                                animate background { duration: 120ms; }
                                animate border-color { duration: 120ms; }

                                if item.selected: Image {
                                    source: @image-url("../icons/check.svg");
                                    width: 11px;
                                    height: 11px;
                                    colorize: #ffffff;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }

                                cb_touch := TouchArea {
                                    clicked => {
                                        root.toggle_download_selected(item.id);
                                    }
                                }
                            }
                        }

                        // Thumbnail Preview with Status Overlay Badge
                        VerticalLayout {
                            alignment: start;

                            if item.has_thumbnail: Rectangle {
                                width: 86px;
                                height: 54px;
                                border-radius: 8px;
                                clip: true;
                                background: Theme.is_dark ? #0f172a : #e2e8f0;
                                border-width: 1px;
                                border-color: Theme.is_dark ? #1e293b : #cbd5e1;

                                // Thumbnail image (fill the container)
                                Image {
                                    source: item.thumbnail_image;
                                    width: parent.width;
                                    height: parent.height;
                                    image-fit: cover;
                                }

                                // Status badge overlay (bottom-right corner)
                                Rectangle {
                                    x: parent.width - self.width - 3px;
                                    y: parent.height - self.height - 3px;
                                    width: 22px;
                                    height: 22px;
                                    border-radius: 6px;
                                    background: item.status == "Completed" ? (Theme.is_dark ? #064e3bdd : #dcfce7ee) :
                                                item.status == "Downloading" ? (Theme.is_dark ? #0f172add : #e0f2feee) :
                                                item.status == "Paused" ? (Theme.is_dark ? #451a03dd : #fef3c7ee) :
                                                item.status == "Failed" ? (Theme.is_dark ? #450a0add : #fee2e2ee) :
                                                item.status == "Retrying" ? (Theme.is_dark ? #451a03dd : #ffedd5ee) :
                                                item.status == "Scheduled" ? (Theme.is_dark ? #2e1065dd : #ede9feee) :
                                                (Theme.is_dark ? #1e1b4bdd : #f3e8ffee);
                                    border-width: 1px;
                                    border-color: item.status == "Completed" ? (Theme.is_dark ? #10b981 : #86efac) :
                                                  item.status == "Downloading" ? (Theme.is_dark ? #3b82f6 : #7dd3fc) :
                                                  item.status == "Paused" ? (Theme.is_dark ? #f59e0b : #fde68a) :
                                                  item.status == "Failed" ? (Theme.is_dark ? #ef4444 : #fca5a5) :
                                                  item.status == "Retrying" ? (Theme.is_dark ? #f97316 : #fdba74) :
                                                  item.status == "Scheduled" ? (Theme.is_dark ? #8b5cf6 : #c4b5fd) : (Theme.is_dark ? #8b5cf6 : #c4b5fd);

                                    Image {
                                        source: item.status == "Completed" ? @image-url("../icons/check.svg") :
                                                item.status == "Downloading" ? @image-url("../icons/download.svg") :
                                                item.status == "Paused" ? @image-url("../icons/pause.svg") :
                                                item.status == "Failed" ? @image-url("../icons/x.svg") :
                                                item.status == "Retrying" ? @image-url("../icons/refresh.svg") :
                                                item.status == "Scheduled" ? @image-url("../icons/moon.svg") :
                                                @image-url("../icons/history.svg");
                                        width: 12px;
                                        height: 12px;
                                        colorize: item.status == "Completed" ? (Theme.is_dark ? #10b981 : #059669) :
                                                  item.status == "Downloading" ? (Theme.is_dark ? #38bdf8 : #0284c7) :
                                                  item.status == "Paused" ? (Theme.is_dark ? #f59e0b : #d97706) :
                                                  item.status == "Failed" ? (Theme.is_dark ? #ef4444 : #dc2626) :
                                                  item.status == "Retrying" ? (Theme.is_dark ? #f97316 : #ea580c) :
                                                  item.status == "Scheduled" ? (Theme.is_dark ? #8b5cf6 : #7c3aed) : (Theme.is_dark ? #a855f7 : #7c3aed);
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                    }
                                }
                            }

                            // Fallback: Status icon badge (no thumbnail available)
                            if !item.has_thumbnail: Rectangle {
                                width: 36px;
                                height: 36px;
                                border-radius: 9px;
                                background: item.status == "Completed" ? (Theme.is_dark ? #064e3b : #dcfce7) :
                                            item.status == "Downloading" ? (Theme.is_dark ? #1e293b : #e0f2fe) :
                                            item.status == "Paused" ? (Theme.is_dark ? #451a03 : #fef3c7) :
                                            item.status == "Failed" ? (Theme.is_dark ? #450a0a : #fee2e2) :
                                            item.status == "Retrying" ? (Theme.is_dark ? #451a03 : #ffedd5) :
                                            item.status == "Scheduled" ? (Theme.is_dark ? #2e1065 : #ede9fe) :
                                            (Theme.is_dark ? #1e1b4b : #f3e8ff);
                                border-width: 1px;
                                border-color: item.status == "Completed" ? (Theme.is_dark ? #10b981 : #86efac) :
                                              item.status == "Downloading" ? (Theme.is_dark ? #3b82f6 : #7dd3fc) :
                                              item.status == "Paused" ? (Theme.is_dark ? #f59e0b : #fde68a) :
                                              item.status == "Failed" ? (Theme.is_dark ? #ef4444 : #fca5a5) :
                                              item.status == "Retrying" ? (Theme.is_dark ? #f97316 : #fdba74) :
                                              item.status == "Scheduled" ? (Theme.is_dark ? #8b5cf6 : #c4b5fd) : (Theme.is_dark ? #8b5cf6 : #c4b5fd);

                                Image {
                                    source: item.status == "Completed" ? @image-url("../icons/check.svg") :
                                            item.status == "Downloading" ? @image-url("../icons/download.svg") :
                                            item.status == "Paused" ? @image-url("../icons/pause.svg") :
                                            item.status == "Failed" ? @image-url("../icons/x.svg") :
                                            item.status == "Retrying" ? @image-url("../icons/refresh.svg") :
                                            item.status == "Scheduled" ? @image-url("../icons/moon.svg") :
                                            @image-url("../icons/history.svg");
                                    width: 16px;
                                    height: 16px;
                                    colorize: item.status == "Completed" ? (Theme.is_dark ? #10b981 : #059669) :
                                              item.status == "Downloading" ? (Theme.is_dark ? #38bdf8 : #0284c7) :
                                              item.status == "Paused" ? (Theme.is_dark ? #f59e0b : #d97706) :
                                              item.status == "Failed" ? (Theme.is_dark ? #ef4444 : #dc2626) :
                                              item.status == "Retrying" ? (Theme.is_dark ? #f97316 : #ea580c) :
                                              item.status == "Scheduled" ? (Theme.is_dark ? #8b5cf6 : #7c3aed) : (Theme.is_dark ? #a855f7 : #7c3aed);
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }
                            }
                        }
                    }

                    // Right Content Column (All rows indented together!)
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 8px;
                        alignment: start;

                        // Row 1: Header (Title + Badges on Left | Action Buttons on Right)
                        HorizontalLayout {
                            alignment: space-between;
                            spacing: 12px;

                            VerticalLayout {
                                spacing: 4px;
                                horizontal-stretch: 1;
                                alignment: center;

                                Text {
                                    text: item.title;
                                    color: Theme.text_primary;
                                    font-size: 14px;
                                    font-weight: 700;
                                    overflow: elide;
                                }

                                HorizontalLayout {
                                    spacing: 6px;
                                    alignment: start;

                                    // Source Platform Pill
                                    if item.source_platform != "": Rectangle {
                                        height: 18px;
                                        border-radius: 4px;
                                        border-width: 1px;
                                        background: item.source_platform == "YouTube" ? (Theme.is_dark ? #450a0a : #fef2f2) :
                                                    item.source_platform == "Bilibili" ? (Theme.is_dark ? #082f49 : #f0f9ff) :
                                                    item.source_platform == "KissKH" ? (Theme.is_dark ? #042f2e : #f0fdfa) :
                                                    item.source_platform == "Dailymotion" ? (Theme.is_dark ? #0f172a : #f8fafc) :
                                                    item.source_platform == "TikTok" ? (Theme.is_dark ? #18181b : #fdf2f8) :
                                                    item.source_platform == "Vimeo" ? (Theme.is_dark ? #082f49 : #f0f9ff) :
                                                    item.source_platform == "Reddit" ? (Theme.is_dark ? #431407 : #fff7ed) :
                                                    item.source_platform == "Pinterest" ? (Theme.is_dark ? #450a0a : #fef2f2) :
                                                    item.source_platform == "Threads" ? (Theme.is_dark ? #18181b : #f4f4f5) :
                                                    (Theme.is_dark ? #1e1b4b : #f5f3ff);
                                        border-color: item.source_platform == "YouTube" ? (Theme.is_dark ? #991b1b : #fca5a5) :
                                                      item.source_platform == "Bilibili" ? (Theme.is_dark ? #0369a1 : #bae6fd) :
                                                      item.source_platform == "KissKH" ? (Theme.is_dark ? #115e59 : #99f6e4) :
                                                      item.source_platform == "Dailymotion" ? (Theme.is_dark ? #334155 : #cbd5e1) :
                                                      item.source_platform == "TikTok" ? (Theme.is_dark ? #f43f5e : #fbcfe8) :
                                                      item.source_platform == "Vimeo" ? (Theme.is_dark ? #0284c7 : #7dd3fc) :
                                                      item.source_platform == "Reddit" ? (Theme.is_dark ? #ea580c : #fed7aa) :
                                                      item.source_platform == "Pinterest" ? (Theme.is_dark ? #dc2626 : #fca5a5) :
                                                      item.source_platform == "Threads" ? (Theme.is_dark ? #52525b : #d4d4d8) :
                                                      (Theme.is_dark ? #4338ca : #ddd6fe);

                                        HorizontalLayout {
                                            padding-left: 6px;
                                            padding-right: 6px;
                                            alignment: center;
                                            Text {
                                                text: item.source_platform;
                                                color: item.source_platform == "YouTube" ? (Theme.is_dark ? #f87171 : #dc2626) :
                                                       item.source_platform == "Bilibili" ? (Theme.is_dark ? #38bdf8 : #0284c7) :
                                                       item.source_platform == "KissKH" ? (Theme.is_dark ? #2dd4bf : #0d9488) :
                                                       item.source_platform == "Dailymotion" ? (Theme.is_dark ? #94a3b8 : #334155) :
                                                       item.source_platform == "TikTok" ? (Theme.is_dark ? #fb7185 : #e11d48) :
                                                       item.source_platform == "Vimeo" ? (Theme.is_dark ? #38bdf8 : #0284c7) :
                                                       item.source_platform == "Reddit" ? (Theme.is_dark ? #fb923c : #ea580c) :
                                                       item.source_platform == "Pinterest" ? (Theme.is_dark ? #f87171 : #dc2626) :
                                                       item.source_platform == "Threads" ? (Theme.is_dark ? #e4e4e7 : #18181b) :
                                                       (Theme.is_dark ? #a78bfa : #7c3aed);
                                                font-size: 10px;
                                                font-weight: 700;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    // Quality Badge Pill
                                    if item.quality_badge != "": Rectangle {
                                        height: 18px;
                                        border-radius: 4px;
                                        border-width: 1px;
                                        background: Theme.is_dark ? #1e1b4b : #eef2ff;
                                        border-color: Theme.is_dark ? #3730a3 : #c7d2fe;

                                        HorizontalLayout {
                                            padding-left: 6px;
                                            padding-right: 6px;
                                            alignment: center;

                                            Text {
                                                text: item.quality_badge;
                                                color: Theme.is_dark ? #a5b4fc : #4f46e5;
                                                font-size: 10px;
                                                font-weight: 700;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    // Format Badge Pill
                                    if item.format_badge != "": Rectangle {
                                        height: 18px;
                                        border-radius: 4px;
                                        border-width: 1px;
                                        background: Theme.is_dark ? #1e293b : #f1f5f9;
                                        border-color: Theme.is_dark ? #334155 : #cbd5e1;

                                        HorizontalLayout {
                                            padding-left: 6px;
                                            padding-right: 6px;
                                            alignment: center;

                                            Text {
                                                text: item.format_badge;
                                                color: Theme.is_dark ? #94a3b8 : #475569;
                                                font-size: 10px;
                                                font-weight: 700;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    // Status Pill (with proper Light & Dark mode colors)
                                    Rectangle {
                                        background: item.status == "Completed" ? (Theme.is_dark ? #064e3b : #ecfdf5) :
                                                    item.status == "Paused" ? (Theme.is_dark ? #331e08 : #fffbeb) :
                                                    item.status == "Downloading" ? (Theme.is_dark ? #0f2142 : #eff6ff) :
                                                    item.status == "Retrying" ? (Theme.is_dark ? #431407 : #fff7ed) :
                                                    item.status == "Scheduled" ? (Theme.is_dark ? #2e1065 : #faf5ff) :
                                                    item.status == "Queued" ? (Theme.is_dark ? #25103a : #f5f3ff) :
                                                    (Theme.is_dark ? #331317 : #fef2f2);
                                        border-radius: 4px;
                                        border-width: 1px;
                                        border-color: item.status == "Completed" ? (Theme.is_dark ? #166534 : #a7f3d0) :
                                                      item.status == "Paused" ? (Theme.is_dark ? #b45309 : #fde68a) :
                                                      item.status == "Downloading" ? (Theme.is_dark ? #2563eb : #bfdbfe) :
                                                      item.status == "Retrying" ? (Theme.is_dark ? #ea580c : #fed7aa) :
                                                      item.status == "Scheduled" ? (Theme.is_dark ? #7c3aed : #e9d5ff) :
                                                      item.status == "Queued" ? (Theme.is_dark ? #7e22ce : #ddd6fe) :
                                                      (Theme.is_dark ? #991b1b : #fecaca);
                                        height: 18px;

                                        HorizontalLayout {
                                            padding-left: 6px;
                                            padding-right: 6px;
                                            alignment: center;

                                            Text {
                                                text: item.status;
                                                color: item.status == "Completed" ? (Theme.is_dark ? #4ade80 : #059669) :
                                                       item.status == "Paused" ? (Theme.is_dark ? #fcd34d : #d97706) :
                                                       item.status == "Downloading" ? (Theme.is_dark ? #60a5fa : #2563eb) :
                                                       item.status == "Retrying" ? (Theme.is_dark ? #fb923c : #ea580c) :
                                                       item.status == "Scheduled" ? (Theme.is_dark ? #c084fc : #7c3aed) :
                                                       item.status == "Queued" ? (Theme.is_dark ? #c084fc : #7c3aed) :
                                                       (Theme.is_dark ? #f87171 : #dc2626);
                                                font-size: 10px;
                                                font-weight: 700;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }

                        // Right: Action Buttons
                        HorizontalLayout {
                            spacing: 6px;
                            alignment: end;

                            if item.is_queued: ActionButton {
                                text: "⚡ Top";
                                has_icon: false;
                                height: 28px;
                                clicked => { root.prioritize_job(item.id); }
                            }

                            if item.can_move_up: ActionButton {
                                text: "▲";
                                has_icon: false;
                                height: 28px;
                                clicked => { root.move_job_up(item.id); }
                            }

                            if item.can_move_down: ActionButton {
                                text: "▼";
                                has_icon: false;
                                height: 28px;
                                clicked => { root.move_job_down(item.id); }
                            }

                            if item.is_completed: ActionButton {
                                text: "Play";
                                icon: @image-url("../icons/play.svg");
                                has_icon: true;
                                primary: true;
                                height: 28px;
                                clicked => { root.open_download_file(item.output_path); }
                            }

                            if item.is_completed: ActionButton {
                                text: "Audio";
                                icon: @image-url("../icons/music.svg");
                                has_icon: true;
                                height: 28px;
                                clicked => { root.open_converter(item.output_path, item.title); }
                            }

                            if item.is_completed: ActionButton {
                                text: "Finder";
                                icon: @image-url("../icons/folder.svg");
                                has_icon: true;
                                height: 28px;
                                clicked => { root.open_download_folder(item.output_path); }
                            }

                            if item.can_pause: ActionButton {
                                text: "Pause";
                                icon: @image-url("../icons/pause.svg");
                                has_icon: true;
                                height: 28px;
                                clicked => { root.pause_download(item.id); }
                            }

                            if item.can_resume: ActionButton {
                                text: item.status == "Scheduled" ? "Start Now" : (item.status == "Retrying" ? "Retry Now" : "Resume");
                                icon: item.status == "Retrying" ? @image-url("../icons/refresh.svg") : @image-url("../icons/play.svg");
                                has_icon: true;
                                height: 28px;
                                clicked => { root.resume_download(item.id); }
                            }

                            if item.can_cancel: ActionButton {
                                text: "Cancel";
                                icon: @image-url("../icons/x.svg");
                                has_icon: true;
                                danger: true;
                                height: 28px;
                                clicked => { root.cancel_download(item.id); }
                            }
                        }
                    }

                    // Row 2: Live Activity & Destination Preview
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: space-between;

                        // Left: Live Stream / Download Phase
                        HorizontalLayout {
                            spacing: 6px;
                            alignment: start;
                            horizontal-stretch: 1;

                            VerticalLayout {
                                alignment: center;
                                Image {
                                    source: item.status == "Downloading" ? @image-url("../icons/bolt.svg") :
                                            item.status == "Completed" ? @image-url("../icons/check.svg") :
                                            item.status == "Paused" ? @image-url("../icons/pause.svg") :
                                            item.status == "Retrying" ? @image-url("../icons/refresh.svg") :
                                            item.status == "Scheduled" ? @image-url("../icons/moon.svg") :
                                            @image-url("../icons/history.svg");
                                    width: 12px;
                                    height: 12px;
                                    colorize: item.status == "Downloading" ? (Theme.is_dark ? #38bdf8 : #0284c7) :
                                              item.status == "Completed" ? #10b981 :
                                              item.status == "Paused" ? #f59e0b :
                                              item.status == "Retrying" ? #f97316 :
                                              item.status == "Scheduled" ? #8b5cf6 : Theme.text_muted;
                                }
                            }

                            Text {
                                text: item.detail_status;
                                color: item.status == "Downloading" ? (Theme.is_dark ? #38bdf8 : #0284c7) :
                                       item.status == "Completed" ? (Theme.is_dark ? #34d399 : #059669) :
                                       item.status == "Paused" ? #f59e0b :
                                       item.status == "Retrying" ? #f97316 :
                                       item.status == "Scheduled" ? #8b5cf6 : Theme.text_secondary;
                                font-size: 12px;
                                font-weight: 600;
                                overflow: elide;
                                vertical-alignment: center;
                            }
                        }

                        // Right: Destination Path Preview (Clickable to open folder)
                        if item.destination_display != "": Rectangle {
                            background: dest_touch.has-hover ? (Theme.is_dark ? #1e293b : #e2e8f0) : Colors.transparent;
                            border-radius: 4px;
                            animate background { duration: 120ms; }

                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;
                                padding-top: 2px;
                                padding-bottom: 2px;
                                spacing: 5px;
                                alignment: end;

                                VerticalLayout {
                                    alignment: center;
                                    Image {
                                        source: @image-url("../icons/folder.svg");
                                        width: 11px;
                                        height: 11px;
                                        colorize: dest_touch.has-hover ? Theme.brand_purple : Theme.text_muted;
                                    }
                                }

                                Text {
                                    text: item.destination_display;
                                    color: dest_touch.has-hover ? Theme.brand_purple : Theme.text_muted;
                                    font-size: 11px;
                                    font-weight: 500;
                                    overflow: elide;
                                    vertical-alignment: center;
                                }
                            }

                            dest_touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.open_download_folder(item.output_path);
                                }
                            }
                        }
                    }

                    // Row 3: Smooth High-Contrast Progress Bar
                    ProgressBar {
                        progress: item.progress;
                        status: item.status;
                        height: 6px;
                    }

                    // Row 4: Progress text & Speed / ETA Telemetry
                    HorizontalLayout {
                        alignment: space-between;

                        Rectangle {
                            background: Theme.is_dark ? #0f172a : #f8fafc;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: Theme.is_dark ? #1e293b : #e2e8f0;
                            height: 20px;

                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;
                                spacing: 4px;
                                alignment: center;

                                VerticalLayout {
                                    alignment: center;
                                    Image {
                                        source: @image-url("../icons/package.svg");
                                        width: 10px;
                                        height: 10px;
                                        colorize: Theme.text_secondary;
                                    }
                                }

                                Text {
                                    text: item.size_text;
                                    color: Theme.text_secondary;
                                    font-size: 11px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: end;

                            // Mini Live Transfer Sparkline Wave
                            if item.status == "Downloading": Rectangle {
                                background: Theme.is_dark ? #0f172a : #f1f5f9;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: Theme.is_dark ? #1e293b : #e2e8f0;
                                height: 20px;

                                HorizontalLayout {
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    padding-top: 2px;
                                    padding-bottom: 2px;
                                    spacing: 2px;
                                    alignment: center;

                                    for sample in root.speed_samples: Rectangle {
                                        width: 2px;
                                        height: Math.max(3px, sample.ratio * 15px);
                                        border-radius: 1px;
                                        background: sample.ratio > 0.6 ? (Theme.is_dark ? #38bdf8 : #0284c7) :
                                                    sample.ratio > 0.25 ? (Theme.is_dark ? #60a5fa : #2563eb) :
                                                    (Theme.is_dark ? #334155 : #cbd5e1);
                                        animate height { duration: 100ms; }
                                    }
                                }
                            }

                            if item.status == "Downloading": Rectangle {
                                background: Theme.is_dark ? #0c2038 : #f0f9ff;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: Theme.is_dark ? #1e3a5f : #bae6fd;
                                height: 20px;

                                HorizontalLayout {
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    spacing: 4px;
                                    alignment: center;

                                    VerticalLayout {
                                        alignment: center;
                                        Image {
                                            source: @image-url("../icons/bolt.svg");
                                            width: 10px;
                                            height: 10px;
                                            colorize: Theme.is_dark ? #38bdf8 : #0284c7;
                                        }
                                    }

                                    Text {
                                        text: item.speed_text;
                                        color: Theme.is_dark ? #38bdf8 : #0284c7;
                                        font-size: 11px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            if item.status == "Downloading": Rectangle {
                                background: Theme.is_dark ? #172554 : #eff6ff;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: Theme.is_dark ? #1e40af : #bfdbfe;
                                height: 20px;

                                HorizontalLayout {
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    alignment: center;

                                    Text {
                                        text: "ETA: " + item.eta_text;
                                        color: Theme.is_dark ? #93c5fd : #2563eb;
                                        font-size: 11px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            if item.status != "Downloading": Text {
                                text: item.eta_text != "" ? item.eta_text : (item.status == "Completed" ? "Completed" : (item.status == "Paused" ? "Paused" : item.status));
                                color: item.status == "Retrying" ? #f97316 : (item.status == "Scheduled" ? #a855f7 : Theme.text_muted);
                                font-size: 12px;
                                font-weight: (item.status == "Retrying" || item.status == "Scheduled") ? 600 : 400;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
            }
        }
    }
}
