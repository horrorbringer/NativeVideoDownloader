import { ScrollView } from "std-widgets.slint";
import { ActionButton } from "../components/action_button.slint";
import { Theme } from "../theme.slint";

export component AboutTab inherits ScrollView {
    in-out property <string> app_name: "Native Video Downloader Pro";
    in-out property <string> app_version: "v0.2.1 (2026.09 Edition)";
    in-out property <string> host_os_info: "macOS (Apple Silicon / aarch64)";
    in-out property <string> ytdlp_version_text: "Detecting...";
    in-out property <string> ytdlp_path_text: "";
    in-out property <string> ffmpeg_version_text: "Detecting...";
    in-out property <string> ffmpeg_path_text: "";
    in-out property <string> media_player_text: "mpv (Subtitle auto-sync enabled)";
    in-out property <string> db_path_text: "~/.native_video_downloader/history.db";
    in-out property <string> download_directory: "~/Downloads";
    in-out property <string> app_update_status: "";
    in-out property <bool> is_checking_app_update: false;
    in-out property <bool> is_updating_engines: false;
    in-out property <string> engine_update_status: "";

    callback copy_diagnostics();
    callback open_logs();
    callback open_download_folder();
    callback open_external_url(string);
    callback check_engine_updates();
    callback refresh_engine_info();
    callback check_app_updates();

    vertical-stretch: 1;

    VerticalLayout {
        padding-right: 8px;
        padding-bottom: 24px;
        spacing: 16px;

        // 1. Hero Branding & Quick App Status Card
        Rectangle {
            background: Theme.card_bg;
            border-radius: 14px;
            border-width: 1px;
            border-color: Theme.card_border;

            VerticalLayout {
                padding: 20px;
                spacing: 16px;

                HorizontalLayout {
                    spacing: 18px;
                    alignment: start;

                    // App Logo Squircle
                    Rectangle {
                        width: 68px;
                        height: 68px;
                        border-radius: 16px;
                        background: Theme.is_dark ? #2e1065 : #4f46e5;
                        border-width: 1.5px;
                        border-color: Theme.is_dark ? #6366f1 : #818cf8;

                        VerticalLayout {
                            alignment: center;
                            Image {
                                source: @image-url("../icons/sparkles.svg");
                                width: 34px;
                                height: 34px;
                                colorize: #ffffff;
                                horizontal-alignment: center;
                            }
                        }
                    }

                    // Title, Version & Pitch
                    VerticalLayout {
                        spacing: 6px;
                        horizontal-stretch: 1;

                        HorizontalLayout {
                            spacing: 10px;
                            alignment: start;

                            Text {
                                text: root.app_name;
                                color: Theme.text_primary;
                                font-size: 21px;
                                font-weight: 800;
                                vertical-alignment: center;
                            }

                            // Current Version Pill
                            Rectangle {
                                height: 24px;
                                border-radius: 12px;
                                background: Theme.is_dark ? #1e1b4b : #eef2ff;
                                border-width: 1px;
                                border-color: Theme.is_dark ? #3730a3 : #c7d2fe;

                                HorizontalLayout {
                                    padding-left: 9px;
                                    padding-right: 9px;
                                    alignment: center;
                                    Text {
                                        text: root.app_version;
                                        color: Theme.is_dark ? #a5b4fc : #4f46e5;
                                        font-size: 11px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            // Interactive In-App Update Trigger Pill
                            Rectangle {
                                height: 24px;
                                border-radius: 12px;
                                background: check_app_btn.has-hover ? (Theme.is_dark ? #064e3b : #d1fae5) : (Theme.is_dark ? #022c22 : #ecfdf5);
                                border-width: 1px;
                                border-color: Theme.is_dark ? #059669 : #a7f3d0;

                                check_app_btn := TouchArea {
                                    clicked => { root.check_app_updates(); }
                                }

                                HorizontalLayout {
                                    padding-left: 9px;
                                    padding-right: 9px;
                                    spacing: 5px;
                                    alignment: center;

                                    VerticalLayout {
                                        alignment: center;
                                        Image {
                                            source: @image-url("../icons/refresh.svg");
                                            width: 11px;
                                            height: 11px;
                                            colorize: Theme.is_dark ? #34d399 : #059669;
                                        }
                                    }

                                    Text {
                                        text: root.is_checking_app_update ? "Checking GitHub..." : (root.app_update_status != "" ? root.app_update_status : "Check App Updates");
                                        color: Theme.is_dark ? #6ee7b7 : #047857;
                                        font-size: 11px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        Text {
                            text: "Ultra-fast, native video stream extractor, HLS keygen decryptor, and batch media acceleration engine.";
                            color: Theme.text_secondary;
                            font-size: 13px;
                        }

                        // Architecture Tech Stack Badges
                        HorizontalLayout {
                            spacing: 8px;
                            padding-top: 4px;
                            alignment: start;

                            // Rust 2024
                            Rectangle {
                                height: 22px;
                                border-radius: 4px;
                                background: Theme.is_dark ? #052e16 : #dcfce7;
                                border-width: 1px;
                                border-color: Theme.is_dark ? #166534 : #86efac;
                                HorizontalLayout {
                                    padding-left: 7px;
                                    padding-right: 7px;
                                    spacing: 4px;
                                    alignment: center;
                                    Image {
                                        source: @image-url("../icons/cpu.svg");
                                        width: 11px;
                                        height: 11px;
                                        colorize: Theme.is_dark ? #4ade80 : #15803d;
                                    }
                                    Text {
                                        text: "Rust 2024 Core";
                                        color: Theme.is_dark ? #4ade80 : #15803d;
                                        font-size: 11px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            // Slint Native GUI
                            Rectangle {
                                height: 22px;
                                border-radius: 4px;
                                background: Theme.is_dark ? #172554 : #dbeafe;
                                border-width: 1px;
                                border-color: Theme.is_dark ? #1e40af : #93c5fd;
                                HorizontalLayout {
                                    padding-left: 7px;
                                    padding-right: 7px;
                                    spacing: 4px;
                                    alignment: center;
                                    Image {
                                        source: @image-url("../icons/monitor.svg");
                                        width: 11px;
                                        height: 11px;
                                        colorize: Theme.is_dark ? #60a5fa : #1d4ed8;
                                    }
                                    Text {
                                        text: "Slint Native GUI (Zero WebKit/Electron)";
                                        color: Theme.is_dark ? #60a5fa : #1d4ed8;
                                        font-size: 11px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            // Tokio Engine
                            Rectangle {
                                height: 22px;
                                border-radius: 4px;
                                background: Theme.is_dark ? #2e1065 : #f3e8ff;
                                border-width: 1px;
                                border-color: Theme.is_dark ? #581c87 : #d8b4fe;
                                HorizontalLayout {
                                    padding-left: 7px;
                                    padding-right: 7px;
                                    spacing: 4px;
                                    alignment: center;
                                    Image {
                                        source: @image-url("../icons/bolt.svg");
                                        width: 11px;
                                        height: 11px;
                                        colorize: Theme.is_dark ? #c084fc : #7e22ce;
                                    }
                                    Text {
                                        text: "Tokio Async Engine";
                                        color: Theme.is_dark ? #c084fc : #7e22ce;
                                        font-size: 11px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            // SQLite WAL
                            Rectangle {
                                height: 22px;
                                border-radius: 4px;
                                background: Theme.is_dark ? #451a03 : #fef3c7;
                                border-width: 1px;
                                border-color: Theme.is_dark ? #92400e : #fcd34d;
                                HorizontalLayout {
                                    padding-left: 7px;
                                    padding-right: 7px;
                                    spacing: 4px;
                                    alignment: center;
                                    Image {
                                        source: @image-url("../icons/package.svg");
                                        width: 11px;
                                        height: 11px;
                                        colorize: Theme.is_dark ? #fbbf24 : #b45309;
                                    }
                                    Text {
                                        text: "SQLite 3 WAL";
                                        color: Theme.is_dark ? #fbbf24 : #b45309;
                                        font-size: 11px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // 2. Software & Engine Update Center (Clearly separates App vs Engines)
        Rectangle {
            background: Theme.card_bg;
            border-radius: 14px;
            border-width: 1px;
            border-color: Theme.card_border;

            VerticalLayout {
                padding: 18px;
                spacing: 14px;

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    Image {
                        source: @image-url("../icons/refresh.svg");
                        width: 16px;
                        height: 16px;
                        colorize: Theme.primary_accent;
                    }

                    Text {
                        text: "Version & Engine Update Center";
                        color: Theme.text_primary;
                        font-size: 15px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }

                HorizontalLayout {
                    spacing: 12px;

                    // App Software Updater Box
                    Rectangle {
                        background: Theme.inner_bg;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: Theme.inner_border;
                        horizontal-stretch: 1;

                        VerticalLayout {
                            padding: 14px;
                            spacing: 8px;

                            HorizontalLayout {
                                alignment: space-between;

                                Text {
                                    text: "APPLICATION SOFTWARE";
                                    color: Theme.text_muted;
                                    font-size: 11px;
                                    font-weight: 700;
                                }

                                Text {
                                    text: "GitHub In-Place Updater";
                                    color: Theme.primary_accent;
                                    font-size: 11px;
                                    font-weight: 600;
                                }
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;

                                Text {
                                    text: "Current Version: " + root.app_version;
                                    color: Theme.text_primary;
                                    font-size: 13px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                            }

                            Text {
                                text: "Checks official GitHub Releases tag, downloads direct updates in-place, and automatically restarts without manual reinstallation.";
                                color: Theme.text_secondary;
                                font-size: 11px;
                                wrap: word-wrap;
                            }

                            HorizontalLayout {
                                alignment: end;
                                padding-top: 4px;

                                ActionButton {
                                    text: root.is_checking_app_update ? "Checking GitHub..." : "Check for App Update";
                                    icon: @image-url("../icons/sparkles.svg");
                                    has_icon: true;
                                    primary: true;
                                    height: 30px;
                                    clicked => { root.check_app_updates(); }
                                }
                            }
                        }
                    }

                    // Downloader Engines (yt-dlp & FFmpeg) Box
                    Rectangle {
                        background: Theme.inner_bg;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: Theme.inner_border;
                        horizontal-stretch: 1;

                        VerticalLayout {
                            padding: 14px;
                            spacing: 8px;

                            HorizontalLayout {
                                alignment: space-between;

                                Text {
                                    text: "EXTRACTION & MUXING ENGINES";
                                    color: Theme.text_muted;
                                    font-size: 11px;
                                    font-weight: 700;
                                }

                                if (root.is_updating_engines): Text {
                                    text: "Updating Engines...";
                                    color: #f59e0b;
                                    font-size: 11px;
                                    font-weight: 700;
                                }
                            }

                            // Engine versions
                            HorizontalLayout {
                                spacing: 14px;

                                VerticalLayout {
                                    spacing: 2px;
                                    horizontal-stretch: 1;

                                    Text {
                                        text: "yt-dlp Resolver:";
                                        color: Theme.text_muted;
                                        font-size: 11px;
                                    }
                                    Text {
                                        text: root.ytdlp_version_text;
                                        color: Theme.text_primary;
                                        font-size: 12px;
                                        font-weight: 700;
                                        overflow: elide;
                                    }
                                }

                                VerticalLayout {
                                    spacing: 2px;
                                    horizontal-stretch: 1;

                                    Text {
                                        text: "FFmpeg Muxer:";
                                        color: Theme.text_muted;
                                        font-size: 11px;
                                    }
                                    Text {
                                        text: root.ffmpeg_version_text;
                                        color: Theme.text_primary;
                                        font-size: 12px;
                                        font-weight: 700;
                                        overflow: elide;
                                    }
                                }
                            }

                            if (root.engine_update_status != ""): Text {
                                text: root.engine_update_status;
                                color: Theme.primary_accent;
                                font-size: 11px;
                                overflow: elide;
                            }

                            if (root.engine_update_status == ""): Text {
                                text: "Auto-manages yt-dlp nightly and standalone FFmpeg binaries for DASH muxing and protocol parsing.";
                                color: Theme.text_secondary;
                                font-size: 11px;
                                wrap: word-wrap;
                            }

                            HorizontalLayout {
                                alignment: end;
                                spacing: 8px;
                                padding-top: 4px;

                                ActionButton {
                                    text: "Refresh Info";
                                    height: 30px;
                                    clicked => { root.refresh_engine_info(); }
                                }

                                ActionButton {
                                    text: root.is_updating_engines ? "Updating..." : "Update Core Engines";
                                    icon: @image-url("../icons/refresh.svg");
                                    has_icon: true;
                                    height: 30px;
                                    clicked => { root.check_engine_updates(); }
                                }
                            }
                        }
                    }
                }
            }
        }

        // 3. System Environment & Runtime Paths
        Rectangle {
            background: Theme.card_bg;
            border-radius: 14px;
            border-width: 1px;
            border-color: Theme.card_border;

            VerticalLayout {
                padding: 18px;
                spacing: 12px;

                HorizontalLayout {
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;

                        Image {
                            source: @image-url("../icons/cpu.svg");
                            width: 16px;
                            height: 16px;
                            colorize: Theme.brand_purple;
                        }

                        Text {
                            text: "System Environment & Runtime Diagnostics";
                            color: Theme.text_primary;
                            font-size: 15px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }

                    ActionButton {
                        text: "Copy Diagnostics";
                        icon: @image-url("../icons/clipboard.svg");
                        has_icon: true;
                        height: 28px;
                        clicked => { root.copy_diagnostics(); }
                    }
                }

                // Grid Row 1
                HorizontalLayout {
                    spacing: 10px;

                    // Host Platform
                    Rectangle {
                        background: Theme.inner_bg;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: Theme.inner_border;
                        horizontal-stretch: 1;

                        VerticalLayout {
                            padding: 12px;
                            spacing: 4px;

                            Text {
                                text: "HOST SYSTEM ARCHITECTURE";
                                color: Theme.text_muted;
                                font-size: 10px;
                                font-weight: 700;
                            }
                            Text {
                                text: root.host_os_info;
                                color: Theme.text_primary;
                                font-size: 13px;
                                font-weight: 700;
                            }
                            Text {
                                text: "Zero VM/JIT • Native aarch64/x86_64";
                                color: Theme.text_secondary;
                                font-size: 11px;
                            }
                        }
                    }

                    // Companion Media Player
                    Rectangle {
                        background: Theme.inner_bg;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: Theme.inner_border;
                        horizontal-stretch: 1;

                        VerticalLayout {
                            padding: 12px;
                            spacing: 4px;

                            Text {
                                text: "DEFAULT MEDIA PLAYER";
                                color: Theme.text_muted;
                                font-size: 10px;
                                font-weight: 700;
                            }
                            Text {
                                text: root.media_player_text;
                                color: Theme.text_primary;
                                font-size: 13px;
                                font-weight: 700;
                                overflow: elide;
                            }
                            Text {
                                text: "Auto-detects VLC / IINA / mpv / System";
                                color: Theme.text_secondary;
                                font-size: 11px;
                            }
                        }
                    }

                    // Memory Footprint
                    Rectangle {
                        background: Theme.inner_bg;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: Theme.inner_border;
                        horizontal-stretch: 1;

                        VerticalLayout {
                            padding: 12px;
                            spacing: 4px;

                            Text {
                                text: "RESOURCE EFFICIENCY";
                                color: Theme.text_muted;
                                font-size: 10px;
                                font-weight: 700;
                            }
                            Text {
                                text: "~35 MB Idle RAM";
                                color: Theme.is_dark ? #34d399 : #059669;
                                font-size: 13px;
                                font-weight: 700;
                            }
                            Text {
                                text: "10x lighter than Electron downloaders";
                                color: Theme.text_secondary;
                                font-size: 11px;
                            }
                        }
                    }
                }

                // Grid Row 2: Storage Paths
                HorizontalLayout {
                    spacing: 10px;

                    // Download Directory
                    Rectangle {
                        background: Theme.inner_bg;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: Theme.inner_border;
                        horizontal-stretch: 1;

                        VerticalLayout {
                            padding: 12px;
                            spacing: 4px;

                            HorizontalLayout {
                                alignment: space-between;

                                Text {
                                    text: "DOWNLOAD DESTINATION FOLDER";
                                    color: Theme.text_muted;
                                    font-size: 10px;
                                    font-weight: 700;
                                }

                                ActionButton {
                                    text: "Open Folder";
                                    icon: @image-url("../icons/folder.svg");
                                    has_icon: true;
                                    height: 22px;
                                    clicked => { root.open_download_folder(); }
                                }
                            }

                            Text {
                                text: root.download_directory;
                                color: Theme.text_primary;
                                font-size: 12px;
                                font-weight: 600;
                                overflow: elide;
                            }
                        }
                    }

                    // SQLite Database File
                    Rectangle {
                        background: Theme.inner_bg;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: Theme.inner_border;
                        horizontal-stretch: 1;

                        VerticalLayout {
                            padding: 12px;
                            spacing: 4px;

                            Text {
                                text: "PERSISTENT SQLITE DATABASE";
                                color: Theme.text_muted;
                                font-size: 10px;
                                font-weight: 700;
                            }

                            Text {
                                text: root.db_path_text;
                                color: Theme.text_primary;
                                font-size: 12px;
                                font-weight: 600;
                                overflow: elide;
                            }

                            Text {
                                text: "High-concurrency WAL mode • History & Queue persistence";
                                color: Theme.text_secondary;
                                font-size: 11px;
                            }
                        }
                    }
                }
            }
        }

        // 4. Supported Streaming Platforms & Native Decryptors
        Rectangle {
            background: Theme.card_bg;
            border-radius: 14px;
            border-width: 1px;
            border-color: Theme.card_border;

            VerticalLayout {
                padding: 18px;
                spacing: 12px;

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    Image {
                        source: @image-url("../icons/layers.svg");
                        width: 16px;
                        height: 16px;
                        colorize: Theme.brand_purple;
                    }

                    Text {
                        text: "Supported Streaming Platforms & Stream Decryptors";
                        color: Theme.text_primary;
                        font-size: 15px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }

                // Platforms Grid Row 1
                HorizontalLayout {
                    spacing: 10px;

                    // YouTube
                    Rectangle {
                        background: Theme.inner_bg;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: Theme.inner_border;
                        horizontal-stretch: 1;
                        VerticalLayout {
                            padding: 12px;
                            spacing: 4px;
                            Text {
                                text: "YouTube";
                                color: Theme.is_dark ? #f87171 : #dc2626;
                                font-size: 13px;
                                font-weight: 700;
                            }
                            Text {
                                text: "4K / 1080p 60fps DASH muxing, Shorts, full playlists, channel archiving & embedded subtitles.";
                                color: Theme.text_secondary;
                                font-size: 11px;
                                wrap: word-wrap;
                            }
                        }
                    }

                    // KissKH
                    Rectangle {
                        background: Theme.inner_bg;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: Theme.inner_border;
                        horizontal-stretch: 1;
                        VerticalLayout {
                            padding: 12px;
                            spacing: 4px;
                            Text {
                                text: "KissKH Drama";
                                color: Theme.brand_purple;
                                font-size: 13px;
                                font-weight: 700;
                            }
                            Text {
                                text: "Full Asian drama series batch extractor, dynamic HLS keygen decryptor, embedded companion multi-language .srt.";
                                color: Theme.text_secondary;
                                font-size: 11px;
                                wrap: word-wrap;
                            }
                        }
                    }

                    // TikTok & Douyin
                    Rectangle {
                        background: Theme.inner_bg;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: Theme.inner_border;
                        horizontal-stretch: 1;
                        VerticalLayout {
                            padding: 12px;
                            spacing: 4px;
                            Text {
                                text: "TikTok & Douyin (抖音)";
                                color: Theme.is_dark ? #38bdf8 : #0284c7;
                                font-size: 13px;
                                font-weight: 700;
                            }
                            Text {
                                text: "Crystal-clear HD MP4 without watermarks, direct original audio track extraction, and CDN resolver.";
                                color: Theme.text_secondary;
                                font-size: 11px;
                                wrap: word-wrap;
                            }
                        }
                    }
                }

                // Platforms Grid Row 2
                HorizontalLayout {
                    spacing: 10px;

                    // Short Drama Platforms
                    Rectangle {
                        background: Theme.inner_bg;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: Theme.inner_border;
                        horizontal-stretch: 1;
                        VerticalLayout {
                            padding: 12px;
                            spacing: 4px;
                            Text {
                                text: "Short Drama Series";
                                color: Theme.is_dark ? #fb923c : #ea580c;
                                font-size: 13px;
                                font-weight: 700;
                            }
                            Text {
                                text: "ShortMax, AnyReel, DramaBox, GoodShort series parser with episode range syntax (e.g. 1-50) & auto-queue.";
                                color: Theme.text_secondary;
                                font-size: 11px;
                                wrap: word-wrap;
                            }
                        }
                    }

                    // Facebook Video
                    Rectangle {
                        background: Theme.inner_bg;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: Theme.inner_border;
                        horizontal-stretch: 1;
                        VerticalLayout {
                            padding: 12px;
                            spacing: 4px;
                            Text {
                                text: "Facebook Video & Reels";
                                color: Theme.is_dark ? #60a5fa : #2563eb;
                                font-size: 13px;
                                font-weight: 700;
                            }
                            Text {
                                text: "Public videos, reels, fb.watch stream URLs, and progressive MP4 extraction.";
                                color: Theme.text_secondary;
                                font-size: 11px;
                                wrap: word-wrap;
                            }
                        }
                    }

                    // Universal HLS & Direct MP4
                    Rectangle {
                        background: Theme.inner_bg;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: Theme.inner_border;
                        horizontal-stretch: 1;
                        VerticalLayout {
                            padding: 12px;
                            spacing: 4px;
                            Text {
                                text: "Universal HLS / m3u8 / MP4";
                                color: Theme.is_dark ? #34d399 : #059669;
                                font-size: 13px;
                                font-weight: 700;
                            }
                            Text {
                                text: "Parallel segment streaming (.m3u8), AES-128 decrypted segments, HTTP Range resumption & direct video links.";
                                color: Theme.text_secondary;
                                font-size: 11px;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }
        }

        // 5. Quick Actions & Maintenance Toolbar
        Rectangle {
            background: Theme.card_bg;
            border-radius: 14px;
            border-width: 1px;
            border-color: Theme.card_border;

            VerticalLayout {
                padding: 18px;
                spacing: 12px;

                Text {
                    text: "Quick Shortcuts & Project Links";
                    color: Theme.text_primary;
                    font-size: 15px;
                    font-weight: 700;
                }

                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;

                    ActionButton {
                        text: "Open Downloads Folder";
                        icon: @image-url("../icons/folder.svg");
                        has_icon: true;
                        height: 34px;
                        clicked => { root.open_download_folder(); }
                    }

                    ActionButton {
                        text: "View Live Logs";
                        icon: @image-url("../icons/logs.svg");
                        has_icon: true;
                        height: 34px;
                        clicked => { root.open_logs(); }
                    }

                    ActionButton {
                        text: "GitHub Repository";
                        icon: @image-url("../icons/link.svg");
                        has_icon: true;
                        height: 34px;
                        clicked => { root.open_external_url("https://github.com/horrorbringer/NativeVideoDownloader"); }
                    }

                    ActionButton {
                        text: "Report an Issue";
                        icon: @image-url("../icons/alert.svg");
                        has_icon: true;
                        height: 34px;
                        clicked => { root.open_external_url("https://github.com/horrorbringer/NativeVideoDownloader/issues"); }
                    }
                }
            }
        }

        // 6. Credits & License Footer
        HorizontalLayout {
            alignment: space-between;
            padding-left: 6px;
            padding-right: 6px;

            Text {
                text: "Crafted with passion using Rust & Slint • 100% Free & Open Source";
                color: Theme.text_muted;
                font-size: 12px;
                vertical-alignment: center;
            }

            Text {
                text: "MIT License • Native Video Downloader Pro";
                color: Theme.text_muted;
                font-size: 12px;
                vertical-alignment: center;
            }
        }
    }
}
