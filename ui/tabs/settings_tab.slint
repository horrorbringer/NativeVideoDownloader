import { ScrollView, LineEdit } from "std-widgets.slint";
import { ActionButton } from "../components/action_button.slint";
import { IconChip } from "../components/icon_chip.slint";
import { Theme } from "../theme.slint";

export component SettingsTab inherits ScrollView {
    in-out property <string> download_dir_path: "~/Downloads";
    in-out property <int> selected_speed_limit_index: 0;
    in-out property <int> selected_concurrency: 3;
    in-out property <int> selected_cookies_browser_index: 0;
    in-out property <bool> clipboard_monitor_enabled: true;

    // Network & Custom Proxy properties
    in-out property <bool> proxy_enabled: false;
    in-out property <string> proxy_url_input: "";
    in-out property <string> proxy_status_message: "";
    in-out property <bool> proxy_is_connected: false;
    in-out property <bool> is_testing_proxy: false;

    // Audio Extraction Defaults
    in-out property <int> default_audio_format_index: 0;
    in-out property <int> default_audio_bitrate_index: 0;
    in-out property <bool> default_embed_audio_metadata: true;

    // Filename Template & Organization
    in-out property <string> filename_template: "{title}.{ext}";
    in-out property <int> selected_asset_org_mode: 0;
    in-out property <int> selected_sub_lang_index: 0;
    in-out property <bool> sub_lang_all: true;
    in-out property <bool> sub_lang_en: false;
    in-out property <bool> sub_lang_km: false;
    in-out property <bool> sub_lang_th: false;
    in-out property <bool> sub_lang_vi: false;
    in-out property <bool> sub_lang_id: false;
    in-out property <bool> sub_lang_my: false;
    in-out property <bool> sub_lang_zh: false;
    in-out property <bool> sub_lang_ja: false;
    in-out property <bool> sub_lang_ko: false;
    in-out property <bool> sub_lang_es: false;
    in-out property <bool> sub_lang_fr: false;
    in-out property <bool> sub_lang_de: false;
    in-out property <bool> sub_lang_ru: false;
    in-out property <bool> sub_lang_pt: false;
    in-out property <bool> sub_lang_ar: false;
    in-out property <string> selected_sub_langs_summary: "All Languages";
    in-out property <int> selected_concurrent_fragments: 4;
    in-out property <int> theme_mode: 2;
    in-out property <bool> notifications_enabled: true;
    in-out property <bool> notification_sound_enabled: true;

    callback set_notifications_enabled(bool);
    callback set_notification_sound_enabled(bool);
    callback set_theme_mode(int);
    callback set_theme_dark(bool);
    callback browse_download_dir();
    callback open_current_download_dir();
    callback reset_download_dir();
    callback set_filename_template(string);
    callback set_asset_organization_mode(int);
    callback set_sub_lang(int);
    callback toggle_sub_lang(int);
    callback set_speed_limit(int);
    callback set_max_concurrency(int);
    callback set_cookies_browser(int);
    callback set_concurrent_fragments(int);
    callback set_clipboard_monitor(bool);
    callback set_default_audio_format(int);
    callback set_default_audio_bitrate(int);
    callback set_embed_audio_metadata(bool);
    callback set_proxy(bool, string);
    callback test_proxy(string);
    callback test_notification();
    callback update_extractor();
    callback clear_cache();

    vertical-stretch: 1;

    VerticalLayout {
        alignment: start;
        spacing: 12px;
        padding-bottom: 14px;

        // 0. Appearance & Interface Theme Selection
        Rectangle {
            background: Theme.card_bg;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.card_border;

            VerticalLayout {
                padding: 20px;
                spacing: 14px;

                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;

                    Rectangle {
                        width: 34px;
                        height: 34px;
                        border-radius: 8px;
                        background: Theme.sidebar_brand_bg;
                        border-width: 1px;
                        border-color: Theme.sidebar_brand_border;

                        Image {
                            source: root.theme_mode == 2 ? @image-url("../icons/monitor.svg") : (Theme.is_dark ? @image-url("../icons/moon.svg") : @image-url("../icons/sun.svg"));
                            width: 17px;
                            height: 17px;
                            colorize: Theme.brand_purple;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }

                    VerticalLayout {
                        spacing: 3px;
                        Text {
                            text: "Appearance & Interface Theme";
                            color: Theme.text_primary;
                            font-size: 15px;
                            font-weight: 700;
                        }
                        Text {
                            text: "Choose between System Auto (matches macOS / OS appearance dynamically), Dark mode, and Light mode.";
                            color: Theme.text_secondary;
                            font-size: 13px;
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 12px;

                    // Auto / System Default Mode Option Card
                    system_mode_card := Rectangle {
                        horizontal-stretch: 1;
                        height: 60px;
                        border-radius: 8px;
                        background: root.theme_mode == 2 ? Theme.sidebar_status_bg : (system_touch.has-hover ? Theme.inner_bg : transparent);
                        border-width: root.theme_mode == 2 ? 2px : 1px;
                        border-color: root.theme_mode == 2 ? Theme.brand_purple : Theme.card_border;
                        animate border-color { duration: 120ms; }
                        animate background { duration: 120ms; }

                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            spacing: 10px;
                            alignment: start;

                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 32px;
                                    height: 32px;
                                    border-radius: 6px;
                                    background: Theme.sidebar_brand_bg;
                                    border-width: 1px;
                                    border-color: Theme.sidebar_brand_border;

                                    Image {
                                        source: @image-url("../icons/monitor.svg");
                                        width: 16px;
                                        height: 16px;
                                        colorize: #38bdf8;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                    }
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;
                                Text {
                                    text: "Auto (System)";
                                    color: Theme.text_primary;
                                    font-size: 13px;
                                    font-weight: root.theme_mode == 2 ? 700 : 500;
                                }
                                Text {
                                    text: "Matches macOS / OS theme";
                                    color: Theme.text_secondary;
                                    font-size: 11px;
                                }
                            }
                        }

                        system_touch := TouchArea {
                            clicked => {
                                root.theme_mode = 2;
                                root.set_theme_mode(2);
                            }
                        }
                    }

                    // Dark Mode Option Card
                    dark_mode_card := Rectangle {
                        horizontal-stretch: 1;
                        height: 60px;
                        border-radius: 8px;
                        background: root.theme_mode == 1 ? Theme.sidebar_status_bg : (dark_touch.has-hover ? Theme.inner_bg : transparent);
                        border-width: root.theme_mode == 1 ? 2px : 1px;
                        border-color: root.theme_mode == 1 ? Theme.brand_purple : Theme.card_border;
                        animate border-color { duration: 120ms; }
                        animate background { duration: 120ms; }

                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            spacing: 10px;
                            alignment: start;

                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 32px;
                                    height: 32px;
                                    border-radius: 6px;
                                    background: #141724;
                                    border-width: 1px;
                                    border-color: #2b334d;

                                    Image {
                                        source: @image-url("../icons/moon.svg");
                                        width: 16px;
                                        height: 16px;
                                        colorize: #7082ff;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                    }
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;
                                Text {
                                    text: "Dark Mode";
                                    color: Theme.text_primary;
                                    font-size: 13px;
                                    font-weight: root.theme_mode == 1 ? 700 : 500;
                                }
                                Text {
                                    text: "Low-glare obsidian palette";
                                    color: Theme.text_secondary;
                                    font-size: 11px;
                                }
                            }
                        }

                        dark_touch := TouchArea {
                            clicked => {
                                root.theme_mode = 1;
                                root.set_theme_mode(1);
                            }
                        }
                    }

                    // Light Mode Option Card
                    light_mode_card := Rectangle {
                        horizontal-stretch: 1;
                        height: 60px;
                        border-radius: 8px;
                        background: root.theme_mode == 0 ? Theme.sidebar_status_bg : (light_touch.has-hover ? Theme.inner_bg : transparent);
                        border-width: root.theme_mode == 0 ? 2px : 1px;
                        border-color: root.theme_mode == 0 ? Theme.brand_purple : Theme.card_border;
                        animate border-color { duration: 120ms; }
                        animate background { duration: 120ms; }

                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            spacing: 10px;
                            alignment: start;

                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 32px;
                                    height: 32px;
                                    border-radius: 6px;
                                    background: #ffffff;
                                    border-width: 1px;
                                    border-color: #cbd5e1;

                                    Image {
                                        source: @image-url("../icons/sun.svg");
                                        width: 16px;
                                        height: 16px;
                                        colorize: #f59e0b;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                    }
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;
                                Text {
                                    text: "Light Mode";
                                    color: Theme.text_primary;
                                    font-size: 13px;
                                    font-weight: root.theme_mode == 0 ? 700 : 500;
                                }
                                Text {
                                    text: "Crisp daylight contrast";
                                    color: Theme.text_secondary;
                                    font-size: 11px;
                                }
                            }
                        }

                        light_touch := TouchArea {
                            clicked => {
                                root.theme_mode = 0;
                                root.set_theme_mode(0);
                            }
                        }
                    }
                }
            }
        }

        // 1. Storage & File Location
        Rectangle {
            background: Theme.card_bg;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.card_border;

            VerticalLayout {
                padding: 20px;
                spacing: 14px;

                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;

                    Rectangle {
                        width: 34px;
                        height: 34px;
                        border-radius: 8px;
                        background: Theme.sidebar_brand_bg;
                        border-width: 1px;
                        border-color: Theme.sidebar_brand_border;

                        Image {
                            source: @image-url("../icons/folder.svg");
                            width: 17px;
                            height: 17px;
                            colorize: Theme.brand_purple;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }

                    VerticalLayout {
                        spacing: 3px;
                        Text {
                            text: "Default Download Directory";
                            color: Theme.text_primary;
                            font-size: 15px;
                            font-weight: 700;
                        }
                        Text {
                            text: "All media, video series, and extracted audio files are saved into this folder.";
                            color: Theme.text_secondary;
                            font-size: 13px;
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 10px;

                    Rectangle {
                        background: Theme.inner_bg;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: Theme.inner_border;
                        horizontal-stretch: 1;
                        height: 38px;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            alignment: start;

                            Text {
                                text: root.download_dir_path;
                                color: Theme.text_primary;
                                font-size: 13px;
                                font-weight: 500;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }

                    ActionButton {
                        text: "Change...";
                        icon: @image-url("../icons/folder.svg");
                        has_icon: true;
                        height: 38px;
                        clicked => { root.browse_download_dir(); }
                    }

                    ActionButton {
                        text: "Finder";
                        icon: @image-url("../icons/monitor.svg");
                        has_icon: true;
                        height: 38px;
                        clicked => { root.open_current_download_dir(); }
                    }

                    ActionButton {
                        text: "Reset";
                        icon: @image-url("../icons/refresh.svg");
                        has_icon: true;
                        height: 38px;
                        clicked => { root.reset_download_dir(); }
                    }
                }

                // Divider
                Rectangle {
                    height: 1px;
                    background: Theme.card_border;
                }

                // Filename Template & Automatic Subfolders
                VerticalLayout {
                    spacing: 10px;

                    VerticalLayout {
                        spacing: 3px;
                        Text {
                            text: "Filename Template & Automatic Subfolders";
                            color: Theme.text_primary;
                            font-size: 14px;
                            font-weight: 700;
                        }
                        Text {
                            text: "Customize media filenames and organize episodes or playlists into subfolders with variables.";
                            color: Theme.text_secondary;
                            font-size: 12px;
                        }
                    }

                    // Template input field & Save button
                    HorizontalLayout {
                        spacing: 10px;

                        template_input := LineEdit {
                            horizontal-stretch: 1;
                            text <=> root.filename_template;
                            font_size: 13px;
                            height: 38px;
                            placeholder_text: "{title} [{resolution}].{ext}";
                            accepted => {
                                root.set_filename_template(self.text);
                            }
                        }

                        ActionButton {
                            text: "Save";
                            icon: @image-url("../icons/check.svg");
                            has_icon: true;
                            primary: true;
                            height: 38px;
                            clicked => {
                                root.set_filename_template(root.filename_template);
                            }
                        }
                    }

                    // Quick Presets
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;

                        Text {
                            text: "Presets:";
                            color: #64748b;
                            font-size: 11px;
                            vertical-alignment: center;
                        }

                        IconChip {
                            text: "{title}.{ext}";
                            selected: root.filename_template == "{title}.{ext}";
                            clicked => {
                                root.filename_template = "{title}.{ext}";
                                root.set_filename_template(root.filename_template);
                            }
                        }
                        IconChip {
                            text: "{title} [{resolution}].{ext}";
                            selected: root.filename_template == "{title} [{resolution}].{ext}";
                            clicked => {
                                root.filename_template = "{title} [{resolution}].{ext}";
                                root.set_filename_template(root.filename_template);
                            }
                        }
                        IconChip {
                            text: "{series}/{index} - {title}.{ext}";
                            selected: root.filename_template == "{series}/{index} - {title}.{ext}";
                            clicked => {
                                root.filename_template = "{series}/{index} - {title}.{ext}";
                                root.set_filename_template(root.filename_template);
                            }
                        }
                        IconChip {
                            text: "[{date}] {title}.{ext}";
                            selected: root.filename_template == "[{date}] {title}.{ext}";
                            clicked => {
                                root.filename_template = "[{date}] {title}.{ext}";
                                root.set_filename_template(root.filename_template);
                            }
                        }
                    }
                }

                // Divider
                Rectangle {
                    height: 1px;
                    background: Theme.card_border;
                }

                // Subtitle & Multi-Asset Hierarchy Organization (Approach 1)
                VerticalLayout {
                    spacing: 10px;

                    VerticalLayout {
                        spacing: 3px;
                        Text {
                            text: "Media, Subtitles & Multi-Asset Organization";
                            color: Theme.text_primary;
                            font-size: 14px;
                            font-weight: 700;
                        }
                        Text {
                            text: "Automatically organize multi-language subtitles, posters/thumbnails, and extra audio into clean hierarchies.";
                            color: Theme.text_secondary;
                            font-size: 12px;
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;

                        IconChip {
                            text: "Dedicated Video Folder (Approach 1)";
                            icon: @image-url("../icons/folder.svg");
                            has_icon: true;
                            selected: root.selected_asset_org_mode == 0;
                            clicked => {
                                root.selected_asset_org_mode = 0;
                                root.set_asset_organization_mode(0);
                            }
                        }
                        IconChip {
                            text: "Grouped Subs (Subtitles/Video/)";
                            selected: root.selected_asset_org_mode == 1;
                            clicked => {
                                root.selected_asset_org_mode = 1;
                                root.set_asset_organization_mode(1);
                            }
                        }
                        IconChip {
                            text: "Flat Subs (Subtitles/)";
                            selected: root.selected_asset_org_mode == 2;
                            clicked => {
                                root.selected_asset_org_mode = 2;
                                root.set_asset_organization_mode(2);
                            }
                        }
                    }

                    Rectangle {
                        background: Theme.inner_bg;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: Theme.inner_border;

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            padding-top: 7px;
                            padding-bottom: 7px;
                            alignment: start;

                            Text {
                                text: root.selected_asset_org_mode == 0 ? "Structure: <Video Name>/ [ Video.mp4 + Subtitles/ (all languages) + Thumbnails/ ] — 100% VLC, IINA, Plex & Jellyfin compatible" :
                                      (root.selected_asset_org_mode == 1 ? "Structure: Video.mp4 + Subtitles/<Video Name>/ [ all language subtitles organized per video ]" :
                                       "Structure: Video.mp4 + Subtitles/ [ all subtitle files together in one shared folder ]");
                                color: Theme.brand_purple;
                                font-size: 11px;
                                font-weight: 500;
                            }
                        }
                    }

                    // Default Subtitle Language
                    VerticalLayout {
                        spacing: 8px;

                        HorizontalLayout {
                            alignment: space-between;

                            Text {
                                text: "Default Preferred Subtitle Languages";
                                color: Theme.text_primary;
                                font-size: 13px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }

                            Text {
                                text: root.selected_sub_langs_summary;
                                color: Theme.primary_accent;
                                font-size: 12px;
                                font-weight: 600;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }

                        Text {
                            text: "Select default languages to download and embed when subtitles are enabled.";
                            color: Theme.text_secondary;
                            font-size: 11px;
                        }

                        VerticalLayout {
                            spacing: 6px;

                            HorizontalLayout {
                                spacing: 6px;
                                alignment: start;

                                IconChip {
                                    text: "All Languages";
                                    selected: root.sub_lang_all;
                                    clicked => { root.toggle_sub_lang(0); }
                                }
                                IconChip {
                                    text: "English (en)";
                                    selected: root.sub_lang_en;
                                    clicked => { root.toggle_sub_lang(1); }
                                }
                                IconChip {
                                    text: "Khmer (km)";
                                    selected: root.sub_lang_km;
                                    clicked => { root.toggle_sub_lang(2); }
                                }
                                IconChip {
                                    text: "Thai (th)";
                                    selected: root.sub_lang_th;
                                    clicked => { root.toggle_sub_lang(3); }
                                }
                                IconChip {
                                    text: "Vietnamese (vi)";
                                    selected: root.sub_lang_vi;
                                    clicked => { root.toggle_sub_lang(4); }
                                }
                                IconChip {
                                    text: "Indonesian (id)";
                                    selected: root.sub_lang_id;
                                    clicked => { root.toggle_sub_lang(5); }
                                }
                                IconChip {
                                    text: "Burmese (my)";
                                    selected: root.sub_lang_my;
                                    clicked => { root.toggle_sub_lang(6); }
                                }
                                IconChip {
                                    text: "Chinese (zh)";
                                    selected: root.sub_lang_zh;
                                    clicked => { root.toggle_sub_lang(7); }
                                }
                            }

                            HorizontalLayout {
                                spacing: 6px;
                                alignment: start;

                                IconChip {
                                    text: "Japanese (ja)";
                                    selected: root.sub_lang_ja;
                                    clicked => { root.toggle_sub_lang(8); }
                                }
                                IconChip {
                                    text: "Korean (ko)";
                                    selected: root.sub_lang_ko;
                                    clicked => { root.toggle_sub_lang(9); }
                                }
                                IconChip {
                                    text: "Spanish (es)";
                                    selected: root.sub_lang_es;
                                    clicked => { root.toggle_sub_lang(10); }
                                }
                                IconChip {
                                    text: "French (fr)";
                                    selected: root.sub_lang_fr;
                                    clicked => { root.toggle_sub_lang(11); }
                                }
                                IconChip {
                                    text: "German (de)";
                                    selected: root.sub_lang_de;
                                    clicked => { root.toggle_sub_lang(12); }
                                }
                                IconChip {
                                    text: "Russian (ru)";
                                    selected: root.sub_lang_ru;
                                    clicked => { root.toggle_sub_lang(13); }
                                }
                                IconChip {
                                    text: "Portuguese (pt)";
                                    selected: root.sub_lang_pt;
                                    clicked => { root.toggle_sub_lang(14); }
                                }
                                IconChip {
                                    text: "Arabic (ar)";
                                    selected: root.sub_lang_ar;
                                    clicked => { root.toggle_sub_lang(15); }
                                }
                            }
                        }
                    }
                }
            }
        }

        // 2. Network & Bandwidth Management
        Rectangle {
            background: Theme.card_bg;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.card_border;

            VerticalLayout {
                padding: 20px;
                spacing: 18px;

                // Speed Limiter
                VerticalLayout {
                    spacing: 12px;

                    HorizontalLayout {
                        spacing: 12px;
                        alignment: start;

                        Rectangle {
                            width: 34px;
                            height: 34px;
                            border-radius: 8px;
                            background: Theme.sidebar_brand_bg;
                            border-width: 1px;
                            border-color: Theme.sidebar_brand_border;

                            Image {
                                source: @image-url("../icons/bolt.svg");
                                width: 17px;
                                height: 17px;
                                colorize: Theme.brand_purple;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }

                        VerticalLayout {
                            spacing: 3px;
                            Text {
                                text: "Bandwidth Speed Limiter";
                                color: Theme.text_primary;
                                font-size: 15px;
                                font-weight: 700;
                            }
                            Text {
                                text: "Throttle maximum download speed to avoid saturating your local network.";
                                color: Theme.text_secondary;
                                font-size: 13px;
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;

                        IconChip {
                            text: "No Limit";
                            icon: @image-url("../icons/bolt.svg");
                            has_icon: true;
                            selected: root.selected_speed_limit_index == 0;
                            clicked => {
                                root.selected_speed_limit_index = 0;
                                root.set_speed_limit(0);
                            }
                        }
                        IconChip {
                            text: "2 MB/s";
                            selected: root.selected_speed_limit_index == 1;
                            clicked => {
                                root.selected_speed_limit_index = 1;
                                root.set_speed_limit(1);
                            }
                        }
                        IconChip {
                            text: "5 MB/s";
                            selected: root.selected_speed_limit_index == 2;
                            clicked => {
                                root.selected_speed_limit_index = 2;
                                root.set_speed_limit(2);
                            }
                        }
                        IconChip {
                            text: "10 MB/s";
                            selected: root.selected_speed_limit_index == 3;
                            clicked => {
                                root.selected_speed_limit_index = 3;
                                root.set_speed_limit(3);
                            }
                        }
                        IconChip {
                            text: "20 MB/s";
                            selected: root.selected_speed_limit_index == 4;
                            clicked => {
                                root.selected_speed_limit_index = 4;
                                root.set_speed_limit(4);
                            }
                        }
                    }
                }

                // Divider
                Rectangle {
                    height: 1px;
                    background: Theme.card_border;
                }

                // Concurrency
                VerticalLayout {
                    spacing: 12px;

                    HorizontalLayout {
                        spacing: 12px;
                        alignment: start;

                        Rectangle {
                            width: 34px;
                            height: 34px;
                            border-radius: 8px;
                            background: Theme.sidebar_brand_bg;
                            border-width: 1px;
                            border-color: Theme.sidebar_brand_border;

                            Image {
                                source: @image-url("../icons/cpu.svg");
                                width: 17px;
                                height: 17px;
                                colorize: Theme.brand_purple;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }

                        VerticalLayout {
                            spacing: 3px;
                            Text {
                                text: "Concurrent Queue Workers";
                                color: Theme.text_primary;
                                font-size: 15px;
                                font-weight: 700;
                            }
                            Text {
                                text: "Number of download items actively processed simultaneously.";
                                color: Theme.text_secondary;
                                font-size: 13px;
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;

                        IconChip {
                            text: "1 (Sequential)";
                            selected: root.selected_concurrency == 1;
                            clicked => {
                                root.selected_concurrency = 1;
                                root.set_max_concurrency(1);
                            }
                        }
                        IconChip {
                            text: "2 Parallel";
                            selected: root.selected_concurrency == 2;
                            clicked => {
                                root.selected_concurrency = 2;
                                root.set_max_concurrency(2);
                            }
                        }
                        IconChip {
                            text: "3 Parallel (Recommended)";
                            selected: root.selected_concurrency == 3;
                            clicked => {
                                root.selected_concurrency = 3;
                                root.set_max_concurrency(3);
                            }
                        }
                        IconChip {
                            text: "5 Parallel (Fast)";
                            selected: root.selected_concurrency == 5;
                            clicked => {
                                root.selected_concurrency = 5;
                                root.set_max_concurrency(5);
                            }
                        }
                    }

                    // Divider
                    Rectangle { height: 1px; background: Theme.card_border; }

                    // Parallel Fragments per video
                    HorizontalLayout {
                        spacing: 12px;
                        alignment: start;

                        Rectangle {
                            width: 34px;
                            height: 34px;
                            border-radius: 8px;
                            background: #1a1240;
                            border-width: 1px;
                            border-color: #6d28d9;

                            Image {
                                source: @image-url("../icons/bolt.svg");
                                width: 17px;
                                height: 17px;
                                colorize: #a78bfa;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }

                        VerticalLayout {
                            spacing: 3px;
                            Text {
                                text: "Parallel Fragments (Per-Video Speed)";
                                color: Theme.text_primary;
                                font-size: 15px;
                                font-weight: 700;
                            }
                            Text {
                                text: "Simultaneous HLS/DASH segments downloaded per video. Higher = faster on good connections.";
                                color: Theme.text_secondary;
                                font-size: 13px;
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;

                        IconChip {
                            text: "1 (Safe)";
                            selected: root.selected_concurrent_fragments == 1;
                            clicked => {
                                root.selected_concurrent_fragments = 1;
                                root.set_concurrent_fragments(1);
                            }
                        }
                        IconChip {
                            text: "2 Segments";
                            selected: root.selected_concurrent_fragments == 2;
                            clicked => {
                                root.selected_concurrent_fragments = 2;
                                root.set_concurrent_fragments(2);
                            }
                        }
                        IconChip {
                            text: "4 Segments (Recommended)";
                            selected: root.selected_concurrent_fragments == 4;
                            clicked => {
                                root.selected_concurrent_fragments = 4;
                                root.set_concurrent_fragments(4);
                            }
                        }
                        IconChip {
                            text: "8 Segments (Max Speed)";
                            selected: root.selected_concurrent_fragments == 8;
                            clicked => {
                                root.selected_concurrent_fragments = 8;
                                root.set_concurrent_fragments(8);
                            }
                        }
                    }
                }
            }
        }

        // 3. Browser Cookies & Authentication
        Rectangle {
            background: Theme.card_bg;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.card_border;

            VerticalLayout {
                padding: 20px;
                spacing: 14px;

                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;

                    Rectangle {
                        width: 34px;
                        height: 34px;
                        border-radius: 8px;
                        background: Theme.sidebar_brand_bg;
                        border-width: 1px;
                        border-color: Theme.sidebar_brand_border;

                        Image {
                            source: @image-url("../icons/monitor.svg");
                            width: 17px;
                            height: 17px;
                            colorize: Theme.brand_purple;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }

                    VerticalLayout {
                        spacing: 3px;
                        Text {
                            text: "Browser Cookies & Authentication";
                            color: Theme.text_primary;
                            font-size: 15px;
                            font-weight: 700;
                        }
                        Text {
                            text: "Extract session cookies from your web browser to download private, age-gated, or member-only videos.";
                            color: Theme.text_secondary;
                            font-size: 13px;
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    IconChip {
                        text: "Disabled";
                        selected: root.selected_cookies_browser_index == 0;
                        clicked => {
                            root.selected_cookies_browser_index = 0;
                            root.set_cookies_browser(0);
                        }
                    }
                    IconChip {
                        text: "Chrome";
                        selected: root.selected_cookies_browser_index == 1;
                        clicked => {
                            root.selected_cookies_browser_index = 1;
                            root.set_cookies_browser(1);
                        }
                    }
                    IconChip {
                        text: "Firefox";
                        selected: root.selected_cookies_browser_index == 2;
                        clicked => {
                            root.selected_cookies_browser_index = 2;
                            root.set_cookies_browser(2);
                        }
                    }
                    IconChip {
                        text: "Safari";
                        selected: root.selected_cookies_browser_index == 3;
                        clicked => {
                            root.selected_cookies_browser_index = 3;
                            root.set_cookies_browser(3);
                        }
                    }
                    IconChip {
                        text: "Brave";
                        selected: root.selected_cookies_browser_index == 4;
                        clicked => {
                            root.selected_cookies_browser_index = 4;
                            root.set_cookies_browser(4);
                        }
                    }
                    IconChip {
                        text: "Edge";
                        selected: root.selected_cookies_browser_index == 5;
                        clicked => {
                            root.selected_cookies_browser_index = 5;
                            root.set_cookies_browser(5);
                        }
                    }
                }

                Rectangle {
                    background: Theme.inner_bg;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: Theme.inner_border;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        padding-top: 8px;
                        padding-bottom: 8px;
                        spacing: 8px;
                        alignment: start;

                        VerticalLayout {
                            alignment: center;
                            Image {
                                source: @image-url("../icons/info.svg");
                                width: 14px;
                                height: 14px;
                                colorize: #7082ff;
                            }
                        }

                        Text {
                            text: root.selected_cookies_browser_index == 0
                                ? "Cookies disabled. Downloads use anonymous guest sessions."
                                : "Using session cookies from " + (
                                    root.selected_cookies_browser_index == 1 ? "Google Chrome" :
                                    root.selected_cookies_browser_index == 2 ? "Mozilla Firefox" :
                                    root.selected_cookies_browser_index == 3 ? "Apple Safari" :
                                    root.selected_cookies_browser_index == 4 ? "Brave Browser" : "Microsoft Edge"
                                  ) + ". Logged-in accounts will be inherited automatically.";
                            color: #949db2;
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                    }
                }

                HorizontalLayout {
                    alignment: space-between;
                    VerticalLayout {
                        spacing: 2px;
                        alignment: center;
                        Text {
                            text: "Cookie & Stream Cache";
                            color: Theme.text_primary;
                            font-size: 13px;
                            font-weight: 600;
                        }
                        Text {
                            text: "Purge cached browser cookies, tokens, and stream URLs to force fresh authentication.";
                            color: Theme.text_secondary;
                            font-size: 11px;
                        }
                    }

                    ActionButton {
                        text: "Clear Cookie Cache";
                        icon: @image-url("../icons/broom.svg");
                        has_icon: true;
                        height: 32px;
                        clicked => { root.clear_cache(); }
                    }
                }
            }
        }

        // 4. Audio Extraction & Music Defaults
        Rectangle {
            background: Theme.card_bg;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.card_border;

            VerticalLayout {
                padding: 20px;
                spacing: 14px;

                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;

                    Rectangle {
                        width: 34px;
                        height: 34px;
                        border-radius: 8px;
                        background: Theme.sidebar_brand_bg;
                        border-width: 1px;
                        border-color: Theme.sidebar_brand_border;

                        Image {
                            source: @image-url("../icons/music.svg");
                            width: 17px;
                            height: 17px;
                            colorize: Theme.brand_purple;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }

                    VerticalLayout {
                        spacing: 3px;
                        Text {
                            text: "Audio Extraction & Music Defaults";
                            color: Theme.text_primary;
                            font-size: 15px;
                            font-weight: 700;
                        }
                        Text {
                            text: "Configure preferred audio container, bitrate, and ID3 cover artwork embedding.";
                            color: Theme.text_secondary;
                            font-size: 13px;
                        }
                    }
                }

                // 1. Container Format
                VerticalLayout {
                    spacing: 8px;

                    Text {
                        text: "Default Audio Container:";
                        color: #c7cbd9;
                        font-size: 13px;
                        font-weight: 600;
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;

                        IconChip {
                            text: "MP3 (Universal)";
                            selected: root.default_audio_format_index == 0;
                            clicked => {
                                root.default_audio_format_index = 0;
                                root.set_default_audio_format(0);
                            }
                        }
                        IconChip {
                            text: "M4A (AAC / Apple)";
                            selected: root.default_audio_format_index == 1;
                            clicked => {
                                root.default_audio_format_index = 1;
                                root.set_default_audio_format(1);
                            }
                        }
                        IconChip {
                            text: "FLAC (Lossless)";
                            selected: root.default_audio_format_index == 2;
                            clicked => {
                                root.default_audio_format_index = 2;
                                root.set_default_audio_format(2);
                            }
                        }
                        IconChip {
                            text: "WAV";
                            selected: root.default_audio_format_index == 3;
                            clicked => {
                                root.default_audio_format_index = 3;
                                root.set_default_audio_format(3);
                            }
                        }
                        IconChip {
                            text: "OPUS";
                            selected: root.default_audio_format_index == 4;
                            clicked => {
                                root.default_audio_format_index = 4;
                                root.set_default_audio_format(4);
                            }
                        }
                    }
                }

                // 2. Bitrate (for compressed formats)
                if root.default_audio_format_index != 2 && root.default_audio_format_index != 3: VerticalLayout {
                    spacing: 8px;

                    Text {
                        text: "Default Audio Quality / Bitrate:";
                        color: #c7cbd9;
                        font-size: 13px;
                        font-weight: 600;
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;

                        IconChip {
                            text: "320 kbps (Extreme Quality)";
                            selected: root.default_audio_bitrate_index == 0;
                            clicked => {
                                root.default_audio_bitrate_index = 0;
                                root.set_default_audio_bitrate(0);
                            }
                        }
                        IconChip {
                            text: "256 kbps (High Quality)";
                            selected: root.default_audio_bitrate_index == 1;
                            clicked => {
                                root.default_audio_bitrate_index = 1;
                                root.set_default_audio_bitrate(1);
                            }
                        }
                        IconChip {
                            text: "192 kbps (Standard)";
                            selected: root.default_audio_bitrate_index == 2;
                            clicked => {
                                root.default_audio_bitrate_index = 2;
                                root.set_default_audio_bitrate(2);
                            }
                        }
                        IconChip {
                            text: "128 kbps (Compact)";
                            selected: root.default_audio_bitrate_index == 3;
                            clicked => {
                                root.default_audio_bitrate_index = 3;
                                root.set_default_audio_bitrate(3);
                            }
                        }
                    }
                }

                // 3. ID3 Tags & Cover Artwork
                VerticalLayout {
                    spacing: 8px;

                    Text {
                        text: "Cover Artwork & ID3 Tags:";
                        color: #c7cbd9;
                        font-size: 13px;
                        font-weight: 600;
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;

                        IconChip {
                            text: "Embed Artwork & Metadata";
                            icon: @image-url("../icons/sparkles.svg");
                            has_icon: true;
                            selected: root.default_embed_audio_metadata;
                            clicked => {
                                root.default_embed_audio_metadata = true;
                                root.set_embed_audio_metadata(true);
                            }
                        }
                        IconChip {
                            text: "Audio Stream Only (No Tags)";
                            selected: !root.default_embed_audio_metadata;
                            clicked => {
                                root.default_embed_audio_metadata = false;
                                root.set_embed_audio_metadata(false);
                            }
                        }
                    }
                }
            }
        }

        // 5. Network & Custom Proxy
        Rectangle {
            background: Theme.card_bg;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.card_border;

            VerticalLayout {
                padding: 20px;
                spacing: 14px;

                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;

                    Rectangle {
                        width: 34px;
                        height: 34px;
                        border-radius: 8px;
                        background: Theme.sidebar_brand_bg;
                        border-width: 1px;
                        border-color: Theme.sidebar_brand_border;

                        Image {
                            source: @image-url("../icons/link.svg");
                            width: 17px;
                            height: 17px;
                            colorize: Theme.brand_purple;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }

                    VerticalLayout {
                        spacing: 3px;
                        Text {
                            text: "Network & Custom Proxy";
                            color: Theme.text_primary;
                            font-size: 15px;
                            font-weight: 700;
                        }
                        Text {
                            text: "Route media analysis, scrapers, and downloads through an HTTP, HTTPS, or SOCKS5 proxy.";
                            color: Theme.text_secondary;
                            font-size: 13px;
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    IconChip {
                        text: "Direct Connection";
                        icon: @image-url("../icons/bolt.svg");
                        has_icon: true;
                        selected: !root.proxy_enabled;
                        clicked => {
                            root.proxy_enabled = false;
                            root.set_proxy(false, "");
                        }
                    }

                    IconChip {
                        text: "Custom Proxy";
                        icon: @image-url("../icons/link.svg");
                        has_icon: true;
                        selected: root.proxy_enabled;
                        clicked => {
                            root.proxy_enabled = true;
                            root.set_proxy(true, root.proxy_url_input);
                        }
                    }
                }

                if root.proxy_enabled: VerticalLayout {
                    spacing: 10px;

                    HorizontalLayout {
                        spacing: 10px;

                        proxy_input := LineEdit {
                            horizontal-stretch: 1;
                            text <=> root.proxy_url_input;
                            placeholder_text: "http://127.0.0.1:7890 or socks5://127.0.0.1:1080";
                            font_size: 13px;
                            height: 36px;
                            accepted => {
                                root.set_proxy(true, self.text);
                            }
                        }

                        ActionButton {
                            text: root.is_testing_proxy ? "Testing..." : "Test Proxy";
                            icon: @image-url("../icons/refresh.svg");
                            has_icon: true;
                            enabled: !root.is_testing_proxy && root.proxy_url_input != "";
                            height: 36px;
                            clicked => {
                                root.test_proxy(root.proxy_url_input);
                            }
                        }

                        ActionButton {
                            text: "Save";
                            icon: @image-url("../icons/check.svg");
                            has_icon: true;
                            primary: true;
                            height: 36px;
                            clicked => {
                                root.set_proxy(true, root.proxy_url_input);
                            }
                        }
                    }

                    // Presets
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;

                        Text {
                            text: "Presets (requires local proxy app):";
                            color: #64748b;
                            font-size: 11px;
                            vertical-alignment: center;
                        }

                        IconChip {
                            text: "127.0.0.1:7890 (Clash)";
                            selected: root.proxy_url_input == "http://127.0.0.1:7890";
                            clicked => {
                                root.proxy_url_input = "http://127.0.0.1:7890";
                                root.set_proxy(true, root.proxy_url_input);
                            }
                        }

                        IconChip {
                            text: "127.0.0.1:1080 (SOCKS5)";
                            selected: root.proxy_url_input == "socks5://127.0.0.1:1080";
                            clicked => {
                                root.proxy_url_input = "socks5://127.0.0.1:1080";
                                root.set_proxy(true, root.proxy_url_input);
                            }
                        }

                        IconChip {
                            text: "127.0.0.1:10808 (V2Ray)";
                            selected: root.proxy_url_input == "http://127.0.0.1:10808";
                            clicked => {
                                root.proxy_url_input = "http://127.0.0.1:10808";
                                root.set_proxy(true, root.proxy_url_input);
                            }
                        }

                        IconChip {
                            text: "127.0.0.1:40000 (WARP)";
                            selected: root.proxy_url_input == "socks5://127.0.0.1:40000";
                            clicked => {
                                root.proxy_url_input = "socks5://127.0.0.1:40000";
                                root.set_proxy(true, root.proxy_url_input);
                            }
                        }
                    }
                }

                // Proxy status chip
                if root.proxy_status_message != "": Rectangle {
                    background: Theme.inner_bg;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: Theme.inner_border;
                    height: 28px;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        alignment: start;
                        spacing: 6px;

                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 6px;
                                height: 6px;
                                border-radius: 3px;
                                background: root.proxy_is_connected ? #22c55e : #ef4444;
                            }
                        }

                        Text {
                            text: root.proxy_status_message;
                            color: #cbd5e1;
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // 5. System & Desktop Notifications
        Rectangle {
            background: Theme.card_bg;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.card_border;

            VerticalLayout {
                padding: 20px;
                spacing: 12px;

                HorizontalLayout {
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: 12px;
                        alignment: start;

                        Rectangle {
                            width: 34px;
                            height: 34px;
                            border-radius: 8px;
                            background: Theme.sidebar_brand_bg;
                            border-width: 1px;
                            border-color: Theme.sidebar_brand_border;

                            Image {
                                source: @image-url("../icons/bell.svg");
                                width: 17px;
                                height: 17px;
                                colorize: Theme.brand_purple;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }

                        VerticalLayout {
                            spacing: 3px;
                            Text {
                                text: "Desktop System Notifications & Alerts";
                                color: Theme.text_primary;
                                font-size: 15px;
                                font-weight: 700;
                            }
                            Text {
                                text: "Sends native desktop notifications and audio chimes when tasks complete or fail.";
                                color: Theme.text_secondary;
                                font-size: 13px;
                            }
                        }
                    }

                    ActionButton {
                        text: "Test Alert";
                        icon: @image-url("../icons/bell.svg");
                        has_icon: true;
                        height: 34px;
                        clicked => { root.test_notification(); }
                    }
                }

                HorizontalLayout {
                    spacing: 16px;
                    alignment: start;

                    VerticalLayout {
                        spacing: 6px;
                        Text {
                            text: "Notifications";
                            color: Theme.text_secondary;
                            font-size: 12px;
                            font-weight: 600;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            IconChip {
                                text: "Enabled";
                                icon: @image-url("../icons/check.svg");
                                has_icon: true;
                                selected: root.notifications_enabled;
                                clicked => {
                                    root.notifications_enabled = true;
                                    root.set_notifications_enabled(true);
                                }
                            }
                            IconChip {
                                text: "Disabled";
                                icon: @image-url("../icons/x.svg");
                                has_icon: true;
                                selected: !root.notifications_enabled;
                                clicked => {
                                    root.notifications_enabled = false;
                                    root.set_notifications_enabled(false);
                                }
                            }
                        }
                    }

                    VerticalLayout {
                        spacing: 6px;
                        Text {
                            text: "Audio Chime";
                            color: Theme.text_secondary;
                            font-size: 12px;
                            font-weight: 600;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            IconChip {
                                text: "Sound On";
                                icon: @image-url("../icons/bolt.svg");
                                has_icon: true;
                                selected: root.notification_sound_enabled;
                                clicked => {
                                    root.notification_sound_enabled = true;
                                    root.set_notification_sound_enabled(true);
                                }
                            }
                            IconChip {
                                text: "Muted";
                                icon: @image-url("../icons/x.svg");
                                has_icon: true;
                                selected: !root.notification_sound_enabled;
                                clicked => {
                                    root.notification_sound_enabled = false;
                                    root.set_notification_sound_enabled(false);
                                }
                            }
                        }
                    }
                }
            }
        }

        // 5. Live Clipboard Link Monitor
        Rectangle {
            background: Theme.card_bg;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.card_border;

            VerticalLayout {
                padding: 20px;
                spacing: 14px;

                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;

                    Rectangle {
                        width: 34px;
                        height: 34px;
                        border-radius: 8px;
                        background: Theme.sidebar_brand_bg;
                        border-width: 1px;
                        border-color: Theme.sidebar_brand_border;

                        Image {
                            source: @image-url("../icons/clipboard.svg");
                            width: 17px;
                            height: 17px;
                            colorize: Theme.brand_purple;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }

                    VerticalLayout {
                        spacing: 3px;
                        Text {
                            text: "Live Clipboard Link Monitor";
                            color: Theme.text_primary;
                            font-size: 15px;
                            font-weight: 700;
                        }
                        Text {
                            text: "Detects video and audio stream URLs automatically when copied in your browser.";
                            color: Theme.text_secondary;
                            font-size: 13px;
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    IconChip {
                        text: "Enabled (Watch Clipboard)";
                        icon: @image-url("../icons/check.svg");
                        has_icon: true;
                        selected: root.clipboard_monitor_enabled;
                        clicked => {
                            root.clipboard_monitor_enabled = true;
                            root.set_clipboard_monitor(true);
                        }
                    }

                    IconChip {
                        text: "Disabled";
                        icon: @image-url("../icons/x.svg");
                        has_icon: true;
                        selected: !root.clipboard_monitor_enabled;
                        clicked => {
                            root.clipboard_monitor_enabled = false;
                            root.set_clipboard_monitor(false);
                        }
                    }
                }

                Rectangle {
                    background: Theme.inner_bg;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: Theme.inner_border;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        padding-top: 8px;
                        padding-bottom: 8px;
                        spacing: 8px;
                        alignment: start;

                        VerticalLayout {
                            alignment: center;
                            Image {
                                source: @image-url("../icons/info.svg");
                                width: 14px;
                                height: 14px;
                                colorize: #7082ff;
                            }
                        }

                        Text {
                            text: root.clipboard_monitor_enabled
                                ? "Monitoring active. When you copy a media link (YouTube, Bilibili, TikTok, stream links, etc.), an instant inspection banner will appear."
                                : "Monitoring paused. Clipboard contents will not be read automatically.";
                            color: #949db2;
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // 6. Engine & Architecture Overview (Compact & Clean)
        Rectangle {
            background: Theme.card_alt_bg;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.card_border;

            VerticalLayout {
                padding: 16px;
                spacing: 10px;

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    VerticalLayout {
                        alignment: center;
                        Image {
                            source: @image-url("../icons/cpu.svg");
                            width: 15px;
                            height: 15px;
                            colorize: #7082ff;
                        }
                    }

                    Text {
                        text: "Engine & System Architecture";
                        color: #7082ff;
                        font-size: 13px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }

                HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: "Core Media Framework";
                        color: #949db2;
                        font-size: 12px;
                    }
                    Text {
                        text: "FFmpeg v9 + yt-dlp Native";
                        color: #e2e8f0;
                        font-size: 12px;
                        font-weight: 600;
                    }
                }

                HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: "Chunk Resumption & Partial Safety";
                        color: #949db2;
                        font-size: 12px;
                    }
                    Text {
                        text: "Atomic .part + HTTP Multi-Range";
                        color: #4ade80;
                        font-size: 12px;
                        font-weight: 600;
                    }
                }

                HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: "Persistent Storage Engine";
                        color: #949db2;
                        font-size: 12px;
                    }
                    Text {
                        text: "SQLite 3 (WAL mode)";
                        color: #38bdf8;
                        font-size: 12px;
                        font-weight: 600;
                    }
                }

                HorizontalLayout {
                    alignment: space-between;
                    VerticalLayout {
                        spacing: 2px;
                        alignment: center;
                        Text {
                            text: "Streaming Extractor (yt-dlp)";
                            color: #949db2;
                            font-size: 12px;
                        }
                        Text {
                            text: "Keep site extractors and parsers up to date";
                            color: #64748b;
                            font-size: 10px;
                        }
                    }
                    ActionButton {
                        text: "Check for Updates";
                        icon: @image-url("../icons/refresh.svg");
                        has_icon: true;
                        height: 28px;
                        clicked => { root.update_extractor(); }
                    }
                }

                HorizontalLayout {
                    alignment: space-between;
                    VerticalLayout {
                        spacing: 2px;
                        alignment: center;
                        Text {
                            text: "App & Engine Caches";
                            color: #949db2;
                            font-size: 12px;
                        }
                        Text {
                            text: "Purge yt-dlp cache directory, thumbnail previews, and stream cache";
                            color: #64748b;
                            font-size: 10px;
                        }
                    }
                    ActionButton {
                        text: "Clear All Caches";
                        icon: @image-url("../icons/trash.svg");
                        has_icon: true;
                        height: 28px;
                        clicked => { root.clear_cache(); }
                    }
                }
            }
        }
    }
}
