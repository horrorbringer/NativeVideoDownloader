import { ScrollView } from "std-widgets.slint";
import { ActionButton } from "../components/action_button.slint";
import { IconChip } from "../components/icon_chip.slint";

export component SettingsTab inherits ScrollView {
    in-out property <string> download_dir_path: "~/Downloads";
    in-out property <int> selected_speed_limit_index: 0;
    in-out property <int> selected_concurrency: 3;
    in-out property <int> selected_cookies_browser_index: 0;
    in-out property <bool> clipboard_monitor_enabled: true;

    callback browse_download_dir();
    callback open_current_download_dir();
    callback reset_download_dir();
    callback set_speed_limit(int);
    callback set_max_concurrency(int);
    callback set_cookies_browser(int);
    callback set_clipboard_monitor(bool);
    callback test_notification();
    callback update_extractor();

    vertical-stretch: 1;

    VerticalLayout {
        alignment: start;
        spacing: 12px;
        padding-bottom: 14px;

        // 1. Storage & File Location
        Rectangle {
            background: #161926;
            border-radius: 12px;
            border-width: 1px;
            border-color: #242c40;

            VerticalLayout {
                padding: 20px;
                spacing: 14px;

                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;

                    Rectangle {
                        width: 34px;
                        height: 34px;
                        border-radius: 8px;
                        background: #1e2438;
                        border-width: 1px;
                        border-color: #2c3550;

                        Image {
                            source: @image-url("../icons/folder.svg");
                            width: 17px;
                            height: 17px;
                            colorize: #7082ff;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }

                    VerticalLayout {
                        spacing: 3px;
                        Text {
                            text: "Default Download Directory";
                            color: #ffffff;
                            font-size: 15px;
                            font-weight: 700;
                        }
                        Text {
                            text: "All media, video series, and extracted audio files are saved into this folder.";
                            color: #8c93a8;
                            font-size: 13px;
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 10px;

                    Rectangle {
                        background: #0f121d;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: #202638;
                        horizontal-stretch: 1;
                        height: 38px;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            alignment: start;

                            Text {
                                text: root.download_dir_path;
                                color: #e2e8f0;
                                font-size: 13px;
                                font-weight: 500;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }

                    ActionButton {
                        text: "Change...";
                        icon: @image-url("../icons/folder.svg");
                        has_icon: true;
                        height: 38px;
                        clicked => { root.browse_download_dir(); }
                    }

                    ActionButton {
                        text: "Finder";
                        icon: @image-url("../icons/monitor.svg");
                        has_icon: true;
                        height: 38px;
                        clicked => { root.open_current_download_dir(); }
                    }

                    ActionButton {
                        text: "Reset";
                        icon: @image-url("../icons/refresh.svg");
                        has_icon: true;
                        height: 38px;
                        clicked => { root.reset_download_dir(); }
                    }
                }
            }
        }

        // 2. Network & Bandwidth Management
        Rectangle {
            background: #161926;
            border-radius: 12px;
            border-width: 1px;
            border-color: #242c40;

            VerticalLayout {
                padding: 20px;
                spacing: 18px;

                // Speed Limiter
                VerticalLayout {
                    spacing: 12px;

                    HorizontalLayout {
                        spacing: 12px;
                        alignment: start;

                        Rectangle {
                            width: 34px;
                            height: 34px;
                            border-radius: 8px;
                            background: #1e2438;
                            border-width: 1px;
                            border-color: #2c3550;

                            Image {
                                source: @image-url("../icons/bolt.svg");
                                width: 17px;
                                height: 17px;
                                colorize: #7082ff;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }

                        VerticalLayout {
                            spacing: 3px;
                            Text {
                                text: "Bandwidth Speed Limiter";
                                color: #ffffff;
                                font-size: 15px;
                                font-weight: 700;
                            }
                            Text {
                                text: "Throttle maximum download speed to avoid saturating your local network.";
                                color: #8c93a8;
                                font-size: 13px;
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;

                        IconChip {
                            text: "No Limit";
                            icon: @image-url("../icons/bolt.svg");
                            has_icon: true;
                            selected: root.selected_speed_limit_index == 0;
                            clicked => {
                                root.selected_speed_limit_index = 0;
                                root.set_speed_limit(0);
                            }
                        }
                        IconChip {
                            text: "2 MB/s";
                            selected: root.selected_speed_limit_index == 1;
                            clicked => {
                                root.selected_speed_limit_index = 1;
                                root.set_speed_limit(1);
                            }
                        }
                        IconChip {
                            text: "5 MB/s";
                            selected: root.selected_speed_limit_index == 2;
                            clicked => {
                                root.selected_speed_limit_index = 2;
                                root.set_speed_limit(2);
                            }
                        }
                        IconChip {
                            text: "10 MB/s";
                            selected: root.selected_speed_limit_index == 3;
                            clicked => {
                                root.selected_speed_limit_index = 3;
                                root.set_speed_limit(3);
                            }
                        }
                        IconChip {
                            text: "20 MB/s";
                            selected: root.selected_speed_limit_index == 4;
                            clicked => {
                                root.selected_speed_limit_index = 4;
                                root.set_speed_limit(4);
                            }
                        }
                    }
                }

                // Divider
                Rectangle {
                    height: 1px;
                    background: #202638;
                }

                // Concurrency
                VerticalLayout {
                    spacing: 12px;

                    HorizontalLayout {
                        spacing: 12px;
                        alignment: start;

                        Rectangle {
                            width: 34px;
                            height: 34px;
                            border-radius: 8px;
                            background: #1e2438;
                            border-width: 1px;
                            border-color: #2c3550;

                            Image {
                                source: @image-url("../icons/cpu.svg");
                                width: 17px;
                                height: 17px;
                                colorize: #7082ff;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }

                        VerticalLayout {
                            spacing: 3px;
                            Text {
                                text: "Concurrent Queue Workers";
                                color: #ffffff;
                                font-size: 15px;
                                font-weight: 700;
                            }
                            Text {
                                text: "Number of download items actively processed simultaneously.";
                                color: #8c93a8;
                                font-size: 13px;
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;

                        IconChip {
                            text: "1 (Sequential)";
                            selected: root.selected_concurrency == 1;
                            clicked => {
                                root.selected_concurrency = 1;
                                root.set_max_concurrency(1);
                            }
                        }
                        IconChip {
                            text: "2 Parallel";
                            selected: root.selected_concurrency == 2;
                            clicked => {
                                root.selected_concurrency = 2;
                                root.set_max_concurrency(2);
                            }
                        }
                        IconChip {
                            text: "3 Parallel (Recommended)";
                            selected: root.selected_concurrency == 3;
                            clicked => {
                                root.selected_concurrency = 3;
                                root.set_max_concurrency(3);
                            }
                        }
                        IconChip {
                            text: "5 Parallel (Fast)";
                            selected: root.selected_concurrency == 5;
                            clicked => {
                                root.selected_concurrency = 5;
                                root.set_max_concurrency(5);
                            }
                        }
                    }
                }
            }
        }

        // 3. Browser Cookies & Authentication
        Rectangle {
            background: #161926;
            border-radius: 12px;
            border-width: 1px;
            border-color: #242c40;

            VerticalLayout {
                padding: 20px;
                spacing: 14px;

                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;

                    Rectangle {
                        width: 34px;
                        height: 34px;
                        border-radius: 8px;
                        background: #1e2438;
                        border-width: 1px;
                        border-color: #2c3550;

                        Image {
                            source: @image-url("../icons/monitor.svg");
                            width: 17px;
                            height: 17px;
                            colorize: #7082ff;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }

                    VerticalLayout {
                        spacing: 3px;
                        Text {
                            text: "Browser Cookies & Authentication";
                            color: #ffffff;
                            font-size: 15px;
                            font-weight: 700;
                        }
                        Text {
                            text: "Extract session cookies from your web browser to download private, age-gated, or member-only videos.";
                            color: #8c93a8;
                            font-size: 13px;
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    IconChip {
                        text: "Disabled";
                        selected: root.selected_cookies_browser_index == 0;
                        clicked => {
                            root.selected_cookies_browser_index = 0;
                            root.set_cookies_browser(0);
                        }
                    }
                    IconChip {
                        text: "Chrome";
                        selected: root.selected_cookies_browser_index == 1;
                        clicked => {
                            root.selected_cookies_browser_index = 1;
                            root.set_cookies_browser(1);
                        }
                    }
                    IconChip {
                        text: "Firefox";
                        selected: root.selected_cookies_browser_index == 2;
                        clicked => {
                            root.selected_cookies_browser_index = 2;
                            root.set_cookies_browser(2);
                        }
                    }
                    IconChip {
                        text: "Safari";
                        selected: root.selected_cookies_browser_index == 3;
                        clicked => {
                            root.selected_cookies_browser_index = 3;
                            root.set_cookies_browser(3);
                        }
                    }
                    IconChip {
                        text: "Brave";
                        selected: root.selected_cookies_browser_index == 4;
                        clicked => {
                            root.selected_cookies_browser_index = 4;
                            root.set_cookies_browser(4);
                        }
                    }
                    IconChip {
                        text: "Edge";
                        selected: root.selected_cookies_browser_index == 5;
                        clicked => {
                            root.selected_cookies_browser_index = 5;
                            root.set_cookies_browser(5);
                        }
                    }
                }

                Rectangle {
                    background: #0f121d;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: #202638;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        padding-top: 8px;
                        padding-bottom: 8px;
                        spacing: 8px;
                        alignment: start;

                        VerticalLayout {
                            alignment: center;
                            Image {
                                source: @image-url("../icons/info.svg");
                                width: 14px;
                                height: 14px;
                                colorize: #7082ff;
                            }
                        }

                        Text {
                            text: root.selected_cookies_browser_index == 0
                                ? "Cookies disabled. Downloads use anonymous guest sessions."
                                : "Using session cookies from " + (
                                    root.selected_cookies_browser_index == 1 ? "Google Chrome" :
                                    root.selected_cookies_browser_index == 2 ? "Mozilla Firefox" :
                                    root.selected_cookies_browser_index == 3 ? "Apple Safari" :
                                    root.selected_cookies_browser_index == 4 ? "Brave Browser" : "Microsoft Edge"
                                  ) + ". Logged-in accounts will be inherited automatically.";
                            color: #949db2;
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // 4. System & Desktop Notifications
        Rectangle {
            background: #161926;
            border-radius: 12px;
            border-width: 1px;
            border-color: #242c40;

            VerticalLayout {
                padding: 20px;
                spacing: 12px;

                HorizontalLayout {
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: 12px;
                        alignment: start;

                        Rectangle {
                            width: 34px;
                            height: 34px;
                            border-radius: 8px;
                            background: #1e2438;
                            border-width: 1px;
                            border-color: #2c3550;

                            Image {
                                source: @image-url("../icons/bell.svg");
                                width: 17px;
                                height: 17px;
                                colorize: #7082ff;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }

                        VerticalLayout {
                            spacing: 3px;
                            Text {
                                text: "System Notifications";
                                color: #ffffff;
                                font-size: 15px;
                                font-weight: 700;
                            }
                            Text {
                                text: "Sends native macOS alerts with audio chime when downloads finish.";
                                color: #8c93a8;
                                font-size: 13px;
                            }
                        }
                    }

                    ActionButton {
                        text: "Test Alert";
                        icon: @image-url("../icons/bell.svg");
                        has_icon: true;
                        height: 34px;
                        clicked => { root.test_notification(); }
                    }
                }
            }
        }

        // 5. Live Clipboard Link Monitor
        Rectangle {
            background: #161926;
            border-radius: 12px;
            border-width: 1px;
            border-color: #242c40;

            VerticalLayout {
                padding: 20px;
                spacing: 14px;

                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;

                    Rectangle {
                        width: 34px;
                        height: 34px;
                        border-radius: 8px;
                        background: #1e2438;
                        border-width: 1px;
                        border-color: #2c3550;

                        Image {
                            source: @image-url("../icons/clipboard.svg");
                            width: 17px;
                            height: 17px;
                            colorize: #7082ff;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }

                    VerticalLayout {
                        spacing: 3px;
                        Text {
                            text: "Live Clipboard Link Monitor";
                            color: #ffffff;
                            font-size: 15px;
                            font-weight: 700;
                        }
                        Text {
                            text: "Detects video and audio stream URLs automatically when copied in your browser.";
                            color: #8c93a8;
                            font-size: 13px;
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    IconChip {
                        text: "Enabled (Watch Clipboard)";
                        icon: @image-url("../icons/check.svg");
                        has_icon: true;
                        selected: root.clipboard_monitor_enabled;
                        clicked => {
                            root.clipboard_monitor_enabled = true;
                            root.set_clipboard_monitor(true);
                        }
                    }

                    IconChip {
                        text: "Disabled";
                        icon: @image-url("../icons/x.svg");
                        has_icon: true;
                        selected: !root.clipboard_monitor_enabled;
                        clicked => {
                            root.clipboard_monitor_enabled = false;
                            root.set_clipboard_monitor(false);
                        }
                    }
                }

                Rectangle {
                    background: #0f121d;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: #202638;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        padding-top: 8px;
                        padding-bottom: 8px;
                        spacing: 8px;
                        alignment: start;

                        VerticalLayout {
                            alignment: center;
                            Image {
                                source: @image-url("../icons/info.svg");
                                width: 14px;
                                height: 14px;
                                colorize: #7082ff;
                            }
                        }

                        Text {
                            text: root.clipboard_monitor_enabled
                                ? "Monitoring active. When you copy a media link (YouTube, Bilibili, TikTok, stream links, etc.), an instant inspection banner will appear."
                                : "Monitoring paused. Clipboard contents will not be read automatically.";
                            color: #949db2;
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // 6. Engine & Architecture Overview (Compact & Clean)
        Rectangle {
            background: #121522;
            border-radius: 12px;
            border-width: 1px;
            border-color: #202638;

            VerticalLayout {
                padding: 16px;
                spacing: 10px;

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    VerticalLayout {
                        alignment: center;
                        Image {
                            source: @image-url("../icons/cpu.svg");
                            width: 15px;
                            height: 15px;
                            colorize: #7082ff;
                        }
                    }

                    Text {
                        text: "Engine & System Architecture";
                        color: #7082ff;
                        font-size: 13px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }

                HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: "Core Media Framework";
                        color: #949db2;
                        font-size: 12px;
                    }
                    Text {
                        text: "FFmpeg v9 + yt-dlp Native";
                        color: #e2e8f0;
                        font-size: 12px;
                        font-weight: 600;
                    }
                }

                HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: "Chunk Resumption & Partial Safety";
                        color: #949db2;
                        font-size: 12px;
                    }
                    Text {
                        text: "Atomic .part + HTTP Multi-Range";
                        color: #4ade80;
                        font-size: 12px;
                        font-weight: 600;
                    }
                }

                HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: "Persistent Storage Engine";
                        color: #949db2;
                        font-size: 12px;
                    }
                    Text {
                        text: "SQLite 3 (WAL mode)";
                        color: #38bdf8;
                        font-size: 12px;
                        font-weight: 600;
                    }
                }

                HorizontalLayout {
                    alignment: space-between;
                    VerticalLayout {
                        spacing: 2px;
                        alignment: center;
                        Text {
                            text: "Streaming Extractor (yt-dlp)";
                            color: #949db2;
                            font-size: 12px;
                        }
                        Text {
                            text: "Keep site extractors and parsers up to date";
                            color: #64748b;
                            font-size: 10px;
                        }
                    }
                    ActionButton {
                        text: "Check for Updates";
                        icon: @image-url("../icons/refresh.svg");
                        has_icon: true;
                        height: 28px;
                        clicked => { root.update_extractor(); }
                    }
                }
            }
        }
    }
}
