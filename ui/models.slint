export struct DownloadItemData {
    id: string,
    title: string,
    status: string,
    progress: float,
    size_text: string,
    speed_text: string,
    eta_text: string,
    output_path: string,
    is_completed: bool,
    can_pause: bool,
    can_resume: bool,
    can_cancel: bool,
    is_queued: bool,
    can_move_up: bool,
    can_move_down: bool,
    selected: bool,
    source_platform: string,
    quality_badge: string,
    format_badge: string,
    detail_status: string,
    destination_display: string,
}


export struct HistoryItemData {
    id: string,
    title: string,
    status: string,
    size_text: string,
    date_text: string,
    url: string,
    output_path: string,
    domain: string,
    selected: bool,
}

export struct LogEntryData {
    timestamp: string,
    level: string,
    message: string,
}

export struct EpisodeItemData {
    index: int,
    title: string,
    url: string,
    selected: bool,
}

export struct SpeedSampleData {
    ratio: float,
    speed_text: string,
}

export struct BatchItemData {
    index: int,
    url: string,
    domain: string,
    title: string,
}

export struct StreamFormatData {
    format_id: string,
    quality_label: string,
    resolution: string,
    fps_text: string,
    video_codec: string,
    audio_codec: string,
    container: string,
    size_text: string,
    is_video: bool,
    is_recommended: bool,
    selected: bool,
}
